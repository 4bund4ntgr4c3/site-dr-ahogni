---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const CHANGELOG_PASS = "changelog2026";
---

<Layout title="Changelog — Dr I. B. Ahogni, PhD" noindex>
  <Header />
  <main>
    <div id="clLock" class="cl-lock" role="dialog" aria-modal="true" aria-label="Accès restreint">
      <div class="cl-lock-card">
        <p class="sec-eyebrow">Accès restreint</p>
        <p class="cl-lock-text">Le journal de versions est protégé. Entrez le mot de passe pour continuer.</p>
        <form id="clForm" class="cl-lock-form">
          <input id="clPass" type="password" placeholder="Mot de passe" autocomplete="off" aria-label="Mot de passe" />
          <button class="btn amber" type="submit">Déverrouiller</button>
        </form>
        <p id="clErr" class="cl-lock-err" hidden>Mot de passe incorrect. Réessayez.</p>
        <a class="cl-lock-back" href="/">← Retour au site</a>
      </div>
    </div>
    <div id="clContent" hidden>
    <section class="sec" id="changelog">
      <div class="wrap">
        <div class="sec-head">
          <p class="sec-eyebrow">Historique</p>
          <h1 class="title lm">
            <span class="ln"><span>Changelog du</span></span>
            <span class="ln"><span><span class="it">site</span></span></span>
          </h1>
          <p class="cl-intro rv">
            Toutes les modifications apportées au site, de l'initialisation aux dernières mises à jour.
          </p>
          <div class="cl-meta rv">
            <div class="cl-meta-item"><span class="k">Version</span><span class="v">v3.9.0</span></div>
            <div class="cl-meta-item"><span class="k">Pages</span><span class="v">18</span></div>
            <div class="cl-meta-item"><span class="k">Tests</span><span class="v">Build prod OK</span></div>
            <div class="cl-meta-item"><span class="k">Date</span><span class="v">24 Août 2026</span></div>
            <div class="cl-meta-item"><span class="k">Statut</span><span class="v">Stable</span></div>
          </div>
        </div>

        <!-- v3.9.0 -->
        <article class="cl-entry rv">
          <div class="cl-version">
            <span class="cl-tag">v3.9.0</span>
            <span class="cl-date">24 Août 2026</span>
          </div>
          <h3>Refonte de l'Assistant : Moteur Sémantique &amp; Base de Connaissances Scientifique Certifiée</h3>
          <h4 style="font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--coral);margin:20px 0 10px">Recherche Multi-Tokens, Zéro Hallucination &amp; 100% Hors-Ligne</h4>
          <ul>
            <li><strong>Moteur de Recherche Sémantique &amp; Multi-Tokens</strong> : Algorithme client ultra-rapide (0 ms) avec normalisation insensible aux accents, suppression des stop-words bilingues, scoring pondéré (mots-clés, titres, catégories, résumés) et tolérance aux correspondances partielles.</li>
            <li><strong>Corpus Scientifique Exhaustif</strong> : Indexation complète des travaux du Dr Ahogni incluant l'efficacité d'Interceptor G2 et Royal Guard à Covè, le mécanisme synergiste du PBO, la formule de correction d'Abbott, le dimensionnement de Fleiss, les mutations <em>kdr</em> / <em>ace-1</em>, le réseau sentinelle du Bénin, les critères d'audit BPL et les publications majeures.</li>
            <li><strong>Rendu Enrichi &amp; Liens Profonds</strong> : Affichage des réponses sous forme de fiches structurées avec badges catégoriels thématiques, résumés scientifiques validés, suggestions de sujets connexes et boutons d'action directs vers les simulateurs et sections dédiées.</li>
            <li><strong>Bilinguisme Dynamique &amp; Cadrage Transparent</strong> : Support FR/EN natif avec adaptation automatique des suggestions rapides au changement de langue et certification claire sans hallucination.</li>
          </ul>
        </article>

        <!-- v3.8.0 -->
        <article class="cl-entry rv">
          <div class="cl-version">
            <span class="cl-tag">v3.8.0</span>
            <span class="cl-date">24 Août 2026</span>
          </div>
          <h3>Internationalisation Bilingue Intégrale (FR/EN) sur l'Ensemble du Site &amp; Calculatrices</h3>
          <h4 style="font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--coral);margin:20px 0 10px">Traduction Exhaustive de Tous les Composants &amp; Outils</h4>
          <ul>
            <li><strong>Composants Interactifs &amp; Modales</strong> : Internationalisation intégrale avec clés dynamiques (<code>data-i18n</code>, <code>data-i18n-html</code>, <code>data-i18n-placeholder</code>, <code>data-i18n-aria</code>) pour le ruban défilant (<code>Tape</code>), la recherche globale (<code>SearchModal</code>), le lecteur PDF (<code>PdfViewerModal</code>), le menu déroulant (<code>Header</code>) et la carte de visite numérique (<code>ContactPage</code>).</li>
            <li><strong>Calculatrices &amp; Simulateurs Entomologiques</strong> : Traduction complète en FR et EN de l'Anatomie Vectorielle (<code>AnophelesAnatomy</code>), Explorateur et Bio-essais (<code>VectorExplorer</code>), Stations Sentinelles (<code>BeninFieldStations</code>), Météo &amp; Risque (<code>ClimateDashboard</code>), Calculateur HWE (<code>GeneticsCalculator</code>), Échantillonnage de Fleiss (<code>SampleSizeCalculator</code>), Matrice MILDV (<code>LlinMatrix</code>), Simulateur Médico-Économique (<code>CostEffectiveness</code>) et Audit BPL (<code>GlpAuditChecklist</code>).</li>
            <li><strong>Pages Dédiées &amp; Modules Pédagogiques</strong> : Support bilingue total pour les capsules audio (<code>AudioCapsules</code>), ressources académiques (<code>AcademicResources</code>), wizard d'invitation (<code>SpeakerWizard</code>), veille (<code>MalariaWatch</code>), glossaire (<code>MedicalGlossary</code>), publications (<code>PublicationsPage</code>), conférences (<code>speaking.astro</code>), notes de terrain (<code>blog/index.astro</code>, <code>blog/[slug].astro</code>), CV (<code>cv.astro</code>) et mode présentation (<code>pres.astro</code>).</li>
            <li><strong>Moteur i18n &amp; Dictionnaire (<code>main.js</code>)</strong> : Extension massive du dictionnaire avec plus de 90 nouvelles paires de clés bilingues, bascule instantanée sans rechargement de page et persistance automatique du choix de langue via <code>localStorage</code>.</li>
          </ul>
        </article>

        <!-- v3.7.0 -->
