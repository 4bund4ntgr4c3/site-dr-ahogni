---
import Layout from "../layouts/Layout.astro";

const slides = [
  {
    num: "01",
    tag: "Présentation Scientifique",
    title: "Dr Idelphonse Bonaventure AHOGNI, PhD",
    subtitle: "Entomologiste Médical · Gestionnaire de Programmes Paludisme · Chercheur au CREC Bénin",
    content: "Expertise de pointe en évaluation opérationnelle des outils de lutte antivectorielle (MILDV, PID), surveillance génomique de la résistance aux insecticides (kdr, ace-1, CYP450) et conseil stratégique pour les programmes de santé publique en Afrique subsaharienne.",
    stats: [
      { num: "500+", lbl: "Citations" },
      { num: "25+", lbl: "Publications Q1/Q2" },
      { num: "10+", lbl: "Pays d'intervention" },
      { num: "12", lbl: "Indice h" },
    ],
  },
  {
    num: "02",
    tag: "Défis Majeurs",
    title: "La Menace de la Résistance aux Insecticides",
    subtitle: "Érosion de l'efficacité des pyréthroïdes conventionnels en Afrique de l'Ouest",
    content: "Dans les zones rurales et périurbaines du sud et centre Bénin, la prévalence de l'allèle kdr L1014F dépasse 90% chez Anopheles gambiae et An. coluzzii, combinée à une forte surexpression métabolique de cytochromes P450 (CYP6P3). La transition vers les outils de nouvelle génération est impérative.",
    stats: [
      { num: "> 90%", lbl: "Fréquence kdr Bénin" },
      { num: "2x", lbl: "Durée de rémanence PBO" },
      { num: "100%", lbl: "Alignement OMS" },
    ],
  },
  {
    num: "03",
    tag: "Innovations Technologiques",
    title: "Moustiquaires de Nouvelle Génération (MILDV Bi-actives)",
    subtitle: "Validation clinique et entomologique de l'Interceptor G2",
    content: "Les essais en cases expérimentales et les essais cliniques randomisés en grappes ont prouvé la supériorité des moustiquaires à double principe actif combinant un pyréthroïde et le chlorfénapyr (découpleur d'ATP mitochondrial sans résistance croisée connue).",
    stats: [
      { num: "> 90%", lbl: "Mortalité en cases" },
      { num: "-44%", lbl: "Incidence paludisme enfants" },
      { num: "3 ans", lbl: "Durabilité validée" },
    ],
  },
  {
    num: "04",
    tag: "Dispositif Opérationnel",
    title: "Stations de Recherche & Cases Expérimentales",
    subtitle: "Réseau de pointe au Bénin (Covè, Akron, CREC Cotonou)",
    content: "Infrastructures certifiées aux normes OMS permettant l'évaluation rigoureuse en conditions semi-naturelles de Phase II : tunnels de vol, insectarium climatisé hébergeant la souche sensible de référence Kisumu, et plateformes de génotypage PCR haut débit.",
    stats: [
      { num: "120", lbl: "Cases sentinelles" },
      { num: "45 000+", lbl: "Moustiques testés/an" },
      { num: "12", lbl: "Départements couverts" },
    ],
  },
  {
    num: "05",
    tag: "Partenariats & Réseau",
    title: "Écosystème International de Collaboration",
    subtitle: "Synergies académiques et agences mondiales",
    content: "Coopérations étroites et continues avec le Centre de Recherche Entomologique de Cotonou (CREC), la London School of Hygiene & Tropical Medicine (LSHTM), PAMCA, l'OMS / TDR, le Fonds Mondial, l'USAID / PMI et l'Université d'Abomey-Calavi (UAC).",
    stats: [
      { num: "LSHTM", lbl: "Partenaire UK" },
      { num: "PAMCA", lbl: "Réseau Afrique" },
      { num: "OMS / WHO", lbl: "Directives mondiales" },
    ],
  },
  {
    num: "06",
    tag: "Conclusion & Contact",
    title: "Pour une Élimination Durable du Paludisme",
    subtitle: "Collaboration, recherche opérationnelle et mentorat",
    content: "Disponible pour conférences magistrales, comités d'experts, évaluations de programmes nationaux et partenariats de recherche translationnelle.",
    stats: [
      { num: "✉️", lbl: "idelphonse.ahogni@gmail.com" },
      { num: "🌐", lbl: "idelphonseahogni.com" },
      { num: "📍", lbl: "Cotonou, République du Bénin" },
    ],
  },
];
---

<Layout
  title="Mode Diaporama Scientifique — Dr Idelphonse Ahogni, PhD"
  description="Présentation diaporama interactive plein écran pour colloques et conférences scientifiques."
  noindex
>
  <div class="pres-container" id="presContainer">
    <!-- Barre de contrôle supérieure -->
    <header class="pres-bar">
      <a href="/" class="pres-back-btn">← Quitter le Diaporama</a>
      <div class="pres-tracker">
        Slide <span id="curSlideNum">1</span> / <span>{slides.length}</span>
      </div>
      <div class="pres-actions">
        <button type="button" id="presFsBtn" class="pres-btn" title="Plein écran (Touche F)">⛶ Plein écran</button>
      </div>
    </header>

    <!-- Diapositives -->
    <main class="pres-stage">
      {slides.map((s, idx) => (
        <section
          class:list={["pres-slide", { active: idx === 0 }]}
          data-slide-index={idx}
          id={`slide-${idx}`}
        >
          <div class="ps-inner">
            <div class="ps-header">
              <span class="ps-num">{s.num}</span>
              <span class="ps-tag">{s.tag}</span>
            </div>

            <h1 class="ps-title">{s.title}</h1>
            <p class="ps-subtitle">{s.subtitle}</p>

            <div class="ps-body">
              <p>{s.content}</p>
            </div>

            {s.stats && (
              <div class="ps-stats-grid">
                {s.stats.map((st) => (
                  <div class="ps-stat-card">
                    <strong class="pss-num">{st.num}</strong>
                    <span class="pss-lbl">{st.lbl}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      ))}
    </main>

    <!-- Barre de navigation inférieure -->
    <footer class="pres-footer">
      <button type="button" class="pres-nav-btn" id="presPrevBtn" aria-label="Diapositive précédente">← Précédente</button>
      <div class="pres-dots">
        {slides.map((_, idx) => (
          <button
            type="button"
            class:list={["pres-dot", { active: idx === 0 }]}
            data-goto-slide={idx}
            aria-label={`Aller au slide ${idx + 1}`}
          />
        ))}
      </div>
      <button type="button" class="pres-nav-btn" id="presNextBtn" aria-label="Diapositive suivante">Suivante →</button>
    </footer>
  </div>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const slides = document.querySelectorAll<HTMLElement>(".pres-slide");
    const dots = document.querySelectorAll<HTMLButtonElement>(".pres-dot");
    const curNum = document.getElementById("curSlideNum");
    const prevBtn = document.getElementById("presPrevBtn");
    const nextBtn = document.getElementById("presNextBtn");
    const fsBtn = document.getElementById("presFsBtn");
    const container = document.getElementById("presContainer");

    let curIdx = 0;
    const total = slides.length;

    function goToSlide(idx: number) {
      curIdx = (idx + total) % total;
      slides.forEach((s, i) => s.classList.toggle("active", i === curIdx));
      dots.forEach((d, i) => d.classList.toggle("active", i === curIdx));
      if (curNum) curNum.textContent = String(curIdx + 1);
    }

    prevBtn?.addEventListener("click", () => goToSlide(curIdx - 1));
    nextBtn?.addEventListener("click", () => goToSlide(curIdx + 1));

    dots.forEach((d) => {
      d.addEventListener("click", () => {
        goToSlide(Number(d.dataset.gotoSlide));
      });
    });

    fsBtn?.addEventListener("click", () => {
      if (!document.fullscreenElement) {
        container?.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight" || e.key === " " || e.key === "PageDown") {
        e.preventDefault();
        goToSlide(curIdx + 1);
      } else if (e.key === "ArrowLeft" || e.key === "PageUp") {
        e.preventDefault();
        goToSlide(curIdx - 1);
      } else if (e.key === "f" || e.key === "F") {
        if (!document.fullscreenElement) container?.requestFullscreen().catch(() => {});
        else document.exitFullscreen().catch(() => {});
      } else if (e.key === "Escape") {
        if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
      }
    });
  });
</script>

<style>
  .pres-container {
    min-height: 100vh;
    background: #0B0F17;
    color: #F8FAFC;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: var(--body);
    user-select: none;
  }

  .pres-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(11, 15, 23, 0.95);
  }
  .pres-back-btn {
    color: #CBD5E1;
    text-decoration: none;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: color .2s;
  }
  .pres-back-btn:hover { color: var(--amber2); }

  .pres-tracker {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--amber2);
    font-weight: 700;
    letter-spacing: .1em;
  }

  .pres-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #F8FAFC;
    padding: 6px 14px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all .2s;
  }
  .pres-btn:hover { background: var(--amber2); color: #0B0F17; border-color: var(--amber2); }

  /* Stage */
  .pres-stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 5vw;
    position: relative;
    overflow: hidden;
  }

  .pres-slide {
    display: none;
    width: 100%;
    max-width: 1100px;
    animation: slideFade .4s ease;
  }
  .pres-slide.active { display: block; }
  @keyframes slideFade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  .ps-inner {
    background: #111827;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 48px 56px;
    box-shadow: 0 24px 60px rgba(0,0,0,0.6);
  }

  .ps-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }
  .ps-num {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    color: var(--amber2);
    background: rgba(245, 158, 11, 0.15);
    padding: 4px 10px;
    border-radius: 2px;
  }
  .ps-tag {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .ps-title {
    font-family: var(--display);
    font-size: 2.5rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.2;
    margin-bottom: 10px;
  }
  .ps-subtitle {
    font-family: var(--body);
    font-size: 1.25rem;
    color: var(--amber2);
    margin-bottom: 24px;
    line-height: 1.4;
  }

  .ps-body p {
    font-size: 1.15rem;
    color: #CBD5E1;
    line-height: 1.7;
    margin-bottom: 36px;
  }

  .ps-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 24px;
  }
  .ps-stat-card {
    background: #1E293B;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 16px;
    text-align: center;
  }
  .pss-num {
    font-family: var(--display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--amber2);
    display: block;
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .pss-lbl {
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    color: #94A3B8;
    letter-spacing: .06em;
  }

  /* Footer */
  .pres-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(11, 15, 23, 0.95);
  }
  .pres-nav-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #F8FAFC;
    padding: 8px 18px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all .2s;
  }
  .pres-nav-btn:hover { background: var(--amber2); color: #0B0F17; border-color: var(--amber2); }

  .pres-dots { display: flex; gap: 8px; }
  .pres-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all .2s;
  }
  .pres-dot.active { background: var(--amber2); transform: scale(1.3); }

  @media (max-width: 768px) {
    .ps-inner { padding: 28px 20px; }
    .ps-title { font-size: 1.7rem; }
    .ps-subtitle { font-size: 1.05rem; }
    .ps-body p { font-size: 0.98rem; }
    .pres-bar, .pres-footer { padding: 12px 16px; }
  }
</style>
