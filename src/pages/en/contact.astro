---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import ContactPage from "../../components/ContactPage.astro";
import Footer from "../../components/Footer.astro";
import { sanityClient } from "sanity:client";
import { CONTENT_QUERY, cachedFetch } from "../../lib/queries";

const content = await cachedFetch(sanityClient, CONTENT_QUERY);
const faqItems = content?.faq ?? [];
---

<Layout title="Contact Dr Idelphonse Ahogni, PhD — Missions & Consultations | Malaria" description="Contact Dr Idelphonse Bonaventure Ahogni, medical entomologist and malaria expert in Benin. Inquiry form, availability, coordinates, and FAQ. Response within 48 business hours." bodyClass="on-contact">
  <Header />
  <main>
    <ContactPage />
    <Footer />
  </main>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact & Appointment Booking — Dr Idelphonse Ahogni",
  "description": "Contact form, appointment scheduling, and official professional contact details for Dr Idelphonse Bonaventure Ahogni, medical entomologist.",
  "url": "https://idelphonseahogni.com/en/contact/",
  "mainEntity": {
    "@type": "Person",
    "name": "Dr Idelphonse Bonaventure Ahogni",
    "jobTitle": "Medical Entomologist & Malaria Expert",
    "url": "https://idelphonseahogni.com/en/"
  }
})} />
