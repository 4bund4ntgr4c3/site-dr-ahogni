---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { sanityClient } from "sanity:client";
import { CONTENT_QUERY, cachedFetch, SETTINGS_QUERY } from "../../lib/queries";

const settings = await cachedFetch(sanityClient, SETTINGS_QUERY);
const content = await cachedFetch(sanityClient, CONTENT_QUERY);

const enAboutSummary = "Medical Entomologist (PhD) and Senior Public Health Researcher at the Entomological Research Centre of Cotonou (CREC), Benin. Over 10 years of operational field research experience across Sub-Saharan Africa. Specialized in Phase II/III clinical and entomological evaluation of next-generation dual-active LLINs, vector genomic surveillance (kdr, ace-1, metabolic cytochromes P450), GLP quality systems, and strategic technical support to National Malaria Control Programs (NMCPs) and multilateral organizations (WHO, The Global Fund, PMI/USAID, PAMCA).";

const enExpertises = [
  { title: "Operational LLIN Evaluation", description: "Phase II experimental hut trials and Phase III community-level studies on next-generation dual-active nets (Interceptor G2, Royal Guard)." },
  { title: "Insecticide Resistance & Synergism", description: "WHO tube assays, CDC bottle bioassays, PBO synergist testing, and characterization of pyrethroid cross-resistance mechanisms." },
  { title: "Genomic Surveillance & Molecular Markers", description: "High-throughput PCR genotyping for target mutations kdr (L1014F/S), ace-1 (G119S), and metabolic P450 cytochrome overexpression." },
  { title: "Quality Management & GLP Standards", description: "Operational implementation of OECD/WHO Good Laboratory Practice (GLP) for insectaries, testing protocols, and certified data archiving." },
  { title: "Strategic Advisory for NMCPs", description: "High-level technical advisory, national vector control policy briefs, insecticide resistance management plans, and Global Fund proposals." },
  { title: "Sentinel Field Station Network", description: "Nationwide coordination of entomological sentinel sites (Covè, Akron, Parakou, Kandi) monitoring vector transmission dynamics." },
  { title: "Biometrics, Sample Size & Abbott Correction", description: "Statistical modeling of Abbott-corrected mortality rates, Fleiss sample size calculations with continuity corrections, and probit regressions." },
  { title: "Teaching, Capacity Building & Mentorship", description: "Knowledge transfer, international masterclasses in public health entomology, and co-supervision of MSc and PhD candidates." },
];

const enCareer = [
  {
    dateRange: "2021 — Present",
    title: "Senior Research Medical Entomologist & Project Lead",
    org: "Entomological Research Centre of Cotonou (CREC) · Benin",
  },
  {
    dateRange: "2018 — 2021",
    title: "Doctoral Researcher (PhD) & Field Trial Coordinator",
    org: "University of Abomey-Calavi (UAC) / CREC Benin",
  },
  {
    dateRange: "2015 — 2018",
    title: "Entomological Bioassay & Field Trial Supervisor",
    org: "CREC Operational Research Projects / International Consortia",
  },
];

const enEducation = [
  {
    year: "2021",
    title: "PhD in Medical Entomology",
    school: "University of Abomey-Calavi (UAC) · Benin",
  },
  {
    year: "2019",
    title: "Master of Public Health (MPH Candidate)",
    school: "Regional Institute of Public Health (IRSP) · Ouidah",
  },
  {
    year: "2015",
    title: "Master of Science (MSc) in Medical Entomology",
    school: "Faculty of Sciences and Techniques (FAST) · UAC",
  },
  {
    year: "2012",
    title: "Bachelor of Science (BSc) in Life & Natural Sciences",
    school: "University of Abomey-Calavi (UAC) · Benin",
  },
];

const enSkills = [
  { category: "Laboratory & Bioassays", tags: ["WHO tube bioassays", "CDC bottle assays", "Synergist assays (PBO, DEF)", "Insectary management", "GLP compliance"] },
  { category: "Molecular Biology & Genetics", tags: ["Genomic DNA extraction", "Target-site PCR (kdr L1014F/S, ace-1 G119S)", "ELISA CSP sporozoites", "Hardy-Weinberg modeling"] },
  { category: "Field & Semi-Field Trials", tags: ["Experimental huts (Covè)", "Human Landing Catches (HLC)", "Larval habitat surveys", "CDC light traps"] },
  { category: "Biostatistics & Policy", tags: ["Fleiss sample sizing", "Abbott mortality correction", "Health economics & cost-effectiveness", "NMCP policy design"] },
];
---

<Layout title="CV — Dr Idelphonse Bonaventure Ahogni, PhD | Medical Entomology" description="Curriculum vitæ of Dr Idelphonse Ahogni — malaria program manager, medical entomologist." noindex>
  <Header />
  <main>
    <section class="sec" id="cv-page">
      <div class="wrap">
        <div class="sec-head">
          <p class="sec-eyebrow" data-i18n="cv.eyebrow">07 — Curriculum Vitæ</p>
          <h1 class="title lm" data-i18n-html="cv.title">
            <span class="ln"><span>Full career path,</span></span>
            <span class="ln"><span><span class="it">training &amp; expertise</span></span></span>
          </h1>
          <p class="cv-intro rv" data-i18n="cv.intro">
            Medical Entomologist &amp; Malaria Program Manager — education, professional trajectory, core competencies, and selected peer-reviewed publications.
          </p>
        </div>

        <div class="cv-toolbar no-print rv">
          <div class="cv-view-toggle">
            <button type="button" class="cv-mode-btn active" data-mode="full" data-i18n="cv.modeFull">Detailed View</button>
            <button type="button" class="cv-mode-btn" data-mode="summary" data-i18n="cv.modeSummary">Executive Summary (1-Page)</button>
          </div>
          <div class="cv-actions">
            <button id="printBtn" class="btn-cv-action" type="button" data-i18n="cv.btnPdf">⬇ Download PDF</button>
            <a class="btn-cv-action" href="/en/cv.json" target="_blank" download="Dr_Idelphonse_AHOGNI_resume.json">📋 JSON Resume</a>
            <a class="btn-cv-action" href="/contact.vcf" download="Dr_Idelphonse_AHOGNI.vcf">📇 Contact (.vcf)</a>
            <a class="btn-cv-back" href="/en" data-i18n="action.back">← Back to home</a>
          </div>
        </div>

        <!-- Document CV A4 -->
        <div class="cv" id="cvDocument" data-mode="full">
          <header class="cv-head">
            <p class="cv-eyebrow" data-i18n="cv.docEyebrow">Curriculum Vitæ · Republic of Benin</p>
            <h1>Idelphonse <em>Bonaventure</em> AHOGNI, PhD</h1>
            <p class="role">Applied entomology, LLIN evaluation, insecticide resistance and public health programs across Africa.</p>
            <p class="contact">
              {settings?.contactEmail && <span><a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a></span>}
              {settings?.contactPhone && settings?.contactEmail && <span>·</span>}
              {settings?.contactPhone && <span>{settings.contactPhone}</span>}
              <span>· Cotonou, Benin</span>
              {settings?.linkedin && settings?.linkedin !== "#" && <span>· <a href={settings.linkedin}>LinkedIn ↗</a></span>}
              {settings?.researchGate && settings?.researchGate !== "#" && <span>· <a href={settings.researchGate}>ResearchGate ↗</a></span>}
              {settings?.orcid && settings?.orcid !== "#" && <span>· <a href={settings.orcid}>ORCID ↗</a></span>}
            </p>
          </header>

          <!-- Section Chiffres clés (Visible en mode Executive Summary) -->
          <section class="cv-summary-only">
            <h2><span class="sec-num">★</span> <span data-i18n="cv.secHighlights">Highlights &amp; Key Impact</span></h2>
            <div class="summary-stats-grid">
              <div class="s-stat"><span class="s-num">10+</span><span class="s-lbl" data-i18n="cv.stat1">Years field experience</span></div>
              <div class="s-stat"><span class="s-num">25+</span><span class="s-lbl" data-i18n="cv.stat2">International publications</span></div>
              <div class="s-stat"><span class="s-num">9</span><span class="s-lbl" data-i18n="cv.stat3">Target countries in Africa</span></div>
              <div class="s-stat"><span class="s-num">Phase III</span><span class="s-lbl" data-i18n="cv.stat4">Clinical trials &amp; LLINs</span></div>
            </div>
          </section>

          <section>
            <h2><span class="sec-num">01</span> <span data-i18n="cv.sec01">Profile &amp; Professional Summary</span></h2>
            <p>{enAboutSummary}</p>
          </section>

          <section>
            <h2><span class="sec-num">02</span> <span data-i18n="cv.sec02">Core Competencies</span></h2>
            <ul class="two-col">
              {enExpertises.map((e: any) => <li class="cv-item"><b>{e.title}.</b> {e.description}</li>)}
            </ul>
          </section>

          <section>
            <h2><span class="sec-num">03</span> <span data-i18n="cv.sec03">Professional Experience</span></h2>
            {enCareer.map((j: any, i: number) => (
              <div class={`entry ${i >= 3 ? "cv-full-only" : ""}`}>
                <div class="when">{j.dateRange}</div>
                <div class="what">
                  <h3>{j.title}</h3>
                  <span class="org">{j.org}</span>
                </div>
              </div>
            ))}
          </section>

          <section>
            <h2><span class="sec-num">04</span> <span data-i18n="cv.sec04">Education &amp; Degrees</span></h2>
            {enEducation.map((e: any) => (
              <div class="entry">
                <div class="when">{e.year}</div>
                <div class="what"><h3>{e.title}</h3><span class="org">{e.school}</span></div>
              </div>
            ))}
          </section>

          <section class="cv-full-only">
            <h2><span class="sec-num">05</span> <span data-i18n="cv.sec05">Technical Skills &amp; Methods</span></h2>
            <ul class="two-col">
              {enSkills.map((g: any) => <li><b>{g.category}:</b> {g.tags?.join(", ")}</li>)}
            </ul>
          </section>

          <section>
            <h2><span class="sec-num">06</span> <span data-i18n="cv.sec06">Selected Publications</span></h2>
            <p class="note">Selection of 12 peer-reviewed articles from 25+ published scientific papers.</p>
            <ol class="pubs">
              {content?.publications?.slice(0, 12).map((p: any, i: number) => (
                <li class={i >= 5 ? "cv-full-only" : ""}>
                  {p.authors} ({p.year}). <b>{p.title}</b>. <em>{p.journal}</em>.
                  {p.doi && <span class="cv-doi-print"> doi:{p.doi}</span>}
                </li>
              ))}
            </ol>
          </section>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  .cv-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    background: #111827;
    color: #F8FAFC;
    border: 1px solid rgba(255,255,255,0.12);
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .cv-view-toggle {
    display: flex;
    gap: 4px;
    background: var(--paper2);
    padding: 4px;
    border: 1px solid var(--line);
  }
  .cv-mode-btn {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    border: none;
    background: transparent;
    color: var(--ink2);
    padding: 7px 14px;
    cursor: pointer;
    transition: all .2s;
  }
  .cv-mode-btn:hover { color: var(--ink); background: var(--surface); }
  .cv-mode-btn.active {
    background: var(--amber);
    color: #0B0F17;
    font-weight: 700;
  }
  .cv-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .btn-cv-action, .btn-cv-back {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 9px 16px;
    cursor: pointer;
    text-decoration: none;
    transition: all .2s;
    border: 1px solid rgba(255,255,255,0.2);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .btn-cv-action { background: #1F2937; color: #FFFFFF; }
  .btn-cv-action:hover { background: var(--amber); color: #0B0F17; border-color: var(--amber); }
  .btn-cv-back { background: transparent; color: var(--amber2); border-color: var(--amber2); }
  .btn-cv-back:hover { background: var(--amber2); color: #0B0F17; }

  /* ── Mode Executive Summary vs Mode Détaillé ── */
  .cv[data-mode="summary"] .cv-full-only { display: none !important; }
  .cv[data-mode="full"] .cv-summary-only { display: none !important; }

  /* ── Chiffres clés Summary ── */
  .summary-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 14px 0 20px;
  }
  .s-stat {
    border: 1px solid var(--line);
    background: var(--paper2);
    padding: 14px 10px;
    text-align: center;
  }
  .s-num {
    display: block;
    font-family: var(--display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--amber2);
    line-height: 1;
    margin-bottom: 4px;
  }
  .s-lbl {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink2);
    line-height: 1.3;
  }

  .cv-intro {
    max-width: 60ch;
    margin-top: 20px;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--ink2);
  }
  .cv {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    padding: 60px;
    font-family: var(--sans);
    box-shadow: 0 10px 40px rgba(0,0,0,0.06);
    margin-top: 10px;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }
  .cv-head {
    border-bottom: 2px solid var(--ink);
    padding-bottom: 24px;
    margin-bottom: 32px;
  }
  .cv-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--ink2);
    margin-bottom: 8px;
  }
  .cv-head h1 {
    font-family: var(--display);
    font-size: 2.2rem;
    color: var(--ink);
    line-height: 1.15;
    margin-bottom: 6px;
  }
  .cv-head h1 em {
    font-style: italic;
    color: var(--teal);
  }
  .cv-head .role {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--amber);
    font-weight: 700;
    margin-bottom: 12px;
  }
  .cv-head .contact {
    font-size: 12.5px;
    color: var(--ink2);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cv-head .contact a {
    color: inherit;
    text-decoration: underline;
  }
  .cv section {
    margin-bottom: 28px;
  }
  .cv h2 {
    font-family: var(--display);
    font-size: 1.25rem;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    padding-bottom: 6px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cv .sec-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--amber);
    font-weight: 700;
  }
  .cv p {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--ink2);
  }
  .cv ul.two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 24px;
    list-style: square;
    padding-left: 18px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink2);
  }
  .cv ul.two-col li b {
    color: var(--ink);
  }
  .cv .entry {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
    margin-bottom: 12px;
    font-size: 13px;
  }
  .cv .entry .when {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink2);
  }
  .cv .entry h3 {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 2px;
  }
  .cv .entry .org {
    color: var(--ink2);
    font-style: italic;
  }
  .cv .note {
    font-size: 12px;
    font-style: italic;
    color: var(--ink2);
    margin-bottom: 10px;
  }
  .cv ol.pubs {
    padding-left: 20px;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--ink2);
  }
  .cv ol.pubs li {
    margin-bottom: 8px;
  }
  .cv-doi-print {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--coral);
  }

  /* ── Dark Mode ── */
  html[data-theme="dark"] .cv {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    box-shadow: 0 16px 40px rgba(0,0,0,.5);
  }
  html[data-theme="dark"] .cv-view-toggle {
    background: var(--paper2);
    border-color: var(--line);
  }
  html[data-theme="dark"] .cv-mode-btn {
    color: var(--ink2);
  }
  html[data-theme="dark"] .cv-mode-btn:hover {
    color: var(--ink);
    background: var(--paper);
  }
  html[data-theme="dark"] .cv-mode-btn.active {
    background: var(--amber) !important;
    color: #0B0F17 !important;
    font-weight: 700 !important;
  }
  html[data-theme="dark"] .btn-cv-action {
    background: var(--paper2);
    color: #F8FAFC;
    border: 1px solid var(--line);
  }
  html[data-theme="dark"] .btn-cv-action:hover {
    background: var(--amber);
    color: #0B0F17;
    border-color: var(--amber);
  }
  html[data-theme="dark"] .cv-head { border-color: var(--line); }
  html[data-theme="dark"] .cv-head h1 { color: var(--ink); }
  html[data-theme="dark"] .cv-head h1 em { color: var(--amber); }
  html[data-theme="dark"] .cv-head .role { color: var(--ink2); }
  html[data-theme="dark"] .cv-head .contact { color: var(--ink2); }
  html[data-theme="dark"] .cv-head .contact a { color: var(--teal); }
  html[data-theme="dark"] .cv h2 { color: var(--ink); border-color: var(--line); }
  html[data-theme="dark"] .cv .sec-num { color: var(--amber); }
  html[data-theme="dark"] .cv p { color: var(--ink); }
  html[data-theme="dark"] .cv ul, html[data-theme="dark"] .cv ol { color: var(--ink2); }
  html[data-theme="dark"] .cv ul.two-col li b { color: var(--ink); }
  html[data-theme="dark"] .cv .entry .when { color: var(--amber); }
  html[data-theme="dark"] .cv .entry h3 { color: var(--ink); }
  html[data-theme="dark"] .cv .entry .org { color: var(--ink2); }
  html[data-theme="dark"] .cv .note { color: var(--ink2); }
  html[data-theme="dark"] .cv ol.pubs li { color: var(--ink); }
  html[data-theme="dark"] .cv ol.pubs em { color: var(--teal); }
  html[data-theme="dark"] .summary-stats-grid { background: var(--paper2); border-color: var(--line); }
  html[data-theme="dark"] .s-num { color: var(--amber); }
  html[data-theme="dark"] .s-lbl { color: var(--ink2); }
  html[data-theme="dark"] .s-stat { background: var(--paper2); border-color: var(--line); }

  /* ── Impression A4 Propre ── */
  @media print {
    :global(header), :global(footer), :global(.contact-cta), .cv-toolbar, .sec-head { display: none !important; }
    :global(body), :global(main), :global(.sec) { background: #FFF !important; color: #000 !important; padding: 0 !important; margin: 0 !important; }
    .cv {
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      max-width: 100% !important;
      background: #FFF !important;
      color: #000 !important;
      font-size: 11pt !important;
    }
    .cv-head h1 { font-size: 18pt !important; color: #000 !important; }
    .cv h2 { font-size: 13pt !important; color: #000 !important; border-bottom: 1pt solid #000 !important; }
    .cv p, .cv li, .cv .entry { font-size: 9.5pt !important; color: #111 !important; }
  }

  @media (max-width: 768px) {
    .cv { padding: 30px 20px; }
    .cv ul.two-col { grid-template-columns: 1fr; }
    .cv .entry { grid-template-columns: 1fr; gap: 4px; }
    .summary-stats-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Bouton d'impression
    const printBtn = document.getElementById("printBtn");
    printBtn?.addEventListener("click", () => window.print());

    // Bascule de Mode (Vue Détaillée vs Summary)
    const doc = document.getElementById("cvDocument");
    const modeBtns = document.querySelectorAll<HTMLElement>(".cv-mode-btn");

    modeBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        modeBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        const mode = btn.dataset.mode || "full";
        if (doc) doc.dataset.mode = mode;
      });
    });
  });
</script>
