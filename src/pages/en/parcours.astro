---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Career from "../../components/Career.astro";
import Education from "../../components/Education.astro";
import MentorshipAlumni from "../../components/MentorshipAlumni.astro";
import Service from "../../components/Service.astro";
import Awards from "../../components/Awards.astro";
---

<Layout
  title="Career Trajectory, Education & Mentorship — Dr Idelphonse Ahogni, PhD"
  description="Explore the professional trajectory, academic degrees, mentorship network, and honors of Dr Idelphonse Ahogni: over a decade dedicated to malaria research, NMCP support, and training future African scientists."
>
  <Header />
  <main class="page-container">
    <section class="page-hero-sec">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/en" data-i18n="nav.home">Home</a>
          <span class="bc-sep" aria-hidden="true">/</span>
          <span class="bc-current" data-i18n="nav.career">Career &amp; Mentorship</span>
        </nav>

        <div class="page-hero-grid">
          <div>
            <p class="sec-eyebrow" data-i18n="page.car.eyebrow">Career &amp; Mentorship</p>
            <h1 class="page-title lm">
              <span class="ln"><span>A decade of leadership,</span></span>
              <span class="ln"><span><span class="it">innovation &amp; mentorship</span></span></span>
            </h1>
            <p class="page-intro" data-i18n="page.car.intro">
              A career path bridging research benches, real-world field trials, and high-level policy rooms to empower the next generation of African entomologists.
            </p>
          </div>
          <div class="page-hero-stats">
            <div class="phs-card">
              <span class="phs-num">10+</span>
              <span class="phs-lbl" data-i18n="page.car.stat1">Years of Leadership</span>
            </div>
            <div class="phs-card">
              <span class="phs-num">PhD</span>
              <span class="phs-lbl" data-i18n="page.car.stat2">MSc, MPHc Public Health</span>
            </div>
            <div class="phs-card">
              <span class="phs-num">10+</span>
              <span class="phs-lbl" data-i18n="page.car.stat3">Supervised Theses</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Components -->
    <Career />
    <Education />
    <MentorshipAlumni />
    <Service />
    <Awards />

    <Footer />
  </main>
</Layout>

<style>
  .page-container {
    padding-top: 72px;
  }
  .page-hero-sec {
    padding: 70px 5vw 40px;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .breadcrumbs a {
    color: var(--teal);
    text-decoration: none;
    transition: color .2s;
  }
  .breadcrumbs a:hover {
    color: var(--amber);
  }
  .bc-sep {
    color: var(--ink2);
    opacity: 0.5;
  }
  .bc-current {
    color: var(--ink);
    font-weight: 700;
  }
  .page-hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
    align-items: center;
  }
  .page-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    line-height: 1.08;
    color: var(--ink);
    margin-bottom: 18px;
  }
  .page-title .it {
    font-style: italic;
    color: var(--teal);
  }
  .page-intro {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--ink2);
    max-width: 60ch;
  }
  .page-hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .phs-card {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 24px 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .phs-num {
    font-family: var(--display);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--amber2);
    line-height: 1;
  }
  .phs-lbl {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink2);
  }

  @media (max-width: 900px) {
    .page-hero-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
