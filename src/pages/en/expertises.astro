---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Expertise from "../../components/Expertise.astro";
import ResearchRadar from "../../components/ResearchRadar.astro";
import AnophelesAnatomy from "../../components/AnophelesAnatomy.astro";
import ScientificImpact from "../../components/ScientificImpact.astro";
---

<Layout
  title="Areas of Expertise & Research — Dr Idelphonse Ahogni, PhD | Medical Entomology"
  description="Explore the 8 core intervention pillars, 6-axis research radar, vector anatomy, and scientific impact of Dr Idelphonse Ahogni: insecticide resistance, GLP Covè experimental huts, LLIN evaluation, and project management."
>
  <Header />
  <main class="page-container">
    <!-- Page Hero -->
    <section class="page-hero-sec">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/en" data-i18n="nav.home">Home</a>
          <span class="bc-sep" aria-hidden="true">/</span>
          <span class="bc-current" data-i18n="nav.expertises">Expertise &amp; Research</span>
        </nav>

        <div class="page-hero-grid">
          <div>
            <p class="sec-eyebrow" data-i18n="page.exp.eyebrow">Areas of Expertise</p>
            <h1 class="page-title lm">
              <span class="ln"><span>Scientific excellence &amp;</span></span>
              <span class="ln"><span><span class="it">operational expertise</span></span></span>
            </h1>
            <p class="page-intro" data-i18n="page.exp.intro">
              A unique combination of translational laboratory research, rigorous OECD/WHO GLP (Good Laboratory Practice) standards, and direct support to national and global public health policies.
            </p>
          </div>
          <div class="page-hero-stats">
            <div class="phs-card">
              <span class="phs-num">08</span>
              <span class="phs-lbl" data-i18n="page.exp.stat1">Core Intervention Pillars</span>
            </div>
            <div class="phs-card">
              <span class="phs-num">06</span>
              <span class="phs-lbl" data-i18n="page.exp.stat2">Key Research Axes</span>
            </div>
            <div class="phs-card">
              <span class="phs-num">GLP</span>
              <span class="phs-lbl" data-i18n="page.exp.stat3">Certification &amp; WHO Trials</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Components -->
    <Expertise />
    <ResearchRadar />
    <AnophelesAnatomy />
    <ScientificImpact />

    <!-- Direct Contact CTA -->
    <section class="sec exp-cta-sec">
      <div class="wrap">
        <div class="exp-cta-box">
          <div>
            <p class="sec-eyebrow" data-i18n="cta.eyebrow">Collaboration</p>
            <h2 class="title" data-i18n-html="page.exp.cta.title"><span class="ln"><span>Need technical advice</span></span><span class="ln"><span>or <span class="it">consultancy?</span></span></span></h2>
            <p class="exp-cta-p" data-i18n="page.exp.cta.desc">
              Available for evaluation missions, GLP protocol audits, Phase II/III clinical trial designs, and vector control strategic reviews.
            </p>
          </div>
          <div class="exp-cta-actions">
            <a href="/en/contact" class="btn amber" data-i18n="action.contact">Contact me ↗</a>
            <a href="/en/cv" class="btn ghost" data-i18n="action.cv">View full CV</a>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  .page-container {
    padding-top: 72px;
  }
  .page-hero-sec {
    padding: 70px 5vw 40px;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .breadcrumbs a {
    color: var(--teal);
    text-decoration: none;
    transition: color .2s;
  }
  .breadcrumbs a:hover {
    color: var(--amber);
  }
  .bc-sep {
    color: var(--ink2);
    opacity: 0.5;
  }
  .bc-current {
    color: var(--ink);
    font-weight: 700;
  }
  .page-hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
    align-items: center;
  }
  .page-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    line-height: 1.08;
    color: var(--ink);
    margin-bottom: 18px;
  }
  .page-title .it {
    font-style: italic;
    color: var(--teal);
  }
  .page-intro {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--ink2);
    max-width: 60ch;
  }
  .page-hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .phs-card {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 24px 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .phs-num {
    font-family: var(--display);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--amber2);
    line-height: 1;
  }
  .phs-lbl {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink2);
  }

  .exp-cta-sec {
    padding: 80px 5vw;
    background: var(--paper);
    border-top: 1px solid var(--line);
  }
  .exp-cta-box {
    background: var(--surface);
    border: 1.5px solid var(--line);
    padding: clamp(36px, 6vw, 64px);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .exp-cta-p {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--ink2);
    margin-top: 14px;
    max-width: 50ch;
  }
  .exp-cta-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 900px) {
    .page-hero-grid, .exp-cta-box {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .exp-cta-actions {
      justify-content: flex-start;
    }
  }
</style>
