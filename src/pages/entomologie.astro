---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import VectorExplorer from "../components/VectorExplorer.astro";
import GeneticsCalculator from "../components/GeneticsCalculator.astro";
import SampleSizeCalculator from "../components/SampleSizeCalculator.astro";
import LlinMatrix from "../components/LlinMatrix.astro";
import CostEffectiveness from "../components/CostEffectiveness.astro";
---

<Layout
  title="Entomologie Médicale & Calculatrices — Dr Idelphonse Ahogni, PhD"
  description="Plateforme interactive d'entomologie médicale : fiches des vecteurs anophéliens, bio-essais OMS avec formule d'Abbott, calculatrice de génétique des populations kdr/ace-1, dimensionnement d'échantillons de Fleiss, matrice MILDV et simulateur médico-économique."
>
  <Header />
  <main class="page-container">
    <section class="page-hero-sec">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Fil d'Ariane">
          <a href="/" data-i18n="nav.home">Accueil</a>
          <span class="bc-sep" aria-hidden="true">/</span>
          <span class="bc-current" data-i18n="nav.entomology">Entomologie &amp; Calculatrices</span>
        </nav>

        <div class="page-hero-grid">
          <div>
            <p class="sec-eyebrow" data-i18n="page.ent.eyebrow">Biométrie &amp; Vecteurs</p>
            <h1 class="page-title lm">
              <span class="ln"><span>Entomologie médicale &amp;</span></span>
              <span class="ln"><span><span class="it">outils d'analyse biométrique</span></span></span>
            </h1>
            <p class="page-intro" data-i18n="page.ent.intro">
              Outils interactifs de calcul et de modélisation conçus pour les chercheurs, gestionnaires de programmes de lutte antivectorielle et étudiants en entomologie de santé publique.
            </p>
          </div>
          <div class="page-hero-stats">
            <div class="phs-card">
              <span class="phs-num">04</span>
              <span class="phs-lbl" data-i18n="page.ent.stat1">Espèces Anophèles</span>
            </div>
            <div class="phs-card">
              <span class="phs-num">HWE</span>
              <span class="phs-lbl" data-i18n="page.ent.stat2">Test χ² &amp; Allèles kdr</span>
            </div>
            <div class="phs-card">
              <span class="phs-num">100%</span>
              <span class="phs-lbl" data-i18n="page.ent.stat3">Normes &amp; SOPs OMS</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Composants interactifs & calculatrices -->
    <VectorExplorer />
    <GeneticsCalculator />
    <SampleSizeCalculator />
    <LlinMatrix />
    <CostEffectiveness />

    <Footer />
  </main>
</Layout>

<style>
  .page-container {
    padding-top: 72px;
  }
  .page-hero-sec {
    padding: 70px 5vw 40px;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .breadcrumbs a {
    color: var(--teal);
    text-decoration: none;
    transition: color .2s;
  }
  .breadcrumbs a:hover {
    color: var(--amber);
  }
  .bc-sep {
    color: var(--ink2);
    opacity: 0.5;
  }
  .bc-current {
    color: var(--ink);
    font-weight: 700;
  }
  .page-hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
    align-items: center;
  }
  .page-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    line-height: 1.08;
    color: var(--ink);
    margin-bottom: 18px;
  }
  .page-title .it {
    font-style: italic;
    color: var(--teal);
  }
  .page-intro {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--ink2);
    max-width: 60ch;
  }
  .page-hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .phs-card {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 24px 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .phs-num {
    font-family: var(--display);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--amber2);
    line-height: 1;
  }
  .phs-lbl {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink2);
  }

  @media (max-width: 900px) {
    .page-hero-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
