---
import { sanityClient } from "sanity:client";
import { CONTENT_QUERY, cachedFetch } from "../lib/queries";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import VideoGallery from "../components/VideoGallery.astro";
import SpeakerWizard from "../components/SpeakerWizard.astro";

const content = await cachedFetch(sanityClient, CONTENT_QUERY);
const talks = content?.talks ?? [];
const years = [...new Set(talks.map((t: any) => t.year).filter(Boolean))].sort((a: number, b: number) => b - a);
const types = [...new Set(talks.map((t: any) => t.type).filter(Boolean))].sort();
---

<Layout title="Conférences & Présentations — Dr Idelphonse Ahogni, PhD | Lutte Antivectorielle" description="Conférences, présentations scientifiques et interventions du Dr Idelphonse Bonaventure Ahogni — paludisme, lutte antivectorielle, résistance aux insecticides, entomologie médicale. Colloques internationaux OMS, PAMCA, LSTM.">
  <Header />
  <main>
    <section class="sec speak-sec" id="speaking">
      <div class="speak-head">
        <div class="wrap">
          <p class="sec-eyebrow" data-i18n="speaking.eyebrow">Communications</p>
          <h1 class="title lm" data-i18n-html="speaking.title">
            <span class="ln"><span>Conférences &amp;</span></span>
            <span class="ln"><span><span class="it">présentations</span></span></span>
          </h1>
          <p class="speak-intro" data-i18n="speaking.intro">Interventions scientifiques, communications lors de congrès et colloques internationaux sur la lutte antivectorielle et la santé publique.</p>
        </div>
      </div>

      <div class="speak-content">
        <div class="wrap">
          <div class="speak-filters">
            <div class="sf-left">
              <button class="sf-btn active" data-speak-filter="all">Toutes ({talks.length})</button>
              {years.map((y: number) => (
                <button class="sf-btn" data-speak-filter={`year:${y}`}>{y}</button>
              ))}
            </div>
            {types.length > 0 && (
              <div class="sf-left">
                {types.map((t: string) => (
                  <button class="sf-btn sf-type" data-speak-filter={`type:${t}`}>{t}</button>
                ))}
              </div>
            )}
          </div>

          <div class="speak-list" id="speakList">
            {talks.map((talk: any, i: number) => (
              <div class="speak-item rv" data-year={talk.year} data-type={talk.type || ""}>
                <span class="speak-idx">{String(i + 1).padStart(2, "0")}</span>
                <span class="speak-year">{talk.year}</span>
                <span class="speak-type">{talk.type}</span>
                <div class="speak-body">
                  <h3>{talk.title}</h3>
                  <p class="speak-loc">{talk.location}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="speak-empty" id="speakEmpty" style="display:none;">
            <p>Aucune communication ne correspond au filtre sélectionné.</p>
          </div>
        </div>
      </div>
    </section>

    <VideoGallery />
    <SpeakerWizard />
  </main>
  <Footer />
</Layout>

<style>
  .speak-sec { padding: 0; }
  .speak-head { background: #0B0F17; color: #F8FAFC; padding: 160px 5vw 60px; }
  .speak-head .sec-eyebrow { color: var(--amber2); font-weight: 700; }
  .speak-head .sec-eyebrow::before { background: var(--amber2); }
  .speak-head h1 { color: #FFFFFF; }
  .speak-head .it { color: var(--amber2); }
  .speak-intro { color: #CBD5E1; max-width: 64ch; margin-top: 20px; font-size: 1.08rem; line-height: 1.7; }
  .speak-content { background: var(--paper); color: var(--ink); padding: 60px 5vw; }

  .speak-filters { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 40px; padding: 20px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .sf-left { display: flex; gap: 8px; flex-wrap: wrap; }
  .sf-btn {
    font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
    border: 1px solid var(--line); background: transparent; color: var(--ink);
    padding: 8px 14px; cursor: pointer; transition: all .25s;
  }
  .sf-btn:hover { border-color: var(--ink); background: rgb(var(--rgb-ink) / .05); }
  .sf-btn.active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .sf-type { border-style: dashed; }
  .sf-type.active { border-style: solid; }

  .speak-list { border-top: 1px solid var(--line); }
  .speak-item {
    display: grid; grid-template-columns: 40px 60px 100px 1fr; gap: 16px; align-items: start;
    padding: 22px 10px; border-bottom: 1px solid var(--line);
    transition: background .3s, padding-left .3s;
  }
  .speak-item:hover { background: rgb(var(--rgb-amber) / .07); padding-left: 16px; }
  .speak-idx { font-family: var(--display); font-style: italic; font-size: 1.1rem; color: var(--coral); }
  .speak-year { font-family: var(--display); font-style: italic; font-size: 1.1rem; color: var(--teal); }
  .speak-type {
    font-family: var(--mono); font-size: 9px; letter-spacing: .12em; text-transform: uppercase;
    border: 1px solid var(--line); padding: 3px 8px; color: var(--coral); align-self: start; margin-top: 2px;
  }
  .speak-body h3 { font-family: var(--display); font-weight: 600; font-size: 1.05rem; line-height: 1.4; margin-bottom: 4px; }
  .speak-loc { font-family: var(--mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: rgb(var(--rgb-ink) / .6); }

  .speak-empty { text-align: center; padding: 60px 20px; font-family: var(--mono); font-size: 12px; letter-spacing: .1em; color: rgb(var(--rgb-ink) / .5); border: 1px dashed var(--line); margin-top: 20px; }
  .speak-cta { margin-top: 50px; padding-top: 30px; border-top: 1px solid var(--line); }

  /* ── Dark Mode ── */
  html[data-theme="dark"] .speak-content { background: var(--surface); color: var(--ink); }
  html[data-theme="dark"] .sf-btn {
    color: var(--ink);
    border-color: var(--line);
  }
  html[data-theme="dark"] .sf-btn:hover {
    background: var(--paper2);
    border-color: var(--amber);
  }
  html[data-theme="dark"] .sf-btn.active {
    background: var(--amber);
    color: #060B09;
    border-color: var(--amber);
    font-weight: 700;
  }
  html[data-theme="dark"] .speak-item:hover {
    background: rgba(245, 158, 11, 0.12);
  }
  html[data-theme="dark"] .speak-loc {
    color: var(--ink2);
  }
  html[data-theme="dark"] .speak-type {
    border-color: var(--line);
  }

  @media (max-width: 900px) { .speak-filters { flex-direction: column; align-items: flex-start; } }
  @media (max-width: 640px) { .speak-item { grid-template-columns: 1fr; gap: 8px; } .speak-idx, .speak-year, .speak-type { display: inline; } }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btns = document.querySelectorAll<HTMLElement>(".sf-btn");
    const items = document.querySelectorAll<HTMLElement>(".speak-item");
    const empty = document.getElementById("speakEmpty");
    let active = "all";

    function apply() {
      let vis = 0;
      items.forEach(el => {
        const match = active === "all" || (active.startsWith("year:") && el.dataset.year === active.slice(5)) || (active.startsWith("type:") && el.dataset.type === active.slice(5));
        el.style.display = match ? "" : "none";
        if (match) vis++;
      });
      if (empty) empty.style.display = vis === 0 ? "" : "none";
    }

    btns.forEach(btn => {
      btn.addEventListener("click", () => {
        const wasActive = btn.classList.contains("active");
        btns.forEach(b => b.classList.remove("active"));
        if (wasActive) { active = "all"; } else { btn.classList.add("active"); active = btn.dataset.speakFilter || "all"; }
        apply();
      });
    });
  });
</script>
