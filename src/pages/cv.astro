---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { sanityClient } from "sanity:client";
import { CONTENT_QUERY, cachedFetch, SETTINGS_QUERY } from "../lib/queries";

const settings = await cachedFetch(sanityClient, SETTINGS_QUERY);
const content = await cachedFetch(sanityClient, CONTENT_QUERY);
---

<Layout title="CV — Dr Idelphonse Bonaventure Ahogni, PhD" description="Curriculum vitæ du Dr Idelphonse Ahogni — gestionnaire de programme paludisme, entomologiste médical." noindex>
  <Header />
  <main>
    <section class="sec" id="cv-page">
      <div class="wrap">
        <div class="sec-head">
          <p class="sec-eyebrow" data-i18n="cv.eyebrow">07 — Curriculum Vitæ</p>
          <h1 class="title lm" data-i18n-html="cv.title">
            <span class="ln"><span>Parcours complet,</span></span>
            <span class="ln"><span><span class="it">formation &amp; expertise</span></span></span>
          </h1>
          <p class="cv-intro rv" data-i18n="cv.intro">
            Gestionnaire de programme paludisme, entomologiste médical —
            formations, parcours professionnel, compétences et publications sélectionnées.
          </p>
        </div>

        <div class="cv-toolbar no-print rv">
          <div class="cv-view-toggle">
            <button type="button" class="cv-mode-btn active" data-mode="full" data-i18n="cv.modeFull">Vue Détaillée</button>
            <button type="button" class="cv-mode-btn" data-mode="summary" data-i18n="cv.modeSummary">Executive Summary (1-Page)</button>
          </div>
          <div class="cv-actions">
            <button id="printBtn" class="btn-cv-action" type="button" data-i18n="cv.btnPdf">⬇ Télécharger PDF</button>
            <a class="btn-cv-action" href="/cv.json" target="_blank" download="Dr_Idelphonse_AHOGNI_resume.json">📋 JSON Resume</a>
            <a class="btn-cv-action" href="/contact.vcf" download="Dr_Idelphonse_AHOGNI.vcf">📇 Contact (.vcf)</a>
            <a class="btn-cv-back" href="/" data-i18n="action.back">← Retour au site</a>
          </div>
        </div>

        <!-- Document CV A4 -->
        <div class="cv" id="cvDocument" data-mode="full">
          <header class="cv-head">
            <p class="cv-eyebrow">Curriculum Vitæ · République du Bénin</p>
            <h1>{settings?.heroName?.firstName} <em>{settings?.heroName?.middleName}</em> {settings?.heroName?.lastName}, {settings?.heroName?.suffix}</h1>
            <p class="role">{settings?.heroTagline}</p>
            <p class="contact">
              {settings?.contactEmail && <span><a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a></span>}
              {settings?.contactPhone && settings?.contactEmail && <span>·</span>}
              {settings?.contactPhone && <span>{settings.contactPhone}</span>}
              <span>· Cotonou, Bénin</span>
              {settings?.linkedin && settings?.linkedin !== "#" && <span>· <a href={settings.linkedin}>LinkedIn ↗</a></span>}
              {settings?.researchGate && settings?.researchGate !== "#" && <span>· <a href={settings.researchGate}>ResearchGate ↗</a></span>}
              {settings?.orcid && settings?.orcid !== "#" && <span>· <a href={settings.orcid}>ORCID ↗</a></span>}
            </p>
          </header>

          <!-- Section Chiffres clés (Visible en mode Executive Summary) -->
          <section class="cv-summary-only">
            <h2><span class="sec-num">★</span> Faits saillants &amp; Impact</h2>
            <div class="summary-stats-grid">
              <div class="s-stat"><span class="s-num">10+</span><span class="s-lbl">Ans d'expérience terrain</span></div>
              <div class="s-stat"><span class="s-num">25+</span><span class="s-lbl">Publications internationales</span></div>
              <div class="s-stat"><span class="s-num">9</span><span class="s-lbl">Pays d'intervention en Afrique</span></div>
              <div class="s-stat"><span class="s-num">Phase III</span><span class="s-lbl">Essais cliniques &amp; moustiquaires</span></div>
            </div>
          </section>

          <section>
            <h2><span class="sec-num">01</span> Profil &amp; Synthèse professionnelle</h2>
            {content?.aboutText && <p>{content.aboutText.map((b: any) => b.children?.map((c: any) => c.text).join("")).join(" ")}</p>}
          </section>

          <section>
            <h2><span class="sec-num">02</span> Expertises clés</h2>
            <ul class="two-col">
              {content?.expertise?.map((e: any) => <li class="cv-item"><b>{e.title}.</b> {e.description}</li>)}
            </ul>
          </section>

          <section>
            <h2><span class="sec-num">03</span> Parcours professionnel</h2>
            {content?.career?.map((j: any, i: number) => (
              <div class={`entry ${i >= 3 ? "cv-full-only" : ""}`}>
                <div class="when">{j.dateRange}</div>
                <div class="what">
                  <h3>{j.title}</h3>
                  <span class="org">{j.org}</span>
                </div>
              </div>
            ))}
          </section>

          <section>
            <h2><span class="sec-num">04</span> Formation &amp; Diplômes</h2>
            {content?.education?.map((e: any) => (
              <div class="entry">
                <div class="when">{e.year}</div>
                <div class="what"><h3>{e.title}</h3><span class="org">{e.school}</span></div>
              </div>
            ))}
          </section>

          <section class="cv-full-only">
            <h2><span class="sec-num">05</span> Compétences techniques &amp; Méthodes</h2>
            <ul class="two-col">
              {content?.skillGroups?.map((g: any) => <li><b>{g.category} :</b> {g.tags?.join(", ")}</li>)}
            </ul>
          </section>

          <section>
            <h2><span class="sec-num">06</span> Publications sélectionnées</h2>
            <p class="note">{content?.publicationsNote}</p>
            <ol class="pubs">
              {content?.publications?.slice(0, 12).map((p: any, i: number) => (
                <li class={i >= 5 ? "cv-full-only" : ""}>
                  {p.authors} ({p.year}). <b>{p.title}</b>. <em>{p.journal}</em>.
                  {p.doi && <span class="cv-doi-print"> doi:{p.doi}</span>}
                </li>
              ))}
            </ol>
          </section>
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  .cv-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    background: #111827;
    color: #F8FAFC;
    border: 1px solid rgba(255,255,255,0.12);
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .cv-view-toggle {
    display: flex;
    gap: 4px;
    background: rgba(255,255,255,.08);
    padding: 4px;
    border: 1px solid rgba(255,255,255,0.15);
  }
  .cv-mode-btn {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    border: none;
    background: transparent;
    color: #CBD5E1;
    padding: 7px 14px;
    cursor: pointer;
    transition: all .2s;
  }
  .cv-mode-btn.active {
    background: var(--amber2);
    color: #0B0F17;
    font-weight: 700;
  }
  .cv-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .btn-cv-action, .btn-cv-back {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    border: none;
    padding: 8px 16px;
    cursor: pointer;
    text-decoration: none;
    transition: background .2s, color .2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .btn-cv-action { background: #F8FAFC; color: #111827; font-weight: 700; }
  .btn-cv-action:hover { background: var(--amber2); color: #0B0F17; }
  .btn-cv-back { background: rgba(255,255,255,.14); color: #F8FAFC; }
  .btn-cv-back:hover { background: rgba(255,255,255,.25); }

  .cv {
    width: 210mm; min-height: 297mm; margin: 0 auto;
    background: var(--paper); padding: 16mm 14mm;
    box-shadow: 0 8px 32px rgba(0,0,0,.12);
  }

  /* ── Gestion des modes d'affichage ── */
  .cv-summary-only { display: none; }
  .cv[data-mode="summary"] .cv-summary-only { display: block; }
  .cv[data-mode="summary"] .cv-full-only { display: none !important; }
  .cv[data-mode="summary"] { min-height: auto; }

  .summary-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 12px;
    margin: 8px 0 14px;
    text-align: center;
  }
  .s-num {
    font-family: var(--display);
    font-weight: 700;
    font-size: 14pt;
    color: var(--coral);
    display: block;
  }
  .s-lbl {
    font-family: var(--mono);
    font-size: 8pt;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--ink2);
  }

  .cv-head { border-bottom: 3px solid var(--ink); padding-bottom: 10px; margin-bottom: 16px; }
  .cv-eyebrow {
    font-family: var(--mono); font-size: 10px; letter-spacing: .18em; text-transform: uppercase;
    color: var(--teal); margin-bottom: 6px;
  }
  .cv-head h1, .cv-head h2 {
    font-family: var(--display); font-weight: 700; font-size: 22pt; line-height: 1.1;
  }
  .cv-head h1 em, .cv-head h2 em { font-style: normal; color: var(--coral); }
  .cv-head .role { font-size: 10.5pt; color: var(--ink2); margin-top: 3px; }
  .cv-head .contact {
    font-family: var(--mono); font-size: 9pt; color: var(--ink2); margin-top: 6px;
    display: flex; flex-wrap: wrap; gap: 4px;
  }
  .cv-head .contact a { color: var(--teal); text-decoration: none; }
  .cv-head .contact a:hover { text-decoration: underline; }

  section { margin-bottom: 14px; }
  section h2 {
    font-family: var(--display); font-weight: 600; font-size: 13pt;
    color: var(--ink); border-bottom: 1px solid var(--line); padding-bottom: 4px; margin-bottom: 8px;
    display: flex; align-items: baseline; gap: 10px;
  }
  .sec-num {
    font-family: var(--mono); font-size: 9px; letter-spacing: .12em;
    color: var(--teal); font-weight: 400;
  }
  section > p { margin-bottom: 6px; text-align: justify; }
  ul { padding-left: 0; list-style: none; }
  .two-col li { margin-bottom: 5px; text-align: justify; font-size: 10.5pt; }
  .two-col b { color: var(--ink); font-weight: 600; }

  .entry { display: grid; grid-template-columns: 62mm 1fr; gap: 10px; margin-bottom: 8px; }
  .entry .when {
    font-family: var(--mono); font-size: 9.5pt; font-weight: 600; color: var(--teal);
    padding-top: 1px;
  }
  .entry h3 { font-family: var(--display); font-size: 11pt; font-weight: 600; }
  .entry .org { font-style: italic; color: var(--ink2); font-size: 10pt; }

  .note { font-style: italic; color: var(--ink2); font-size: 9.5pt; margin-bottom: 5px; }
  .pubs { padding-left: 5mm; list-style: decimal; }
  .pubs li { margin-bottom: 4px; text-align: justify; font-size: 9.5pt; }
  .pubs em { color: var(--ink2); }
  .cv-doi-print { font-family: var(--mono); font-size: 8.5pt; color: var(--coral); }

  html[data-theme="dark"] .cv {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    box-shadow: 0 16px 40px rgba(0,0,0,.5);
  }
  html[data-theme="dark"] .cv-head { border-color: var(--line); }
  html[data-theme="dark"] .cv-head h1, html[data-theme="dark"] .cv-head h2 { color: var(--ink); }
  html[data-theme="dark"] .cv-head h1 em, html[data-theme="dark"] .cv-head h2 em { color: var(--amber); }
  html[data-theme="dark"] .cv-head .role { color: var(--ink2); }
  html[data-theme="dark"] .cv-head .contact { color: var(--ink2); }
  html[data-theme="dark"] .cv-head .contact a { color: var(--teal); }
  html[data-theme="dark"] section h2 { color: var(--ink); border-color: var(--line); }
  html[data-theme="dark"] .sec-num { color: var(--amber); }
  html[data-theme="dark"] section > p { color: var(--ink); }
  html[data-theme="dark"] .two-col b { color: var(--ink); }
  html[data-theme="dark"] .two-col li { color: var(--ink2); }
  html[data-theme="dark"] .entry .when { color: var(--amber); }
  html[data-theme="dark"] .entry h3 { color: var(--ink); }
  html[data-theme="dark"] .entry .org { color: var(--ink2); }
  html[data-theme="dark"] .note { color: var(--ink2); }
  html[data-theme="dark"] .pubs li { color: var(--ink); }
  html[data-theme="dark"] .pubs em { color: var(--teal); }
  html[data-theme="dark"] .summary-stats-grid { background: var(--paper2); border-color: var(--line); }
  html[data-theme="dark"] .s-num { color: var(--amber); }
  html[data-theme="dark"] .s-lbl { color: var(--ink2); }

  @media print {
    .no-print { display: none !important; }
    .cv { box-shadow: none; width: auto; min-height: auto; padding: 0; }
  }
  @media screen and (max-width: 640px) {
    .entry { grid-template-columns: 1fr; }
    .cv { width: auto; padding: 24px 16px; }
    .summary-stats-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const printBtn = document.getElementById("printBtn");
    const doc = document.getElementById("cvDocument");
    const modeBtns = document.querySelectorAll<HTMLButtonElement>(".cv-mode-btn");

    printBtn?.addEventListener("click", () => window.print());

    modeBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        modeBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        const mode = btn.dataset.mode || "full";
        if (doc) doc.setAttribute("data-mode", mode);
      });
    });
  });
</script>
