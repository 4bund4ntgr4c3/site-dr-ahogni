---
import { sanityClient } from "sanity:client";
import { CONTENT_QUERY } from "../lib/queries";
import { cachedFetch } from "../lib/queries";
import { SETTINGS_QUERY } from "../lib/queries";

const settings = await cachedFetch(sanityClient, SETTINGS_QUERY);
const content = await cachedFetch(sanityClient, CONTENT_QUERY);
const site = "https://idelphonseahogni.com";
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CV — Dr Idelphonse Bonaventure Ahogni, PhD</title>
  <meta name="description" content="Curriculum vitæ du Dr Idelphonse Ahogni — gestionnaire de programme paludisme, entomologiste médical.">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
  <div class="toolbar no-print">
    <button id="printBtn" type="button">⬇ Télécharger / imprimer en PDF</button>
    <a href="/">← Retour au site</a>
  </div>

  <main class="cv">
    <header class="cv-head">
      <h1>{settings?.heroName?.firstName} <em>{settings?.heroName?.middleName}</em> {settings?.heroName?.lastName}, {settings?.heroName?.suffix}</h1>
      <p class="role">{settings?.heroTagline}</p>
      <p class="contact">
        {settings?.contactEmail && <span><a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a></span>}
        {settings?.contactPhone && settings?.contactEmail && <span>·</span>}
        {settings?.contactPhone && <span>{settings.contactPhone}</span>}
        <span>· Cotonou, Bénin</span>
        {settings?.linkedin && settings?.linkedin !== "#" && <span>· <a href={settings.linkedin}>LinkedIn ↗</a></span>}
        {settings?.researchGate && settings?.researchGate !== "#" && <span>· <a href={settings.researchGate}>ResearchGate ↗</a></span>}
        {settings?.orcid && settings?.orcid !== "#" && <span>· <a href={settings.orcid}>ORCID ↗</a></span>}
      </p>
    </header>

    <section>
      <h2>Profil</h2>
      {content?.aboutText && <p>{content.aboutText.map((b: any) => b.children?.map((c: any) => c.text).join("")).join(" ")}</p>}
    </section>

    <section>
      <h2>Expertises</h2>
      <ul class="two-col">
        {content?.expertise?.map((e: any) => <li><b>{e.title}.</b> {e.description}</li>)}
      </ul>
    </section>

    <section>
      <h2>Parcours professionnel</h2>
      {content?.career?.map((j: any) => (
        <div class="entry">
          <div class="when">{j.dateRange}</div>
          <div class="what">
            <h3>{j.title}</h3>
            <span class="org">{j.org}</span>
          </div>
        </div>
      ))}
    </section>

    <section>
      <h2>Formation</h2>
      {content?.education?.map((e: any) => (
        <div class="entry">
          <div class="when">{e.year}</div>
          <div class="what"><h3>{e.title}</h3><span class="org">{e.school}</span></div>
        </div>
      ))}
    </section>

    <section>
      <h2>Compétences</h2>
      <ul class="two-col">
        {content?.skillGroups?.map((g: any) => <li><b>{g.category} :</b> {g.tags?.join(", ")}</li>)}
      </ul>
    </section>

    <section>
      <h2>Publications sélectionnées</h2>
      <p class="note">{content?.publicationsNote}</p>
      <ol class="pubs">
        {content?.publications?.slice(0, 12).map((p: any) => (
          <li>{p.authors} ({p.year}). <b>{p.title}</b>. <em>{p.journal}</em>.</li>
        ))}
      </ol>
    </section>
  </main>

  <style>
    @page { size: A4; margin: 14mm 13mm; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --ink: #0D221C; --paper: #ffffff; --acc: #C4503B; --line: #cfd6cf; --muted: #3a4a44;
    }
    body { font-family: "Segoe UI", Arial, sans-serif; color: var(--ink); font-size: 11pt; line-height: 1.45; background: #ececec; }
    .toolbar { position: sticky; top: 0; z-index: 10; display: flex; gap: 12px; align-items: center; justify-content: center; padding: 14px; background: var(--ink); color: #fff; }
    .toolbar button, .toolbar a { font: 600 12px/1 system-ui; letter-spacing: .04em; border: 0; border-radius: 4px; padding: 10px 18px; cursor: pointer; text-decoration: none; }
    .toolbar button { background: #fff; color: var(--ink); }
    .toolbar a { background: rgba(255,255,255,.15); color: #fff; }
    .cv { width: 210mm; min-height: 297mm; margin: 16px auto; background: var(--paper); padding: 14mm 13mm; box-shadow: 0 4px 18px rgba(0,0,0,.15); }
    .cv-head { border-bottom: 3px solid var(--ink); padding-bottom: 8px; margin-bottom: 14px; }
    .cv-head h1 { font-size: 21pt; line-height: 1.1; }
    .cv-head h1 em { font-style: normal; color: var(--acc); }
    .cv-head .role { font-size: 10.5pt; color: var(--muted); margin-top: 3px; }
    .cv-head .contact { font-size: 9pt; color: var(--muted); margin-top: 6px; }
    .cv-head .contact a { color: var(--ink); }
    section { margin-bottom: 12px; }
    section h2 { font-size: 12pt; text-transform: uppercase; letter-spacing: .06em; color: var(--acc); border-bottom: 1px solid var(--line); padding-bottom: 3px; margin-bottom: 8px; }
    section > p { margin-bottom: 6px; text-align: justify; }
    ul { padding-left: 0; list-style: none; }
    .two-col li { margin-bottom: 5px; text-align: justify; }
    .two-col b { color: var(--ink); }
    .entry { display: grid; grid-template-columns: 62mm 1fr; gap: 10px; margin-bottom: 8px; }
    .entry .when { font-weight: 600; color: var(--acc); }
    .entry h3 { font-size: 11pt; }
    .entry .org { font-style: italic; color: var(--muted); font-size: 10pt; }
    .note { font-style: italic; color: var(--muted); font-size: 9.5pt; margin-bottom: 5px; }
    .pubs { padding-left: 5mm; list-style: decimal; }
    .pubs li { margin-bottom: 4px; text-align: justify; font-size: 9.5pt; }
    .pubs em { color: var(--muted); }

    @media print {
      body { background: #fff; }
      .no-print { display: none !important; }
      .cv { box-shadow: none; margin: 0; width: auto; min-height: auto; }
    }
    @media screen and (max-width: 640px) {
      .entry { grid-template-columns: 1fr; }
    }
  </style>
  <script>
    document.getElementById("printBtn")!.addEventListener("click", () => window.print());
  </script>
</body>
</html>