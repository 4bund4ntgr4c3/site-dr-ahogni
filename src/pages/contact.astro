---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ContactPage from "../components/ContactPage.astro";
import Footer from "../components/Footer.astro";
import { sanityClient } from "sanity:client";
import { CONTENT_QUERY, cachedFetch } from "../lib/queries";

const content = await cachedFetch(sanityClient, CONTENT_QUERY);
const faqItems = content?.faq ?? [];
---

<Layout title="Contacter le Dr Idelphonse Ahogni, PhD — Missions & Consultations Paludisme" description="Contacter le Dr Idelphonse Bonaventure Ahogni, entomologiste médical et expert paludisme au Bénin. Formulaire, disponibilités, coordonnées et questions fréquentes. Réponse sous 48 h ouvrées." bodyClass="on-contact">
  <Header />
  <main>
    <ContactPage />
    <Footer />
  </main>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact & Prise de Rendez-vous — Dr Idelphonse Ahogni",
  "description": "Formulaire de contact, prise de rendez-vous et coordonnées officielles du Dr Idelphonse Bonaventure Ahogni, entomologiste médical.",
  "url": "https://idelphonseahogni.com/contact/",
  "mainEntity": {
    "@type": "Person",
    "name": "Dr Idelphonse Bonaventure Ahogni",
    "jobTitle": "Entomologiste Médical & Expert Paludisme",
    "url": "https://idelphonseahogni.com/"
  }
})} />
