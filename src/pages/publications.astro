---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PublicationsPage from "../components/PublicationsPage.astro";
import Footer from "../components/Footer.astro";
import { sanityClient } from "sanity:client";
import { CONTENT_QUERY, cachedFetch } from "../lib/queries";

const content = await cachedFetch(sanityClient, CONTENT_QUERY);
const publications = content?.publications ?? [];
---

<Layout title="Publications Scientifiques — Dr Idelphonse Ahogni, PhD | Paludisme & Entomologie" description="25+ publications du Dr Idelphonse Bonaventure Ahogni dans des revues internationales (Malaria Journal, Parasites & Vectors, Acta Tropica, PLOS ONE). Recherche sur le paludisme, malaria, résistance aux insecticides, moustiquaires imprégnées et lutte antivectorielle au Bénin.">
  <Header />
  <main>
    <PublicationsPage />
    <Footer />
  </main>
  {publications.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Publications Scientifiques du Dr Idelphonse Ahogni",
    "description": "Liste complète des publications scientifiques évaluées par les pairs du Dr Idelphonse Bonaventure Ahogni.",
    "url": "https://idelphonseahogni.com/publications/",
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": publications.length,
      "itemListElement": publications.map((pub: any, i: number) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": {
          "@type": "ScholarlyArticle",
          "headline": pub.title,
          "author": {
            "@type": "Person",
            "name": "Dr Idelphonse B. Ahogni",
            "url": "https://idelphonseahogni.com",
          },
          ...(pub.journal && { "publisher": { "@type": "Organization", "name": pub.journal } }),
          ...(pub.year && { "datePublished": String(pub.year) }),
          ...(pub.doi && { "sameAs": `https://doi.org/${pub.doi}` }),
          ...(pub.url && { "url": pub.url }),
        },
      })),
    },
  })} />}
</Layout>
