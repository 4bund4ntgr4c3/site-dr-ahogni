---
import { sanityClient } from "sanity:client";
import { PortableText } from "astro-portabletext";
import { createImageUrlBuilder } from "@sanity/image-url";
import { POSTS_QUERY, POST_QUERY, cachedFetch } from "../../lib/queries";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = await cachedFetch(sanityClient, POSTS_QUERY);
  return (posts ?? []).map((p: any) => ({ params: { slug: p.slug?.current }, props: { slug: p.slug?.current } }));
}

const { slug } = Astro.props;
const post = await cachedFetch(sanityClient, POST_QUERY, { slug });
const urlFor = (source: any) => sanityClient.config().projectId ? createImageUrlBuilder({ projectId: sanityClient.config().projectId!, dataset: sanityClient.config().dataset! }).image(source) : null;
const cover = post?.coverImage ? urlFor(post.coverImage)?.width(1200).auto("format").format("webp").quality(80).url() : null;
const coverAlt = post?.coverImage?.alt || "";
const pubDate = post?.publishedAt ? new Date(post.publishedAt).toLocaleDateString("fr-FR", { year: "numeric", month: "long", day: "numeric" }) : "";
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const enc = encodeURIComponent;
const share = {
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(pageUrl)}`,
  x: `https://twitter.com/intent/tweet?url=${enc(pageUrl)}&text=${enc(post?.title ?? "")}`,
  whatsapp: `https://wa.me/?text=${enc(`${post?.title ?? ""} ${pageUrl}`)}`,
  email: `mailto:?subject=${enc(post?.title ?? "")}&body=${enc(pageUrl)}`,
};
---

<Layout title={`${post?.title ?? "Article"} — Notes de terrain · Dr I. B. Ahogni, PhD`} description={post?.excerpt} image={cover ?? "/Dr-Idelphone-AHOGNI.jpeg"}>
  <Header />
  <main>
    <article class="sec post-sec" id="post">
      <div class="post-head">
        <div class="wrap post-wrap">
          <a class="back" href="/blog">← Toutes les notes</a>
          <p class="sec-eyebrow">{pubDate}{post?.tags?.length > 0 ? ` · ${post.tags.join(" · ")}` : ""}</p>
          <h1 class="post-title lm"><span class="ln"><span>{post?.title}</span></span></h1>
          {post?.excerpt && <p class="post-excerpt">{post.excerpt}</p>}
        </div>
      </div>

      <div class="post-content">
        <div class="wrap post-wrap">
          {cover && <figure class="post-cover"><img src={cover} alt={coverAlt} loading="lazy" decoding="async"></figure>}
          {post?.body ? <div class="post-body"><PortableText value={post.body} /></div> : <p>Contenu à venir.</p>}
          <div class="post-foot">
            <a class="btn" href="/">← Retour au site</a>
            <a class="btn ghost" href="/blog">Autres notes</a>
          </div>
          <div class="post-share">
            <span class="share-label">Partager :</span>
            <a href={share.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Partager sur LinkedIn">LinkedIn</a>
            <a href={share.x} target="_blank" rel="noopener noreferrer" aria-label="Partager sur X">X</a>
            <a href={share.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Partager sur WhatsApp">WhatsApp</a>
            <a href={share.email} aria-label="Partager par e-mail">E-mail</a>
          </div>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post?.title,
  "description": post?.excerpt,
  "datePublished": post?.publishedAt,
  "image": cover,
  "url": pageUrl,
  "inLanguage": "fr",
  "author": { "@type": "Person", "name": "Dr Idelphonse B. Ahogni", "url": "https://idelphonseahogni.com" },
  "publisher": { "@type": "Person", "name": "Dr Idelphonse B. Ahogni" }
})} />

<style>
  .post-sec { padding: 0; }
  .post-head {
    background: var(--ink3); color: var(--paper);
    padding: 160px 5vw 60px;
  }
  .post-head .sec-eyebrow { color: var(--amber2); }
  .post-head .sec-eyebrow::before { background: var(--amber2); }
  .post-head .back { color: var(--amber2); }
  .post-head .back:hover { color: var(--paper); }
  .post-head .post-title { color: var(--paper); }
  .post-head .post-excerpt { color: rgba(244,239,227,.72); }
  .post-content {
    background: var(--paper); color: var(--ink);
    padding: 60px 5vw;
  }
  .post-wrap { max-width: 780px; }
  .back { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--teal); text-decoration: none; display: inline-block; margin-bottom: 26px; }
  .back:hover { color: var(--coral); }
  .post-title { font-family: var(--display); font-weight: 600; font-size: clamp(2rem, 4.6vw, 3.4rem); line-height: 1.08; letter-spacing: -.01em; }
  .post-excerpt { font-family: var(--display); font-style: italic; font-size: 1.15rem; color: rgb(var(--rgb-ink) / .7); margin: 18px 0 24px; }
  .post-cover { margin: 0 0 28px; border: 1px solid var(--line); }
  .post-cover img { width: 100%; aspect-ratio: 16/9; object-fit: cover; }
  .post-body { font-size: 1.05rem; line-height: 1.8; color: rgb(var(--rgb-ink) / .88); }
  .post-body :global(p) { margin-bottom: 20px; }
  .post-body :global(h2) { font-family: var(--display); font-size: 1.5rem; margin: 30px 0 12px; }
  .post-body :global(h3) { font-family: var(--display); font-size: 1.2rem; margin: 24px 0 10px; }
  .post-body :global(ul), .post-body :global(ol) { margin: 0 0 20px 24px; }
  .post-body :global(li) { margin-bottom: 6px; }
  .post-body :global(blockquote) { border-left: 3px solid var(--amber); padding-left: 18px; font-style: italic; color: var(--ink2); margin: 20px 0; }
  .post-body :global(a) { color: var(--coral); }
  .post-body :global(img) { max-width: 100%; border: 1px solid var(--line); margin: 12px 0; }
  .post-foot { display: flex; gap: 16px; margin-top: 44px; flex-wrap: wrap; }
  .post-share { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line); }
  .post-share .share-label { font-family: var(--mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: rgb(var(--rgb-ink) / .6); }
  .post-share a { font-family: var(--mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); text-decoration: none; border: 1px solid var(--line); padding: 7px 14px; transition: background .25s, color .25s, border-color .25s; }
  .post-share a:hover { background: var(--amber); color: var(--ink3); border-color: var(--amber); }
  html[data-theme="dark"] .post-share a { color: var(--paper); border-color: var(--linelt); }
  html[data-theme="dark"] .post-share a:hover { color: var(--ink3); }
</style>