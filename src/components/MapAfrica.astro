---
const countries: { name: string; city: string; lat: number; lng: number }[] = [
  { name: "Bénin", city: "Cotonou", lat: 6.37, lng: 2.43 },
  { name: "Côte d'Ivoire", city: "Abidjan", lat: 5.35, lng: -4.02 },
  { name: "Guinée", city: "Conakry", lat: 9.64, lng: -13.58 },
  { name: "Nigéria", city: "Abuja", lat: 9.06, lng: 7.49 },
  { name: "Cameroun", city: "Yaoundé", lat: 3.85, lng: 11.5 },
  { name: "Kenya", city: "Nairobi", lat: -1.29, lng: 36.82 },
  { name: "Tanzanie", city: "Dodoma", lat: -6.16, lng: 35.75 },
  { name: "Ouganda", city: "Kampala", lat: 0.35, lng: 32.58 },
  { name: "Mozambique", city: "Maputo", lat: -25.97, lng: 32.57 },
];
---

<section class="sec" id="pays">
  <div class="wrap">
    <div class="sec-head">
      <p class="sec-eyebrow">09 — Pays d'intervention</p>
      <h2 class="title lm"><span class="ln"><span>Neuf pays, une</span></span><span class="ln"><span>mission : <span class="it">zéro paludisme</span></span></span></h2>
      <p class="map-intro">Huit ans d'essais et de programmes multi-pays d'Afrique de l'Ouest, centrale, orientale et australe. Cliquez sur un marqueur pour afficher le pays et le contenu associé.</p>
    </div>
    <div class="map-wrap">
      <div id="africaMap" class="map" role="application" aria-label="Carte interactive des pays d'intervention" data-countries={JSON.stringify(countries)}></div>
      <ul class="map-legend" aria-hidden="true">
        {countries.map((c) => <li><span class="dot" aria-hidden="true"></span>{c.name} — {c.city}</li>)}
      </ul>
    </div>
  </div>
</section>

<script>
  const el = document.getElementById("africaMap");
  if (el) {
    async function init() {
      const [{ default: L }] = await Promise.all([
        import("leaflet/dist/leaflet.js"),
        new Promise<void>((resolve) => {
          if (!document.querySelector('link[href*="leaflet"]')) {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
            link.onload = () => resolve();
            document.head.appendChild(link);
          } else { resolve(); }
        }),
      ]);
      const countries = JSON.parse(el.getAttribute("data-countries") || "[]") as {
        name: string; city: string; lat: number; lng: number;
      }[];

      const root = document.documentElement;
      const dark = () => root.getAttribute("data-theme") === "dark";

      const layer = L.tileLayer(
        dark()
          ? "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
          : "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
          attribution: dark()
            ? '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>'
            : '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          maxZoom: 18,
        }
      );

      const map = L.map(el, { scrollWheelZoom: false }).setView([6, 18], 3);
      layer.addTo(map);

      const markers = countries.map((c) => {
        const m = L.circleMarker([c.lat, c.lng], {
          radius: 9,
          weight: 2,
          color: dark() ? "#F4EFE3" : "#0D221C",
          fillColor: "#C4503B",
          fillOpacity: 0.92,
        });
        m.bindPopup(
          `<div class="map-pop"><span class="map-pop-tag">Pays d'intervention</span>` +
          `<strong>${c.name}</strong><span class="map-pop-city">${c.city}</span>` +
          `<span class="map-pop-links">` +
          `<a href="/publications">Publications</a>` +
          `<a href="/blog">Blog</a>` +
          `<a href="/cv">CV</a>` +
          `<a href="/contact">Me contacter</a>` +
          `</span></div>`,
          { maxWidth: 240 }
        );
        return m.addTo(map);
      });

      // synchronise tuiles + marqueurs avec le thème
      const observer = new MutationObserver(() => {
        const isDark = dark();
        layer.setUrl(
          isDark
            ? "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
            : "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
        );
        markers.forEach((m) => m.setStyle({ color: isDark ? "#F4EFE3" : "#0D221C" }));
      });
      observer.observe(root, { attributes: true, attributeFilter: ["data-theme"] });
    }

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            init();
          }
        },
        { rootMargin: "600px" }
      );
      io.observe(el);
    } else {
      init();
    }
  }
</script>

<style>
  .map-intro { max-width: 60ch; color: rgb(var(--rgb-ink) / .75); margin-top: 20px; font-size: 1.05rem; line-height: 1.7; }
  .map-wrap { display: grid; grid-template-columns: 1fr 260px; gap: 26px; align-items: start; }
  .map { height: 440px; border: 1px solid var(--line); filter: saturate(.85); z-index: 0; }
  .map-legend { list-style: none; border-top: 1px solid var(--line); }
  .map-legend li { display: flex; align-items: center; gap: 12px; padding: 12px 6px; border-bottom: 1px solid var(--line); font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: rgb(var(--rgb-ink) / .75); }
  .map-legend .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--coral); border: 2px solid var(--ink); flex: none; }
  @media (max-width: 900px) { .map-wrap { grid-template-columns: 1fr; } .map { height: 320px; } }
</style>
