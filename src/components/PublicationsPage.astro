---
import { sanityClient } from "sanity:client";
import { CONTENT_QUERY, SETTINGS_QUERY, cachedFetch } from "../lib/queries";

const content = await cachedFetch(sanityClient, CONTENT_QUERY);
const settings = await cachedFetch(sanityClient, SETTINGS_QUERY);
const rg = settings?.researchGate && settings?.researchGate !== "#" ? settings.researchGate : null;
const gs = settings?.googleScholar && settings?.googleScholar !== "#" ? settings.googleScholar : null;
const pubs = content?.publications ?? [];

const years = [...new Set(pubs.map((p: any) => p.year))].sort((a: number, b: number) => b - a);
---

<section class="sec" id="publications-page">
  <div class="wrap">
    <div class="sec-head">
      <p class="sec-eyebrow">05 — Publications</p>
      <h2 class="title lm">
        <span class="ln"><span>Toutes les publications,</span></span>
        <span class="ln"><span><span class="it">évaluées par les pairs</span></span></span>
      </h2>
      <p class="pub-intro rv">
        Plus de 25 publications dans les revues internationales les plus prestigieuses du domaine —
        Malaria Journal, Parasites & Vectors, Acta Tropica, PLOS ONE, et autres.
        Liste complète organisée par année, avec filtres et recherche.
      </p>
    </div>

    <div class="pub-filters rv">
      <div class="pf-left">
        <button class="pf-btn active" data-filter="all">Toutes ({pubs.length})</button>
        {years.map((y: number) => (
          <button class="pf-btn" data-filter={y}>{y} ({pubs.filter((p: any) => p.year === y).length})</button>
        ))}
      </div>
      <div class="pf-search">
        <input type="text" id="pubSearch" placeholder="Rechercher une publication..." />
      </div>
    </div>

    <div class="pub-full-list" id="pubList">
      {pubs.map((pub: any) => (
        <article class="pub-full rv" data-year={pub.year} data-type={pub.type || "article"}>
          <div class="pub-num">{String(pub.index).padStart(2, "0")}</div>
          <div class="pub-body">
            <div class="pub-head">
              <span class="pub-year">{pub.year}</span>
              {pub.type && <span class="pub-type">{pub.type}</span>}
            </div>
            <h3 class="pub-title">
              {pub.url
                ? <a href={pub.url} target="_blank" rel="noopener noreferrer">{pub.title}</a>
                : pub.title
              }
            </h3>
            <p class="pub-authors">{pub.authors}</p>
            <p class="pub-journal">
              <em>{pub.journal}</em>
              {pub.doi && (
                <>
                  {" · "}
                  <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer" class="pub-doi">
                    doi:{pub.doi}
                  </a>
                </>
              )}
            </p>
          </div>
          <div class="pub-arrow">
            {pub.url
              ? <a href={pub.url} target="_blank" rel="noopener noreferrer" aria-label="Ouvrir la publication">↗</a>
              : pub.doi ? <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer" aria-label="Ouvrir le DOI">↗</a> : null
            }
          </div>
        </article>
      ))}
    </div>

    <div class="pub-empty" id="pubEmpty" style="display:none;">
      <p>Aucune publication ne correspond à votre recherche.</p>
    </div>

    <div class="pub-cta rv">
      <p>
        Liste complète disponible sur
        {rg
          ? <a href={rg} target="_blank" rel="noopener noreferrer">ResearchGate ↗</a>
          : <span>ResearchGate</span>}
        {rg && " et "}
        {gs
          ? <a href={gs} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a>
          : <span>Google Scholar</span>}
      </p>
      <a class="btn" href="/">← Retour au site</a>
    </div>
  </div>
</section>

<style>
  .pub-intro {
    max-width: 64ch;
    color: rgba(13,34,28,.75);
    margin-top: 20px;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .pub-filters {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }
  .pf-left {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pf-btn {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    padding: 8px 14px;
    cursor: pointer;
    transition: all .25s;
  }
  .pf-btn:hover {
    border-color: var(--ink);
    background: rgba(13,34,28,.05);
  }
  .pf-btn.active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .pf-search input {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: .06em;
    border: 1px solid var(--line);
    background: rgba(255,255,255,.55);
    padding: 10px 16px;
    width: 280px;
    color: var(--ink);
    transition: border-color .3s, box-shadow .3s;
  }
  .pf-search input:focus {
    outline: none;
    border-color: var(--amber);
    box-shadow: 0 0 0 3px rgba(217,151,43,.25);
  }
  .pub-full-list {
    border-top: 1px solid var(--line);
  }
  .pub-full {
    display: grid;
    grid-template-columns: 60px 1fr 40px;
    gap: 24px;
    align-items: start;
    padding: 28px 10px;
    border-bottom: 1px solid var(--line);
    transition: background .3s, padding-left .3s;
  }
  .pub-full:hover {
    background: rgba(217,151,43,.07);
    padding-left: 20px;
  }
  .pub-num {
    font-family: var(--display);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--coral);
    line-height: 1;
  }
  .pub-head {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 8px;
  }
  .pub-year {
    font-family: var(--display);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--teal);
  }
  .pub-type {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: .14em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    padding: 3px 8px;
    color: var(--coral);
  }
  .pub-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.4;
    margin-bottom: 6px;
  }
  .pub-title a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color .25s, color .25s;
  }
  .pub-title a:hover {
    border-bottom-color: var(--amber);
    color: var(--teal);
  }
  .pub-authors {
    font-size: .9rem;
    color: rgba(13,34,28,.75);
    margin-bottom: 4px;
  }
  .pub-journal {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: rgba(13,34,28,.6);
  }
  .pub-journal em {
    color: var(--teal);
    font-style: normal;
  }
  .pub-doi {
    color: var(--coral);
    text-decoration: none;
    border-bottom: 1px solid var(--coral);
    transition: background .25s, color .25s;
  }
  .pub-doi:hover {
    background: var(--coral);
    color: var(--paper);
  }
  .pub-arrow {
    text-align: center;
    padding-top: 4px;
  }
  .pub-arrow a {
    font-family: var(--display);
    font-size: 1.4rem;
    color: var(--amber);
    text-decoration: none;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity .3s, transform .3s;
  }
  .pub-full:hover .pub-arrow a {
    opacity: 1;
    transform: none;
  }
  .pub-empty {
    text-align: center;
    padding: 60px 20px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: .1em;
    color: rgba(13,34,28,.5);
    border: 1px dashed var(--line);
    margin-top: 20px;
  }
  .pub-cta {
    margin-top: 50px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .pub-cta p {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: .1em;
    color: rgba(13,34,28,.7);
  }
  .pub-cta a {
    color: var(--coral);
    text-decoration: none;
    border-bottom: 1px solid var(--coral);
    transition: background .25s, color .25s;
  }
  .pub-cta a:hover {
    background: var(--coral);
    color: var(--paper);
  }
  @media (max-width: 900px) {
    .pub-filters {
      flex-direction: column;
      align-items: flex-start;
    }
    .pf-search input {
      width: 100%;
    }
  }
  @media (max-width: 640px) {
    .pub-full {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .pub-num {
      font-size: 1.2rem;
    }
    .pub-arrow {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btns = document.querySelectorAll<HTMLElement>(".pf-btn");
    const items = document.querySelectorAll<HTMLElement>(".pub-full");
    const search = document.getElementById("pubSearch") as HTMLInputElement;
    const empty = document.getElementById("pubEmpty");

    let activeFilter = "all";

    function applyFilters() {
      const q = (search?.value || "").toLowerCase().trim();
      let visible = 0;
      items.forEach(el => {
        const year = el.dataset.year;
        const text = el.textContent?.toLowerCase() || "";
        const matchFilter = activeFilter === "all" || year === activeFilter;
        const matchSearch = !q || text.includes(q);
        const show = matchFilter && matchSearch;
        el.style.display = show ? "" : "none";
        if (show) visible++;
      });
      if (empty) empty.style.display = visible === 0 ? "" : "none";
    }

    btns.forEach(btn => {
      btn.addEventListener("click", () => {
        btns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeFilter = btn.dataset.filter || "all";
        applyFilters();
      });
    });

    search?.addEventListener("input", applyFilters);
  });
</script>
