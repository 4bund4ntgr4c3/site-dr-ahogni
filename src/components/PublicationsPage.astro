---
import { sanityClient } from "sanity:client";
import { CONTENT_QUERY, SETTINGS_QUERY, cachedFetch } from "../lib/queries";

const content = await cachedFetch(sanityClient, CONTENT_QUERY);
const settings = await cachedFetch(sanityClient, SETTINGS_QUERY);
const rg = settings?.researchGate && settings?.researchGate !== "#" ? settings.researchGate : null;
const gs = settings?.googleScholar && settings?.googleScholar !== "#" ? settings.googleScholar : null;
const pubs = content?.publications ?? [];

const years = [...new Set(pubs.map((p: any) => p.year).filter(Boolean))].sort((a: number, b: number) => b - a);
const types = [...new Set(pubs.map((p: any) => p.type).filter(Boolean))].sort();
---

<section class="sec pub-sec" id="publications-page">
  <div class="pub-page-head">
    <div class="wrap">
      <p class="sec-eyebrow" data-i18n="pubs.eyebrow">05 — Publications</p>
      <h1 class="title lm" data-i18n-html="pubs.title">
        <span class="ln"><span>Toutes les publications,</span></span>
        <span class="ln"><span><span class="it">évaluées par les pairs</span></span></span>
      </h1>
      <p class="pub-intro rv" data-i18n="pubs.intro">
        Plus de 25 publications dans les revues internationales les plus prestigieuses du domaine —
        Malaria Journal, Parasites &amp; Vectors, Acta Tropica, PLOS ONE, et autres.
        Liste complète organisée par année, avec filtres, recherche et outils de citation.
      </p>
      <div class="pub-global-exports rv">
        <a class="exp-btn" href="/publications/publications.bib" download="ahogni-publications.bib" title="Télécharger toutes les publications au format BibTeX">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Exporter tout (.bib)
        </a>
        <button type="button" class="exp-btn" id="exportRisBtn" title="Télécharger pour Zotero, Mendeley, EndNote (.ris)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Exporter tout (.ris)
        </button>
      </div>
    </div>
  </div>

  <div class="pub-content">
    <div class="wrap">
      <div class="pub-filters rv">
        <div class="pf-left">
          <button class="pf-btn active" data-filter="all">Toutes ({pubs.length})</button>
          {years.map((y: number) => (
            <button class="pf-btn" data-filter={y}>{y} ({pubs.filter((p: any) => p.year === y).length})</button>
          ))}
        </div>
        {types.length > 0 && (
          <div class="pf-left">
            {types.map((t: string) => (
              <button class="pf-btn pf-type" data-filter-type={t}>{t} ({pubs.filter((p: any) => p.type === t).length})</button>
            ))}
          </div>
        )}
        <div class="pf-search">
          <input type="text" id="pubSearch" placeholder="Rechercher par titre, auteur, revue, année..." />
        </div>
      </div>

      <div class="pub-full-list" id="pubList">
        {pubs.map((pub: any) => (
          <article class="pub-full rv" data-year={pub.year} data-type={pub.type || "article"}>
            <div class="pub-num">{String(pub.index).padStart(2, "0")}</div>
            <div class="pub-body">
              <div class="pub-meta">
                <span class="pub-year">{pub.year}</span>
                {pub.type && <span class="pub-type">{pub.type}</span>}
              </div>
              <h3 class="pub-title">
                {pub.url
                  ? <a href={pub.url} target="_blank" rel="noopener noreferrer">{pub.title}</a>
                  : pub.title
                }
              </h3>
              <p class="pub-authors">{pub.authors}</p>
              <p class="pub-journal">
                <em>{pub.journal}</em>
                {pub.doi && (
                  <>
                    {" · "}
                    <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer" class="pub-doi">
                      doi:{pub.doi}
                    </a>
                  </>
                )}
              </p>
              <div class="pub-actions">
                {pub.url && (
                  <button
                    class="pub-btn pub-preview-btn"
                    type="button"
                    data-preview-url={pub.url}
                    data-preview-title={pub.title}
                  >
                    Consulter PDF 👁
                  </button>
                )}
                <button
                  class="pub-btn cite-trigger"
                  type="button"
                  data-pub-item={JSON.stringify({
                    title: pub.title,
                    authors: pub.authors,
                    journal: pub.journal,
                    year: pub.year,
                    doi: pub.doi || null,
                    url: pub.url || null,
                    type: pub.type || "article"
                  })}
                >
                  Citer / Citation ▾
                </button>
              </div>
            </div>
            <div class="pub-arrow">
              {pub.url
                ? <a href={pub.url} target="_blank" rel="noopener noreferrer" aria-label="Ouvrir la publication">↗</a>
                : pub.doi ? <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer" aria-label="Ouvrir le DOI">↗</a> : null
              }
            </div>
          </article>
        ))}
      </div>

      <div class="pub-pagination" id="pubPagination">
        <button class="pg-btn" data-pg="prev" disabled>← Préc</button>
        <span class="pg-info" id="pgInfo">1 / 1</span>
        <button class="pg-btn" data-pg="next" disabled>Suiv →</button>
      </div>

      <div class="pub-empty" id="pubEmpty" style="display:none;">
        <p>Aucune publication ne correspond à votre recherche.</p>
      </div>

      <div class="pub-cta rv">
        <p>
          Profils scientifiques complets :
          {rg
            ? <a href={rg} target="_blank" rel="noopener noreferrer">ResearchGate ↗</a>
            : <span>ResearchGate</span>}
          {rg && gs && " · "}
          {gs
            ? <a href={gs} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a>
            : <span>Google Scholar</span>}
        </p>
        <a class="btn" href="/">← Retour au site</a>
      </div>
    </div>
  </div>

  <!-- Modal Citation -->
  <div id="citeModal" class="cite-modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Formater et copier la citation">
    <div class="cite-card">
      <div class="cite-head">
        <h3 id="citeModalTitle">Citer cette publication</h3>
        <button type="button" class="cite-close" id="citeCloseBtn" aria-label="Fermer la boîte de dialogue">✕</button>
      </div>
      <div class="cite-tabs">
        <button type="button" class="cite-tab-btn active" data-tab="apa">APA 7th</button>
        <button type="button" class="cite-tab-btn" data-tab="vancouver">Vancouver</button>
        <button type="button" class="cite-tab-btn" data-tab="bibtex">BibTeX</button>
      </div>
      <div class="cite-box">
        <pre id="citeText" class="cite-code"></pre>
      </div>
      <div class="cite-foot">
        <button type="button" class="btn amber" id="citeCopyBtn">Copier la citation</button>
        <span class="cite-status" id="citeStatus"></span>
      </div>
    </div>
  </div>
</section>

<!-- Données JSON des publications pour l'export client RIS -->
<script type="application/json" id="all-pubs-data" set:html={JSON.stringify(pubs).replace(/</g, "\\u003c")}></script>

<style>
  .pub-sec { padding: 0; }
  .pub-page-head {
    background: #0B0F17;
    color: #F8FAFC;
    padding: 160px 5vw 60px;
  }
  .pub-page-head .sec-eyebrow { color: var(--amber2); font-weight: 700; }
  .pub-page-head .sec-eyebrow::before { background: var(--amber2); }
  .pub-page-head h1 { color: #FFFFFF; }
  .pub-page-head .it { color: var(--amber2); }
  .pub-intro {
    color: #CBD5E1;
    max-width: 64ch;
    margin-top: 20px;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .pub-global-exports {
    display: flex;
    gap: 12px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .exp-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #F8FAFC;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,0.18);
    padding: 8px 16px;
    text-decoration: none;
    cursor: pointer;
    transition: all .25s ease;
  }
  .exp-btn svg { width: 14px; height: 14px; }
  .exp-btn:hover {
    background: var(--amber2);
    color: #0B0F17;
    border-color: var(--amber2);
  }

  .pub-content {
    background: var(--paper);
    color: var(--ink);
    padding: 60px 5vw;
  }

  .pub-filters {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }
  .pf-left { display: flex; gap: 8px; flex-wrap: wrap; }
  .pf-btn {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    padding: 8px 14px;
    cursor: pointer;
    transition: all 0.25s;
  }
  .pf-btn:hover { border-color: var(--ink); background: rgb(var(--rgb-ink) / .05); }
  .pf-btn.active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .pf-type { border-style: dashed; }
  .pf-type.active { border-style: solid; }

  .pf-search input {
    font-family: var(--mono);
    font-size: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    padding: 9px 16px;
    width: 260px;
    outline: none;
    transition: border-color 0.25s, width 0.3s;
  }
  .pf-search input:focus {
    border-color: var(--ink);
    width: 320px;
  }

  .pub-full-list { border-top: 1px solid var(--line); }
  .pub-full {
    display: grid;
    grid-template-columns: 44px 1fr 36px;
    gap: 20px;
    align-items: start;
    padding: 26px 10px;
    border-bottom: 1px solid var(--line);
    transition: background 0.3s, padding-left 0.3s;
  }
  .pub-full:hover {
    background: rgb(var(--rgb-amber) / .07);
    padding-left: 18px;
  }

  .pub-num {
    font-family: var(--display);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--coral);
    line-height: 1;
    padding-top: 4px;
  }
  .pub-meta {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 6px;
  }
  .pub-year {
    font-family: var(--display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--teal);
  }
  .pub-type {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    padding: 2px 7px;
    color: var(--coral);
  }
  .pub-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.12rem;
    line-height: 1.4;
    margin-bottom: 6px;
  }
  .pub-title a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s, color 0.25s;
  }
  .pub-title a:hover {
    border-bottom-color: var(--amber);
    color: var(--teal);
  }

  .pub-authors {
    font-size: 0.95rem;
    color: rgb(var(--rgb-ink) / .82);
    margin-bottom: 4px;
    line-height: 1.5;
  }
  .pub-journal {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: rgb(var(--rgb-ink) / .7);
  }
  .pub-journal em { color: var(--teal); font-style: normal; }
  .pub-doi {
    color: var(--coral); text-decoration: none;
    border-bottom: 1px solid var(--coral); transition: background .25s, color .25s;
  }
  .pub-doi:hover { background: var(--coral); color: var(--paper); }

  .pub-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
  .pub-btn {
    font-family: var(--mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase;
    border: 1px solid var(--line); background: transparent; color: var(--ink);
    padding: 5px 12px; cursor: pointer; text-decoration: none; transition: all .25s;
  }
  .pub-btn:hover { border-color: var(--teal); color: var(--teal); background: rgb(var(--rgb-teal) / .06); }

  .pub-arrow { text-align: center; padding-top: 4px; }
  .pub-arrow a {
    font-family: var(--display); font-size: 1.4rem; color: var(--amber);
    text-decoration: none; opacity: 0; transform: translateX(-8px);
    transition: opacity .3s, transform .3s;
  }
  .pub-full:hover .pub-arrow a { opacity: 1; transform: none; }

  .pub-empty {
    text-align: center; padding: 60px 20px;
    font-family: var(--mono); font-size: 12px; letter-spacing: .1em;
    color: rgb(var(--rgb-ink) / .5); border: 1px dashed var(--line); margin-top: 20px;
  }

  .pub-cta {
    margin-top: 50px; display: flex; justify-content: space-between; align-items: center;
    gap: 20px; flex-wrap: wrap; padding-top: 30px; border-top: 1px solid var(--line);
  }
  .pub-cta p { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; color: rgb(var(--rgb-ink) / .7); }
  .pub-cta a { color: var(--coral); text-decoration: none; border-bottom: 1px solid var(--coral); transition: background .25s, color .25s; }
  .pub-cta a:hover { background: var(--coral); color: var(--paper); }

  /* ── Modal Citation ── */
  .cite-modal-overlay {
    position: fixed; inset: 0; z-index: 2000;
    background: rgba(10, 26, 21, 0.75);
    backdrop-filter: blur(8px);
    display: none; align-items: center; justify-content: center;
    padding: 20px;
  }
  .cite-modal-overlay.open { display: flex; }
  .cite-card {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--ink);
    width: 100%; max-width: 620px;
    padding: 28px;
    box-shadow: 0 20px 50px rgba(0,0,0,.4);
    position: relative;
  }
  /* ── Dark Mode Publications Styles ── */
  html[data-theme="dark"] .pub-content { background: var(--surface); color: var(--ink); }
  html[data-theme="dark"] .pf-btn {
    color: var(--ink);
    border-color: var(--line);
  }
  html[data-theme="dark"] .pf-btn:hover {
    background: var(--paper2);
    border-color: var(--amber);
  }
  html[data-theme="dark"] .pf-btn.active {
    background: var(--amber);
    color: #060B09;
    border-color: var(--amber);
    font-weight: 700;
  }
  html[data-theme="dark"] .pf-search input {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--line);
  }
  html[data-theme="dark"] .pf-search input:focus {
    border-color: var(--amber);
    box-shadow: 0 0 0 3px rgba(245,158,11,.25);
  }
  html[data-theme="dark"] .pub-full:hover {
    background: rgba(245, 158, 11, 0.12);
  }
  html[data-theme="dark"] .cite-card {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--line);
    box-shadow: 0 20px 50px rgba(0,0,0,.6);
  }
  html[data-theme="dark"] .cite-box {
    background: var(--paper2);
    color: var(--ink);
    border-color: var(--line);
  }
  html[data-theme="dark"] .cite-tab-btn.active {
    background: var(--amber);
    color: #060B09;
    border-color: var(--amber);
  }

  .cite-head {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 16px; margin-bottom: 16px;
  }
  .cite-head h3 {
    font-family: var(--display); font-size: 1.25rem; font-weight: 600;
  }
  .cite-close {
    background: transparent; border: none; font-size: 18px;
    cursor: pointer; color: inherit; opacity: .7; transition: opacity .2s;
  }
  .cite-close:hover { opacity: 1; }

  .cite-tabs { display: flex; gap: 8px; margin-bottom: 14px; border-bottom: 1px solid var(--line); padding-bottom: 8px; }
  .cite-tab-btn {
    font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
    background: transparent; border: 1px solid transparent; color: inherit;
    padding: 6px 12px; cursor: pointer; transition: all .2s;
  }
  .cite-tab-btn:hover { border-color: var(--line); }
  .cite-tab-btn.active { background: var(--amber); color: var(--ink3); border-color: var(--amber); font-weight: 700; }

  .cite-box {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 16px;
    margin-bottom: 20px;
    max-height: 220px;
    overflow-y: auto;
  }
  .cite-code {
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .cite-foot { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
  .cite-status { font-family: var(--mono); font-size: 11px; color: var(--teal); letter-spacing: .08em; }

  @media (max-width: 900px) {
    .pub-filters { flex-direction: column; align-items: flex-start; }
    .pf-search input { width: 100%; }
  }
  @media (max-width: 640px) {
    .pub-full { grid-template-columns: 1fr; gap: 10px; }
    .pub-num { font-size: 1.2rem; }
    .pub-arrow { display: none; }
  }

  .pub-pagination { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 30px; padding: 20px 0; border-top: 1px solid var(--line); }
  .pg-btn { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; border: 1px solid var(--line); background: transparent; color: var(--ink); padding: 8px 16px; cursor: pointer; transition: all .25s; }
  .pg-btn:hover:not(:disabled) { border-color: var(--ink); background: rgb(var(--rgb-ink) / .05); }
  .pg-btn:disabled { opacity: .35; cursor: not-allowed; }
  .pg-info { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; color: rgb(var(--rgb-ink) / .6); }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btns = document.querySelectorAll<HTMLElement>(".pf-btn:not(.pf-type)");
    const typeBtns = document.querySelectorAll<HTMLElement>(".pf-btn.pf-type");
    const items = document.querySelectorAll<HTMLElement>(".pub-full");
    const search = document.getElementById("pubSearch") as HTMLInputElement;
    const empty = document.getElementById("pubEmpty");
    const pgInfo = document.getElementById("pgInfo");
    const prevBtn = document.querySelector<HTMLElement>("[data-pg='prev']");
    const nextBtn = document.querySelector<HTMLElement>("[data-pg='next']");

    let activeYear = "all";
    let activeType = "all";
    let currentPage = 1;
    const PER_PAGE = 10;

    function getVisibleItems(): HTMLElement[] {
      const q = (search?.value || "").toLowerCase().trim();
      return Array.from(items).filter(el => {
        const year = el.dataset.year;
        const type = el.dataset.type;
        const text = el.textContent?.toLowerCase() || "";
        return (activeYear === "all" || year === activeYear) && (activeType === "all" || type === activeType) && (!q || text.includes(q));
      });
    }

    function applyFilters() {
      currentPage = 1;
      render();
    }

    function render() {
      const visible = getVisibleItems();
      const totalPages = Math.max(1, Math.ceil(visible.length / PER_PAGE));
      if (currentPage > totalPages) currentPage = totalPages;
      const start = (currentPage - 1) * PER_PAGE;
      const end = start + PER_PAGE;

      items.forEach(el => el.style.display = "none");
      visible.forEach((el, i) => { el.style.display = (i >= start && i < end) ? "" : "none"; });

      if (empty) empty.style.display = visible.length === 0 ? "" : "none";
      if (pgInfo) pgInfo.textContent = `${currentPage} / ${totalPages}`;
      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
    }

    btns.forEach(btn => {
      btn.addEventListener("click", () => {
        btns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeYear = btn.dataset.filter || "all";
        applyFilters();
      });
    });

    typeBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const wasActive = btn.classList.contains("active");
        typeBtns.forEach(b => b.classList.remove("active"));
        if (!wasActive) {
          btn.classList.add("active");
          activeType = btn.dataset.filterType || "all";
        } else {
          activeType = "all";
        }
        applyFilters();
      });
    });

    prevBtn?.addEventListener("click", () => { currentPage--; render(); });
    nextBtn?.addEventListener("click", () => { currentPage++; render(); });

    search?.addEventListener("input", applyFilters);

    render();

    // ── Export RIS ──
    const exportRisBtn = document.getElementById("exportRisBtn");
    exportRisBtn?.addEventListener("click", () => {
      const rawPubs = JSON.parse(document.getElementById("all-pubs-data")?.textContent || "[]");
      const risContent = rawPubs.map((p: any) => {
        const lines = [
          "TY  - JOUR",
          `TI  - ${p.title || ""}`,
          `AU  - ${p.authors || "Ahogni, I. B."}`,
          `JO  - ${p.journal || ""}`,
          `PY  - ${p.year || ""}`,
        ];
        if (p.doi) lines.push(`DO  - ${p.doi}`);
        if (p.url) lines.push(`UR  - ${p.url}`);
        lines.push("ER  - ");
        return lines.join("\r\n");
      }).join("\r\n\r\n");

      const blob = new Blob([risContent], { type: "application/x-research-info-systems;charset=utf-8" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = "dr-ahogni-publications.ris";
      link.click();
      URL.revokeObjectURL(link.href);
    });

    // ── Formattage des Citations (Modal) ──
    const modal = document.getElementById("citeModal") as HTMLElement;
    const modalTitle = document.getElementById("citeModalTitle") as HTMLElement;
    const citeText = document.getElementById("citeText") as HTMLElement;
    const closeBtn = document.getElementById("citeCloseBtn");
    const copyBtn = document.getElementById("citeCopyBtn");
    const statusEl = document.getElementById("citeStatus") as HTMLElement;
    const tabBtns = document.querySelectorAll<HTMLElement>(".cite-tab-btn");

    let currentPub: any = null;
    let currentTab = "apa";

    function getFormattedCitation(pub: any, format: string): string {
      if (!pub) return "";
      const { authors, title, journal, year, doi, url, type } = pub;
      if (format === "apa") {
        let citation = `${authors} (${year}). ${title}. ${journal}.`;
        if (doi) citation += ` https://doi.org/${doi}`;
        else if (url) citation += ` ${url}`;
        return citation;
      }
      if (format === "vancouver") {
        let citation = `${authors}. ${title}. ${journal}. ${year};`;
        if (doi) citation += ` doi:${doi}.`;
        return citation;
      }
      if (format === "bibtex") {
        const key = `ahogni${year}${String(title || "").replace(/[^\w]/g, "").slice(0, 8)}`;
        const lines = [
          `@${type === "article" ? "article" : "misc"}{${key},`,
          `  author  = {${authors}},`,
          `  title   = {${title}},`,
          `  journal = {${journal}},`,
          `  year    = {${year}},`,
        ];
        if (doi) lines.push(`  doi     = {${doi}},`);
        if (url) lines.push(`  url     = {${url}},`);
        lines.push(`}`);
        return lines.join("\n");
      }
      return "";
    }

    function updateCitationView() {
      if (!currentPub) return;
      citeText.textContent = getFormattedCitation(currentPub, currentTab);
      tabBtns.forEach(t => t.classList.toggle("active", t.dataset.tab === currentTab));
    }

    // ── Ouverture PDF Modal ──
    document.querySelectorAll<HTMLButtonElement>(".pub-preview-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const url = btn.dataset.previewUrl || "";
        const title = btn.dataset.previewTitle || "";
        window.dispatchEvent(new CustomEvent("open-pdf-viewer", { detail: { url, title } }));
      });
    });

    document.querySelectorAll<HTMLElement>(".cite-trigger").forEach(btn => {
      btn.addEventListener("click", () => {
        try {
          currentPub = JSON.parse(btn.dataset.pubItem || "null");
          modalTitle.textContent = currentPub.title ? `Citer : ${currentPub.title.slice(0, 50)}…` : "Citer cette publication";
          updateCitationView();
          modal.classList.add("open");
          modal.setAttribute("aria-hidden", "false");
          statusEl.textContent = "";
        } catch (e) {}
      });
    });

    tabBtns.forEach(tab => {
      tab.addEventListener("click", () => {
        currentTab = tab.dataset.tab || "apa";
        updateCitationView();
      });
    });

    function closeModal() {
      modal.classList.remove("open");
      modal.setAttribute("aria-hidden", "true");
    }

    closeBtn?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.classList.contains("open")) closeModal();
    });

    copyBtn?.addEventListener("click", () => {
      const text = citeText.textContent || "";
      if (!text) return;
      navigator.clipboard.writeText(text).then(() => {
        statusEl.textContent = "✓ Citation copiée !";
        copyBtn.textContent = "Copié !";
        setTimeout(() => {
          copyBtn.textContent = "Copier la citation";
          statusEl.textContent = "";
        }, 2500);
      });
    });
  });
</script>
