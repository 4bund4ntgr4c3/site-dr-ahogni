  </nav>
  <div class="nav-actions">
    <button id="themeToggle" class="theme-toggle" type="button" aria-pressed="false" title="Changer de thème (clair/sombre)">
      <svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <button id="searchTrigger" class="search-trigger" type="button" aria-haspopup="dialog" aria-controls="searchOverlay" title="Rechercher (Ctrl+K)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <kbd>⌘K</kbd>
    </button>
    <button class="lang-switch" type="button" id="langSwitch" aria-label="Changer de langue (FR/EN)" title="FR / EN">
      <span class="lang-opt" data-lang="fr" data-i18n="lang.fr">FR</span>
      <span class="lang-sep" aria-hidden="true">/</span>
      <span class="lang-opt" data-lang="en" data-i18n="lang.en">EN</span>
    </button>
    <a class="btn" id="ctaBtn" href="/contact" data-i18n="action.contact">Me contacter</a>
    <button id="navToggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="navPanel" aria-label="Ouvrir le menu" title="Menu">
      <span class="nt-bar" aria-hidden="true"></span>
      <span class="nt-bar" aria-hidden="true"></span>
      <span class="nt-bar" aria-hidden="true"></span>
    </button>
  </div>
  <div id="navPanel" class="nav-panel">
    <button id="navClose" class="nav-close" type="button" aria-label="Fermer le menu" title="Fermer">✕</button>
    <p class="np-label" data-i18n="nav.home">Accueil</p>
    <a href="/#apropos" data-i18n="nav.profil">Profil</a>
    <a href="/#impact">Impact &amp; Métriques</a>
    <a href="/#axes-recherche">Radar d'Expertise</a>
    <a href="/#anatomie-vecteur">Anatomie Anophèle</a>
    <a href="/#competences" data-i18n="nav.expertises">Expertises</a>
    <a href="/#entomologie">Entomologie &amp; OMS</a>
    <a href="/#stations-benin">Stations Bénin</a>
    <a href="/#climat-vecteurs">Météo &amp; Risque</a>
    <a href="/#genetique">Génétique &amp; HWE</a>
    <a href="/#moustiquaires">Matrice MILDV</a>
    <a href="/#cout-efficacite">Coût-Efficacité</a>
    <a href="/#timeline-projets">Projets Financés</a>
    <a href="/#capsules-audio">Mini-Capsules Audio</a>
    <a href="/#audit-bpl">Auto-Évaluation BPL</a>
    <a href="/#glossaire">Glossaire Bilingue</a>
    <a href="/#assistant-ia" style="color: var(--teal);">🤖 Assistant IA Virtuel</a>
    <a href="/pres" target="_blank" style="color: var(--amber2);">📽️ Mode Diaporama</a>
    <span class="np-seq" aria-hidden="true"></span>
    <a href="/publications" data-i18n="nav.publications">Publications</a>
    <a href="/blog" data-i18n="nav.blog">Blog</a>
    <a href="/speaking" data-i18n="nav.speaking">Conférences</a>
    <a href="/contact" data-i18n="nav.contact">Contact</a>
    <div class="np-foot">
      <button class="lang-switch" type="button" id="langSwitchPanel" aria-label="Changer de langue (FR/EN)" title="FR / EN">
        <span class="lang-opt" data-lang="fr" data-i18n="lang.fr">FR</span>
        <span class="lang-sep" aria-hidden="true">/</span>
        <span class="lang-opt" data-lang="en" data-i18n="lang.en">EN</span>
      </button>
      <a class="btn" href="/contact" data-i18n="action.contact">Me contacter</a>
    </div>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const drop = document.querySelector(".nav-drop");
    const btn = document.querySelector(".nav-drop-btn");
    const menu = document.querySelector(".nav-drop-menu");
    if (drop && btn && menu) {
      let timer;
      function open() {
        clearTimeout(timer);
        btn.classList.add("open");
        menu.classList.add("open");
        btn.setAttribute("aria-expanded", "true");
      }
      function close() {
        btn.classList.remove("open");
        menu.classList.remove("open");
        btn.setAttribute("aria-expanded", "false");
      }
      function armClose() { timer = window.setTimeout(close, 300); }
      btn.addEventListener("mouseenter", open);
      btn.addEventListener("focus", open);
      menu.addEventListener("mouseenter", () => clearTimeout(timer));
      drop.addEventListener("mouseleave", armClose);
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        btn.classList.contains("open") ? close() : open();
      });
      document.addEventListener("click", (e) => {
        if (e.target instanceof Element && !e.target.closest(".nav-drop")) close();
      });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
      menu.addEventListener("click", (e) => { if (e.target instanceof Element && e.target.closest("a")) close(); });
    }

    // ── menu mobile ──
    const toggle = document.getElementById("navToggle");
    const panel = document.getElementById("navPanel");
    const navClose = document.getElementById("navClose");
    if (toggle && panel) {
      const setOpen = (open) => {
        panel.classList.toggle("open", open);
        toggle.classList.toggle("open", open);
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
        document.body.style.overflow = open ? "hidden" : "";
      };
      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        setOpen(!panel.classList.contains("open"));
      });
      if (navClose) navClose.addEventListener("click", () => setOpen(false));
      panel.addEventListener("click", (e) => {
        if (e.target instanceof Element && e.target.closest("a")) setOpen(false);
      });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });
      window.addEventListener("resize", () => { if (window.innerWidth > 960) setOpen(false); }, { passive: true });
    }
  });
</script>

<style>
  /* burger : masqué sur desktop */
  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;
    width: 38px;
    height: 38px;
    padding: 0;
    cursor: pointer;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--ink);
    transition: background .25s, color .25s, border-color .25s;
  }
  .nav-toggle .nt-bar {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition: transform .3s, opacity .3s;
    border-radius: 1px;
  }
  .nav-toggle:hover { background: var(--amber); color: var(--ink); border-color: var(--ink); }
  .nav-toggle.open .nt-bar:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-toggle.open .nt-bar:nth-child(2) { opacity: 0; }
  .nav-toggle.open .nt-bar:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  body.on-dark-header .nav-toggle { color: var(--paper); border-color: var(--linelt); }
  body.on-dark-header .nav-toggle:hover { background: var(--amber); color: var(--ink); border-color: var(--ink); }

  /* panneau mobile : masqué sur desktop */
  .nav-panel {
    display: none;
  }
  .nav-close {
    display: none;
  }

  @media (max-width: 960px) {
    .nav-close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 76px;
      right: 5vw;
      width: 38px;
      height: 38px;
      padding: 0;
      border: 1px solid var(--line);
      background: var(--surface);
      color: var(--ink);
      font-size: 17px;
      line-height: 1;
      cursor: pointer;
      z-index: 995;
      transition: background .25s, color .25s, border-color .25s, transform .25s;
    }
    .nav-close:hover { background: var(--amber); color: var(--ink3); border-color: var(--amber); transform: translateY(-2px); }
    html[data-theme="dark"] .nav-close { background: var(--surface); color: var(--paper); border-color: var(--linelt); }
    html[data-theme="dark"] .nav-close:hover { background: var(--amber); color: var(--ink3); border-color: var(--amber); }
    .nav-panel {
      display: flex;
      flex-direction: column;
      gap: 2px;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 990;
      padding: calc(72px + 16px) 5vw 24px;
      min-height: 100vh;
      background: var(--surface);
      overflow-y: auto;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity .3s, visibility .3s, transform .3s;
    }
    .nav-panel.open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .nav-panel .np-label {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--coral);
      margin: 6px 2px 10px;
    }
    .nav-panel a:not(.btn) {
      font-family: var(--mono);
      font-size: 13px;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--ink);
      text-decoration: none;
      padding: 12px 8px;
      border-bottom: 1px solid var(--line);
      transition: color .2s, padding-left .2s;
    }
    .nav-panel a:not(.btn):hover { color: var(--coral); padding-left: 14px; }
    .nav-panel .np-seq {
      display: block;
      height: 1px;
      background: var(--line);
      margin: 14px 0 6px;
    }
    .nav-panel .np-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 26px;
      flex-wrap: wrap;
    }
    /* masquer les contrôles desktop et tout garder accessible depuis le panneau */
    .nav { display: none; }
    .nav-actions #ctaBtn { display: none; }
    .nav-actions > .lang-switch { display: none; }
    .nav-toggle { display: inline-flex; }
    html[data-theme="dark"] .nav-panel { background: #0B0F17; }
    html[data-theme="dark"] .nav-panel a:not(.btn) { color: #F8FAFC; border-color: rgba(255,255,255,0.14); }
    html[data-theme="dark"] .nav-panel a:not(.btn):hover { color: var(--amber2); }
    html[data-theme="dark"] .nav-panel .np-seq { background: rgba(255,255,255,0.14); }
  }
</style>