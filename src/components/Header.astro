    <a href={`${pfx}/pres`} target="_blank" style="color: var(--amber2);" data-i18n="nav.pres">{isEn ? "📽️ Slide Deck Mode" : "📽️ Mode Diaporama"}</a>
    <span class="np-seq" aria-hidden="true"></span>
