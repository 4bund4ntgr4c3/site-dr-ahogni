---
const pathname = Astro.url.pathname;
const isEn = pathname === "/en" || pathname.startsWith("/en/");
const pfx = isEn ? "/en" : "";
const homePath = isEn ? "/en" : "/";

let frPath = pathname;
if (isEn) {
  frPath = pathname.replace(/^\/en(\/|$)/, "/") || "/";
  if (!frPath.startsWith("/")) frPath = "/" + frPath;
}

let enPath = pathname;
if (!isEn) {
  const clean = pathname === "/" ? "" : pathname.replace(/\/$/, "");
  enPath = `/en${clean}`;
}
---

