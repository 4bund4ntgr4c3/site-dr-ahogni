---
---

<header id="topbar" class:list={[{ sc: true }]}>
  <a class="logo" href="/" aria-label="Accueil">
    <span class="logo-mark" aria-hidden="true">IA</span>
    <span class="logo-text">
      <span class="lg-title" data-i18n="logo.title">Dr Idelphonse B. AHOGNI</span>
      <span class="lg-sub" data-i18n="logo.sub">MSc, PhD, MPHc, Public Health Entomologist</span>
    </span>
  </a>
  <nav class="nav" aria-label="Navigation principale">
    <div class="nav-drop">
      <button class="nav-drop-btn" type="button" aria-haspopup="true" aria-expanded="false" title="Sections de l'accueil">
        <span data-i18n="nav.home">Accueil</span><span class="caret" aria-hidden="true"></span>
      </button>
      <div class="nav-drop-menu">
        <a href="/#apropos" data-i18n="nav.profil">Profil</a>
        <a href="/#competences" data-i18n="nav.expertises">Expertises</a>
        <a href="/#experience" data-i18n="nav.parcours">Parcours</a>
        <a href="/#formation" data-i18n="nav.formation">Formation</a>
        <a href="/#service" data-i18n="nav.service">Service</a>
        <a href="/#distinctions" data-i18n="nav.distinctions">Distinctions</a>
      </div>
    </div>
    <a href="/publications" data-i18n="nav.publications">Publications</a>
    <a href="/blog" data-i18n="nav.blog">Blog</a>
    <a href="/contact" data-i18n="nav.contact">Contact</a>
  </nav>
  <div class="nav-actions">
    <button id="themeToggle" class="theme-toggle" type="button" aria-pressed="false" title="Changer de thème (clair/sombre)">
      <svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <button id="searchTrigger" class="search-trigger" type="button" aria-haspopup="dialog" aria-controls="searchOverlay" title="Rechercher (Ctrl+K)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <kbd>⌘K</kbd>
    </button>
    <button class="lang-switch" type="button" id="langSwitch" aria-label="Changer de langue (FR/EN)" title="FR / EN">
      <span class="lang-opt" data-lang="fr" data-i18n="lang.fr">FR</span>
      <span class="lang-sep" aria-hidden="true">/</span>
      <span class="lang-opt" data-lang="en" data-i18n="lang.en">EN</span>
    </button>
    <a class="btn" id="ctaBtn" href="/contact" data-i18n="action.contact">Me contacter</a>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const drop = document.querySelector(".nav-drop");
    const btn = document.querySelector(".nav-drop-btn");
    const menu = document.querySelector(".nav-drop-menu");
    if (!drop || !btn || !menu) return;
    let timer;
    function open() {
      clearTimeout(timer);
      btn.classList.add("open");
      menu.classList.add("open");
      btn.setAttribute("aria-expanded", "true");
    }
    function close() {
      btn.classList.remove("open");
      menu.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
    }
    function armClose() { timer = window.setTimeout(close, 300); }
    btn.addEventListener("mouseenter", open);
    btn.addEventListener("focus", open);
    menu.addEventListener("mouseenter", () => clearTimeout(timer));
    drop.addEventListener("mouseleave", armClose);
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      btn.classList.contains("open") ? close() : open();
    });
    document.addEventListener("click", (e) => {
      if (e.target instanceof Element && !e.target.closest(".nav-drop")) close();
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
    menu.addEventListener("click", (e) => { if (e.target instanceof Element && e.target.closest("a")) close(); });
  });
</script>