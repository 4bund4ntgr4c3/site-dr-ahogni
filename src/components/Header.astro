---
import { sanityClient } from "sanity:client";
import { SETTINGS_QUERY, cachedFetch } from "../lib/queries";
const settings = await cachedFetch(sanityClient, SETTINGS_QUERY);
const isContact = Astro.url.pathname === "/contact";
const contactEmail = settings?.contactEmail || "ibahogni@gmail.com";
---

<header id="topbar" class:list={[{ sc: true }]}>
  <a class="logo" href="/" aria-label="Accueil">
    <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" aria-hidden="true">
      <path d="M45 60 Q30 50 18 30"/><path d="M47 66 Q28 66 12 58"/><path d="M50 72 Q36 84 24 98"/>
      <path d="M62 72 Q70 88 88 100"/><path d="M64 66 Q84 70 98 62"/><path d="M62 60 Q80 50 96 34"/>
      <ellipse cx="70" cy="52" rx="20" ry="7" transform="rotate(-32 70 52)"/>
      <ellipse cx="52" cy="62" rx="9" ry="8"/><circle cx="44" cy="68" r="5"/><path d="M40 72 L26 84"/>
    </svg>
    <span class="lg-mono">I·B·A — PhD</span>
  </a>
  <button class="lang-switch" type="button" id="langSwitch" aria-label="Changer de langue (FR/EN)" title="FR / EN"><span data-i18n="lang.fr">FR</span> · <span data-i18n="lang.en">EN</span></button>
  <nav class="nav" aria-label="Navigation principale">
    <a href="/#apropos" data-i18n="nav.profil">Profil</a>
    <a href="/#competences" data-i18n="nav.expertises">Expertises</a>
    <a href="/#experience" data-i18n="nav.parcours">Parcours</a>
    <a href="/#formation" data-i18n="nav.formation">Formation</a>
    <a href="/publications" data-i18n="nav.publications">Publications</a>
    <a href="/blog" data-i18n="nav.blog">Blog</a>
    <a href="/#distinctions" data-i18n="nav.distinctions">Distinctions</a>
    <a href="/contact" data-i18n="nav.contact">Contact</a>
  </nav>
  <div class="nav-actions">
    <button id="searchTrigger" class="search-trigger" title="Rechercher (Ctrl+K)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <kbd>⌘K</kbd>
    </button>
    <a class="btn ghost cta-cv" id="ctaCv" href="/cv" data-i18n="action.cv">CV ↓ PDF</a>
    <a class="btn" id="ctaBtn" href={isContact ? "/" : `mailto:${contactEmail}`} data-i18n={isContact ? "action.back" : "action.contact"}>
      {isContact ? "← Retour au site" : "Me contacter"}
    </a>
  </div>
</header>