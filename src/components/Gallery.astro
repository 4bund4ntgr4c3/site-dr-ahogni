---
import { sanityClient } from "sanity:client";
import { createImageUrlBuilder } from "@sanity/image-url";
import { CONTENT_QUERY, cachedFetch } from "../lib/queries";

const content = await cachedFetch(sanityClient, CONTENT_QUERY);
const urlFor = (source: any) => sanityClient.config().projectId ? createImageUrlBuilder({ projectId: sanityClient.config().projectId!, dataset: sanityClient.config().dataset! }).image(source) : null;

const isEn = Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");

const frFallbackGallery = [
  {
    src: "https://images.unsplash.com/photo-1576086213369-97a306d36557?auto=format&fit=crop&w=1200&q=80",
    thumb: "https://images.unsplash.com/photo-1576086213369-97a306d36557?auto=format&fit=crop&w=500&q=80",
    caption: "Caractérisation morphologique et dissection ovarienne d'Anopheles gambiae sous stéréomicroscope au CREC.",
  },
  {
    src: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1200&q=80",
    thumb: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=500&q=80",
    caption: "Bio-essais en tubes OMS : évaluation de la sensibilité aux pyréthroïdes et organophosphorés.",
  },
  {
    src: "https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=1200&q=80",
    thumb: "https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=500&q=80",
    caption: "Préparation des échantillons pour l'extraction d'ADN et le génotypage des allèles kdr L1014F.",
  },
  {
    src: "https://images.unsplash.com/photo-1518152006812-edab29b069ac?auto=format&fit=crop&w=1200&q=80",
    thumb: "https://images.unsplash.com/photo-1518152006812-edab29b069ac?auto=format&fit=crop&w=500&q=80",
    caption: "Mission de prospection et échantillonnage larvaire dans les bas-fonds rizicoles au sud du Bénin.",
  },
  {
    src: "https://images.unsplash.com/photo-1579154204601-01588f351e67?auto=format&fit=crop&w=1200&q=80",
    thumb: "https://images.unsplash.com/photo-1579154204601-01588f351e67?auto=format&fit=crop&w=500&q=80",
    caption: "Suivi entomologique dans les stations de cases expérimentales de Covè et d'Akron.",
  },
  {
    src: "https://images.unsplash.com/photo-1581093458791-9f3c3900df4b?auto=format&fit=crop&w=1200&q=80",
    thumb: "https://images.unsplash.com/photo-1581093458791-9f3c3900df4b?auto=format&fit=crop&w=500&q=80",
    caption: "Séance de formation et transfert de compétences auprès des étudiants en Master d'Entomologie Médicale.",
  },
];

const enFallbackGallery = [
  {
    src: "https://images.unsplash.com/photo-1576086213369-97a306d36557?auto=format&fit=crop&w=1200&q=80",
    thumb: "https://images.unsplash.com/photo-1576086213369-97a306d36557?auto=format&fit=crop&w=500&q=80",
    caption: "Morphological characterization and ovarian dissection of Anopheles gambiae under stereomicroscope at CREC.",
  },
  {
    src: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1200&q=80",
    thumb: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=500&q=80",
    caption: "WHO tube bioassays: evaluating vector susceptibility against pyrethroids and organophosphates.",
  },
  {
    src: "https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=1200&q=80",
    thumb: "https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=500&q=80",
    caption: "Sample preparation for DNA extraction and PCR genotyping of kdr L1014F target alleles.",
  },
  {
    src: "https://images.unsplash.com/photo-1518152006812-edab29b069ac?auto=format&fit=crop&w=1200&q=80",
    thumb: "https://images.unsplash.com/photo-1518152006812-edab29b069ac?auto=format&fit=crop&w=500&q=80",
    caption: "Field larval surveying and collection across irrigated rice floodplains in Southern Benin.",
  },
  {
    src: "https://images.unsplash.com/photo-1579154204601-01588f351e67?auto=format&fit=crop&w=1200&q=80",
    thumb: "https://images.unsplash.com/photo-1579154204601-01588f351e67?auto=format&fit=crop&w=500&q=80",
    caption: "Entomological monitoring in experimental hut stations at Covè and Akron.",
  },
  {
    src: "https://images.unsplash.com/photo-1581093458791-9f3c3900df4b?auto=format&fit=crop&w=1200&q=80",
    thumb: "https://images.unsplash.com/photo-1581093458791-9f3c3900df4b?auto=format&fit=crop&w=500&q=80",
    caption: "Hands-on capacity building and masterclass session for Master's students in Medical Entomology.",
  },
];

const fallbackGallery = isEn ? enFallbackGallery : frFallbackGallery;

const sanityItems = (isEn ? (content?.galleryEn ?? []) : (content?.gallery ?? [])).map((g: any) => ({
  src: urlFor(g.image)?.width(1200).auto("format").quality(80).url(),
  thumb: urlFor(g.image)?.width(500).auto("format").quality(70).url(),
  caption: g.caption || "",
})).filter((it: any) => Boolean(it.src));

const items = sanityItems.length > 0 ? sanityItems : fallbackGallery;
const hasGallery = items.length > 0;
---

{hasGallery && (
<section class="sec" id="galerie">
  <div class="wrap">
    <div class="sec-head">
      <p class="sec-eyebrow" data-i18n="sec.gallery.eyebrow">{isEn ? "09 — Field & Laboratory Gallery" : "09 — Galerie terrain & laboratoire"}</p>
      <h2 class="title lm" data-i18n-html="sec.gallery.title">
        {isEn ? (
          <span class="ln"><span>In the</span></span><span class="ln"><span><span class="it">field</span> &amp; laboratory</span></span>
        ) : (
          <span class="ln"><span>Sur le</span></span><span class="ln"><span><span class="it">terrain</span> &amp; en laboratoire</span></span>
        )}
      </h2>
      <p class="gal-lede" data-i18n="gallery.lede">
        {isEn
          ? "Immersion in daily operational research: larval surveys, WHO bioassays, experimental huts, and academic capacity building."
          : "Immersion dans les activités quotidiennes de recherche : prospections larvaires, bio-essais, cases expérimentales et encadrement académique."}
      </p>
    </div>
    <ul class="gal-grid">
      {items.map((g: any, i: number) => (
        <li class="gal-item rv">
          <button type="button" class="gal-btn" data-open={i} aria-label={g.caption ? (isEn ? `Enlarge photo: ${g.caption}` : `Agrandir la photo : ${g.caption}`) : (isEn ? `Enlarge photo ${i + 1}` : `Agrandir la photo ${i + 1}`)}>
            <img src={g.thumb} alt={g.caption} loading="lazy" decoding="async" width="500" height="375" fetchpriority="low">
            <span class="gal-overlay">
              <span class="gal-cap-peek">{g.caption}</span>
              <span class="gal-zoom-icon">{isEn ? "🔍 Enlarge" : "🔍 Agrandir"}</span>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>
  <script type="application/json" id="gal-data" set:html={JSON.stringify(items).replace(/</g, "\\u003c")}></script>

  <div id="lightbox" class="lx" role="dialog" aria-modal="true" aria-label={isEn ? "Image gallery" : "Galerie d'images"} hidden>
    <button class="lx-close" data-lx="close" aria-label={isEn ? "Close" : "Fermer"}>✕</button>
    <button class="lx-nav lx-prev" data-lx="prev" aria-label={isEn ? "Previous" : "Précédente"}>‹</button>
    <div class="lx-stage">
      <figure>
        <img id="lxImg" src="" alt="">
        <figcaption id="lxCap"></figcaption>
      </figure>
    </div>
    <button class="lx-nav lx-next" data-lx="next" aria-label={isEn ? "Next" : "Suivante"}>›</button>
  </div>
</section>
)}

<script>
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>(".gal-btn"));
  const items = JSON.parse(document.getElementById("gal-data")?.textContent || "[]");
  if (thumbs.length) {
    const box = document.getElementById("lightbox")!;
    const img = document.getElementById("lxImg") as HTMLImageElement;
    const cap = document.getElementById("lxCap")!;
    let idx = 0;

    function show(i: number) {
      idx = (i + thumbs.length) % thumbs.length;
      const it = items[idx];
      if (it) { img.src = it.src; cap.textContent = it.caption || ""; }
    }
    function open(i: number, from: HTMLElement) {
      idx = i;
      show(i);
      box.hidden = false;
      document.body.style.overflow = "hidden";
      (box.querySelector(".lx-close") as HTMLElement).focus();
    }
    function close() {
      box.hidden = true;
      document.body.style.overflow = "";
      document.querySelector<HTMLButtonElement>(`.gal-btn[data-open]`)?.focus();
    }

    thumbs.forEach((btn) => btn.addEventListener("click", () => open(Number(btn.dataset.open), btn)));
    (box.querySelector('[data-lx="close"]') as HTMLElement).addEventListener("click", close);
    (box.querySelector('[data-lx="prev"]') as HTMLElement).addEventListener("click", () => show(idx - 1));
    (box.querySelector('[data-lx="next"]') as HTMLElement).addEventListener("click", () => show(idx + 1));
    box.addEventListener("click", (e) => { if (e.target === box) close(); });
    document.addEventListener("keydown", (e) => {
      if (box.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") show(idx - 1);
      else if (e.key === "ArrowRight") show(idx + 1);
    });
  }
</script>

<style>
  .gal-lede { max-width: 60ch; font-size: 1.08rem; color: var(--ink2); margin-top: 18px; line-height: 1.7; }
  .gal-grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
  .gal-item { aspect-ratio: 4/3; }
  .gal-btn {
    width: 100%;
    height: 100%;
    padding: 0;
    border: 1px solid var(--line);
    background: var(--paper2);
    cursor: zoom-in;
    overflow: hidden;
    display: block;
    position: relative;
  }
  .gal-btn img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease, opacity .3s; }
  .gal-btn:hover img { transform: scale(1.06); }
  .gal-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11,15,23,0.85), transparent 60%);
    opacity: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 16px;
    transition: opacity .3s ease;
    color: #FFFFFF;
    text-align: left;
  }
  .gal-btn:hover .gal-overlay { opacity: 1; }
  .gal-cap-peek {
    font-size: 0.85rem;
    line-height: 1.4;
    color: #F8FAFC;
    margin-bottom: 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .gal-zoom-icon {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--amber2);
  }
  .gal-btn:focus-visible { outline: 3px solid var(--amber); outline-offset: 2px; }

  .lx {
    position: fixed;
    inset: 0;
    z-index: 3000;
    background: rgba(11,15,23,.94);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lx-stage { max-width: 90vw; max-height: 84vh; }
  .lx-stage img { max-width: 90vw; max-height: 74vh; object-fit: contain; display: block; margin: 0 auto; border: 1px solid rgba(255,255,255,0.15); }
  .lx-stage figcaption {
    text-align: center;
    color: #CBD5E1;
    font-family: var(--body);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-top: 14px;
    padding: 0 20px;
    max-width: 700px;
  }
  .lx-close { position: absolute; top: 18px; right: 22px; background: none; border: 0; color: #FFFFFF; font-size: 26px; cursor: pointer; line-height: 1; padding: 8px; transition: color .2s; }
  .lx-close:hover { color: var(--amber2); }
  .lx-nav { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(11,15,23,0.6); border: 1px solid rgba(255,255,255,.2); color: #FFFFFF; font-size: 30px; cursor: pointer; padding: 10px 18px; line-height: 1; transition: background .2s, color .2s; }
  .lx-nav:hover { background: var(--amber2); color: #0B0F17; }
  .lx-close:focus-visible, .lx-nav:focus-visible { outline: 3px solid var(--amber); }
  .lx-prev { left: 16px; } .lx-next { right: 16px; }
  @media (max-width: 640px) { .lx-nav { font-size: 22px; padding: 6px 12px; } }
</style>