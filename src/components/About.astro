---
import { sanityClient } from "sanity:client";
import { PortableText } from "astro-portabletext";
import { createImageUrlBuilder } from "@sanity/image-url";
import { SETTINGS_QUERY, CONTENT_QUERY, cachedFetch } from "../lib/queries";

const settings = await cachedFetch(sanityClient, SETTINGS_QUERY);
const content = await cachedFetch(sanityClient, CONTENT_QUERY);
const urlFor = (source: any) => sanityClient.config().projectId ? createImageUrlBuilder({ projectId: sanityClient.config().projectId!, dataset: sanityClient.config().dataset! }).image(source) : null;
const aboutImg = settings?.aboutImage ? urlFor(settings.aboutImage)?.width(800).height(800).auto("format").quality(80).url() : null;
const isEn = Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");

const chips = isEn
  ? (content?.aboutChipsEn ?? ["Medical Entomology", "Insecticide Resistance", "Dual-Active LLINs", "GLP Quality Standards", "Genomic Surveillance", "Public Health NMCP", "Phase II/III Trials"])
  : (content?.aboutChips ?? ["Entomologie Médicale", "Résistance aux Insecticides", "MILDV Bi-actives", "Normes BPL", "Surveillance Génomique", "Santé Publique & PNLP"]);

const facts = isEn
  ? (content?.aboutFactsEn ?? [
      { key: "Specialty", value: "Medical Entomology & Malaria" },
      { key: "Institution", value: "CREC / LSHTM Partner" },
      { key: "Experience", value: "10+ Years in Sub-Saharan Africa" },
      { key: "Working Languages", value: "French, English, Fon" },
    ])
  : (content?.aboutFacts ?? [
      { key: "Spécialité", value: "Entomologie Médicale & Paludisme" },
      { key: "Affiliation", value: "CREC Bénin / Partenaire LSHTM" },
      { key: "Expérience", value: "10+ ans en Afrique subsaharienne" },
      { key: "Langues de travail", value: "Français, Anglais, Fon" },
    ]);

const pullQuote = isEn
  ? (content?.aboutPullQuoteEn ?? "Bridging cutting-edge entomological research with national public health decision-making to accelerate malaria elimination.")
  : (content?.aboutPullQuote || "Mettre la rigueur de la recherche entomologique au service des décisions stratégiques nationales pour accélérer l'élimination du paludisme.");

const figCaptionLeft = isEn ? "Larval survey & Phase II trials" : (settings?.aboutFigCaption?.left || "Prospection larvaire & essais Phase II");
const figCaptionRight = isEn ? "Covè Sentinel Station, Benin" : (settings?.aboutFigCaption?.right || "Station de Covè, Bénin");
---

<section class="sec" id="apropos">
  <div class="wrap">
    <div class="sec-head">
      <p class="sec-eyebrow" data-i18n="sec.about.eyebrow">{isEn ? "01 — Profile" : "01 — Profil"}</p>
      <h2 class="title lm" data-i18n-html="sec.about.title">
        {isEn ? (
          <span class="ln"><span>Science in the service of</span></span><span class="ln"><span>malaria <span class="it">programs</span></span></span>
        ) : (
          <span class="ln"><span>La science au service</span></span><span class="ln"><span>des <span class="it">programmes paludisme</span></span></span>
        )}
      </h2>
    </div>
    <div class="about-grid">
      <div class="about-txt rv">
        {isEn ? (
          content?.aboutTextEn ? <PortableText value={content.aboutTextEn} /> : (
            <div class="about-p-custom" data-i18n-html="about.text">
              <span hidden>{isEn ? "EN" : "FR"}</span>
              <p><strong>Dr Idelphonse Bonaventure AHOGNI</strong> is a Medical Entomologist (PhD) and Senior Researcher at the Entomological Research Centre of Cotonou (CREC) in Benin.</p>
              <p>With over a decade of operational research experience, he specializes in the evaluation of next-generation vector control interventions (dual-active LLINs, IRS), genomic surveillance of insecticide resistance (<em>kdr</em>, <em>ace-1</em>, metabolic cytochromes P450), and direct strategic technical support to National Malaria Control Programs (NMCPs) and global agencies (WHO, The Global Fund, PMI/USAID, PAMCA).</p>
            </div>
          )
        ) : (
          content?.aboutText ? <PortableText value={content.aboutText} /> : (
            <div class="about-p-custom" data-i18n-html="about.text">
              <span hidden>{isEn ? "EN" : "FR"}</span>
              <p><strong>Dr Idelphonse Bonaventure AHOGNI</strong> est Docteur en Entomologie Médicale (PhD) et chercheur senior au Centre de Recherche Entomologique de Cotonou (CREC) au Bénin.</p>
              <p>Fort de plus de dix années d'expérience de recherche opérationnelle, il est spécialisé dans l'évaluation des outils de lutte antivectorielle de nouvelle génération (MILDV bi-actives, PID), la surveillance génomique de la résistance aux insecticides (<em>kdr</em>, <em>ace-1</em>, cytochromes P450) et l'appui technique direct aux Programmes Nationaux de Lutte contre le Paludisme (PNLP) et aux bailleurs internationaux (OMS, Fonds mondial, PMI/USAID, PAMCA).</p>
            </div>
          )
        )}
        <div class="chips" data-i18n-html="about.chips">
          <span hidden>{isEn ? "EN" : "FR"}</span>
          {chips.map((chip: string) => <span class="chip">{chip}</span>)}
        </div>
        <div class="facts" data-i18n-html="about.facts">
          <span hidden>{isEn ? "EN" : "FR"}</span>
          {facts.map((fact: { key: string; value: string }) => (
            <div class="fact"><span class="k">{fact.key}</span><span class="v">{fact.value}</span></div>
          ))}
        </div>
        <blockquote class="pull" data-i18n="about.quote"><span hidden>{isEn ? "EN" : "FR"}</span>« {pullQuote} »</blockquote>
      </div>
      <figure class="about-fig rv">
        <div class="ph">
          {aboutImg ? (
            <img src={aboutImg} alt={isEn ? "Field entomological mosquito collection" : "Collecte entomologique de terrain"} loading="lazy" decoding="async">
          ) : (
            <div style="aspect-ratio:1/1;background:var(--paper2)"></div>
          )}
        </div>
        <figcaption>
          <span data-i18n="about.figLeft"><span hidden>{isEn ? "EN" : "FR"}</span>{figCaptionLeft}</span>
          <span data-i18n="about.figRight"><span hidden>{isEn ? "EN" : "FR"}</span>{figCaptionRight}</span>
        </figcaption>
        <svg class="mosq-float" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M45 60 Q30 50 18 30"/><path d="M47 66 Q28 66 12 58"/><path d="M50 72 Q36 84 24 98"/>
          <path d="M62 72 Q70 88 88 100"/><path d="M64 66 Q84 70 98 62"/><path d="M62 60 Q80 50 96 34"/>
        </svg>
      </figure>
    </div>
  </div>
</section>
