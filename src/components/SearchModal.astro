---
import { sanityClient } from "sanity:client";
import { SETTINGS_QUERY, CONTENT_QUERY, POSTS_QUERY, cachedFetch } from "../lib/queries";

const settings = await cachedFetch(sanityClient, SETTINGS_QUERY);
const content = await cachedFetch(sanityClient, CONTENT_QUERY);
const posts = await cachedFetch(sanityClient, POSTS_QUERY);

const isEn = Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");
const pfx = isEn ? "/en" : "";
const homePath = isEn ? "/en" : "/";

const sections = [
  { id: "apropos", label: isEn ? "About Dr Ahogni" : "À propos", keywords: "bio profil présentation résumé about profile bio" },
  { id: "impact", label: isEn ? "Scientific Impact & Network" : "Impact Scientifique & Réseau", keywords: "citations h-index open access réseau partenaires crec lshtm oms cdc pamca network impact" },
  { id: "axes-recherche", label: isEn ? "Research Radar & Expertise" : "Radar d'Expertise & Mots-clés", keywords: "radar axes recherche compétences mots-clés research topics keywords" },
  { id: "competences", label: isEn ? "Core Competencies" : "Compétences", keywords: "compétences expertises entomologie paludisme skills expertise malaria" },
  { id: "anatomie-vecteur", label: isEn ? "Anopheles Anatomy & Microscopy" : "Anatomie & Microscopie Anophèle", keywords: "anatomie organes glandes salivaires proboscis intestin ovaires canal sodium vgsc anatomy" },
  { id: "moustiquaires", label: isEn ? "LLIN Dual-Active Matrix" : "Matrice Moustiquaires LLIN", keywords: "moustiquaires mildv llin pbo chlorfénapyr interceptor g2 royal guard pyriproxyfène prévention nets" },
  { id: "entomologie", label: isEn ? "Vector Explorer & WHO Bioassays" : "Explorateur Vecteurs & Bio-essais OMS", keywords: "vecteurs anopheles gambiae coluzzii funestus stephensi simulateur bio-essais abbott mortalite bioassay" },
  { id: "stations-benin", label: isEn ? "Field Research Stations (Benin)" : "Stations de Recherche & Sites Bénin", keywords: "stations terrain covè akron parakou kandi cases expérimentales sentinelles sentinel huts" },
  { id: "climat-vecteurs", label: isEn ? "Weather & Vector Risk Dashboard" : "Tableau de Bord Météo-Entomologique", keywords: "climat météo température humidité pluviométrie indice émergence larvaire cotonou bohicon parakou weather" },
  { id: "genetique", label: isEn ? "Population Genetics & HWE" : "Génétique des Populations & HWE", keywords: "génétique fréquences alléliques hardy-weinberg kdr ace-1 chi-deux sélection genetics" },
  { id: "dimensionnement", label: isEn ? "Sample Size Calculator (Fleiss)" : "Calculateur d'Échantillonnage", keywords: "échantillonnage dimensionnement taille moustiques tubes puissance statistique bio-essais sample size" },
  { id: "cout-efficacite", label: isEn ? "Cost-Effectiveness Simulator" : "Simulateur Coût-Efficacité", keywords: "coût-efficacité économie santé district budget cas évités rentabilité intervention cost effectiveness" },
  { id: "experience", label: isEn ? "Professional Experience" : "Expérience", keywords: "parcours carrière postes career experience" },
  { id: "formation", label: isEn ? "Education & Degrees" : "Formation", keywords: "diplômes doctorat phd cursus études degrees education" },
  { id: "mentorat", label: isEn ? "Mentorship & Alumni Network" : "Mentorat & Réseau Alumni", keywords: "mentorat encadrement étudiants thèses masters alumni mentorship" },
  { id: "publications", label: isEn ? "Publications" : "Publications", keywords: "articles revues recherche bibtex ris citations papers" },
  { id: "timeline-projets", label: isEn ? "Funded Projects Timeline" : "Projets & Programmes Financés", keywords: "financements fonds mondial usaid pmi oms wellcome trust projets grants funding" },
  { id: "distinctions", label: isEn ? "Awards & Honors" : "Distinctions", keywords: "distinctions bourses awards prix honors" },
  { id: "service", label: isEn ? "Scientific Service & Advisory" : "Service", keywords: "service affiliations consultant advisory" },
  { id: "communications", label: isEn ? "Scientific Talks & Keynotes" : "Communications", keywords: "communications conférences talks posters presentations" },
  { id: "videos", label: isEn ? "Video Library & Lectures" : "Vidéothèque & Enseignement", keywords: "vidéos conférences webinaires replay youtube videos" },
  { id: "capsules-audio", label: isEn ? "Audio Learning Micro-Capsules" : "Mini-Capsules Audio Pédagogiques", keywords: "audio podcast micro-learning chlorfénapyr hlc capture volontaires stephensi cours" },
  { id: "veille", label: isEn ? "Epidemiological Surveillance & Alerts" : "Veille Épidémiologique & Alertes", keywords: "veille bulletins transmission saisonnière stephensi alertes paludisme alerts" },
  { id: "ressources", label: isEn ? "Resource Center & Protocols" : "Centre de Ressources & Protocoles", keywords: "ressources protocoles sops bio-essais élevage larves fiches cours pdf protocols" },
  { id: "audit-bpl", label: isEn ? "GLP Insectary Self-Assessment" : "Auto-Évaluation BPL / GLP Insectarium", keywords: "audit bpl glp bonnes pratiques laboratoire insectarium critères conformité oms oecd compliance" },
  { id: "glossaire", label: isEn ? "Bilingual Medical Glossary" : "Glossaire Bilingue d'Entomologie", keywords: "glossaire dictionnaire définitions tie eir kdr pbo kdt50 endophagie anthropophilie glossary" },
  { id: "assistant-ia", label: isEn ? "Certified Knowledge Base & Research Engine" : "Assistant IA Virtuel « Dr Ahogni AI »", keywords: "assistant ia chatbot questions réponses intelligence artificielle faq robot knowledge base" },
  { id: "media", label: isEn ? "Media & Press Coverage" : "Médias", keywords: "médias presse interview reportage audio podcast press" },
  { id: "projects", label: isEn ? "International Projects" : "Projets", keywords: "projets programmes financés missions projects" },
];

const pages = [
  { url: `${pfx}/expertises`, label: isEn ? "Dedicated Page: Expertise & Research" : "Page Dédiée : Expertises & Recherche", keywords: "page expertises recherche 8 domaines piliers anatomie anophèle radar expertise research" },
  { url: `${pfx}/entomologie`, label: isEn ? "Dedicated Page: Medical Entomology & Calculators" : "Page Dédiée : Entomologie Médicale & Calculatrices", keywords: "page entomologie bio-essais génétique hwe fleiss échantillonnage moustiquaires simulateur coût entomology tools" },
  { url: `${pfx}/stations-terrain`, label: isEn ? "Dedicated Page: Field Stations & GLP" : "Page Dédiée : Stations de Terrain & BPL", keywords: "page stations terrain covè akron bénin météo climat bpl glp insectarium galerie field stations" },
  { url: `${pfx}/projets`, label: isEn ? "Dedicated Page: Funded Projects & Programs" : "Page Dédiée : Projets & Financements", keywords: "page projets programmes financements fonds mondial pmi usaid afrique carte timeline projects grants" },
  { url: `${pfx}/parcours`, label: isEn ? "Dedicated Page: Career, Education & Mentorship" : "Page Dédiée : Parcours, Formation & Mentorat", keywords: "page parcours carrière diplômes mentorat thèses service distinctions career mentorship" },
  { url: `${pfx}/medias`, label: isEn ? "Dedicated Page: Media, Videos & Podcasts" : "Page Dédiée : Médias, Vidéos & Podcasts", keywords: "page médias presse vidéos replay capsules audio podcasts veille bulletins media outreach" },
  { url: `${pfx}/ressources`, label: isEn ? "Dedicated Page: Academic Resources, SOPs & Knowledge Base" : "Page Dédiée : Ressources Académiques, SOPs & IA", keywords: "page ressources protocoles sops glossaire assistant ia chatbot témoignages resources sops" },
  { url: `${pfx}/publications`, label: isEn ? "Page: Scientific Publications" : "Page : Publications Scientifiques", keywords: "page publications articles bibtex ris recherche papers" },
  { url: `${pfx}/speaking`, label: isEn ? "Page: Conferences & Keynotes" : "Page : Conférences & Présentations", keywords: "page conférences speaking interventions présentations talks" },
  { url: `${pfx}/cv`, label: isEn ? "Page: Curriculum Vitae & JSON Resume" : "Page : Curriculum Vitae & Résumé JSON", keywords: "page cv résumé pdf curriculum vitae json resume" },
  { url: `${pfx}/contact`, label: isEn ? "Page: Contact & Inquiry" : "Page : Contact & Prise de Rendez-vous", keywords: "page contact coordonnées message vcard inquiry" },
  { url: `${pfx}/pres`, label: isEn ? "Page: Fullscreen Presentation Slide Deck" : "Page : Diaporama & Mode Présentation", keywords: "page diaporama slides présentation plein écran presentation deck" },
  { url: `${pfx}/changelog`, label: isEn ? "Page: Site Changelog" : "Page : Journal des Modifications (Changelog)", keywords: "page changelog versions mises à jour historique changelog" },
];

const pubs = content?.publications ?? [];
const talks = content?.talks ?? [];
---

<div id="searchOverlay" class="search-overlay" aria-hidden="true">
  <div class="search-modal" role="dialog" aria-modal="true" aria-label={isEn ? "Site search" : "Recherche"} data-i18n-aria="search.aria">
    <div class="search-header">
      <div class="search-input-wrap">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input
          type="text"
          id="searchInput"
          class="search-input"
          placeholder={isEn ? "Search page, section, publication, calculator..." : "Rechercher une page, section, publication, calculatrice..."}
          data-i18n-placeholder="search.placeholder"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="search-kbd">ESC</kbd>
      </div>
    </div>
    <div class="search-body" id="searchResults">
      <div class="search-group">
        <p class="search-group-title" data-i18n="search.groupPages">{isEn ? "Dedicated Pages" : "Pages Dédiées"}</p>
        {pages.map(p => (
          <a href={p.url} class="search-item" data-type="page" data-keywords={p.keywords}>
            <span class="search-item-icon">🔗</span>
            <span class="search-item-label">{p.label}</span>
          </a>
        ))}
      </div>
      <div class="search-group">
        <p class="search-group-title" data-i18n="search.groupHome">{isEn ? "Home Sections" : "Sections Accueil"}</p>
        {sections.map(s => (
          <a href={`${homePath}#${s.id}`} class="search-item" data-type="section" data-keywords={s.keywords}>
            <span class="search-item-icon">§</span>
            <span class="search-item-label">{s.label}</span>
          </a>
        ))}
      </div>
      <div class="search-group">
        <p class="search-group-title"><span data-i18n="search.groupPubs">{isEn ? "Publications" : "Publications"}</span> ({pubs.length})</p>
        {pubs.map((pub: any) => (
          <a
            href={pub.url || (pub.doi ? `https://doi.org/${pub.doi}` : '#')}
            class="search-item"
            data-type="publication"
            data-keywords={`${pub.title} ${pub.journal} ${pub.authors} ${pub.year}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="search-item-icon">📄</span>
            <span class="search-item-label">{pub.title}</span>
            <span class="search-item-meta">{pub.journal} · {pub.year}</span>
          </a>
        ))}
      </div>
      {talks.length > 0 && (
        <div class="search-group">
          <p class="search-group-title"><span data-i18n="search.groupTalks">{isEn ? "Conferences & Talks" : "Conférences"}</span> ({talks.length})</p>
          {talks.map((t: any) => (
            <div class="search-item" data-type="talk" data-keywords={`${t.title} ${t.event} ${t.year} ${t.type}`}>
              <span class="search-item-icon">🎤</span>
              <span class="search-item-label">{t.title}</span>
              <span class="search-item-meta">{t.event} · {t.year}</span>
            </div>
          ))}
        </div>
      )}
      {posts?.length > 0 && (
        <div class="search-group">
          <p class="search-group-title"><span data-i18n="search.groupBlog">{isEn ? "Blog & Field Notes" : "Blog & Notes"}</span> ({posts.length})</p>
          {posts.map((p: any) => (
            <a
              href={`${pfx}/blog/${p.slug?.current}`}
              class="search-item"
              data-type="blog"
              data-keywords={`${p.title} ${p.excerpt} ${(p.tags ?? []).join(" ")}`}
            >
              <span class="search-item-icon">✏️</span>
              <span class="search-item-label">{p.title}</span>
              <span class="search-item-meta">{p.tags?.[0] || "Blog"}</span>
            </a>
          ))}
        </div>
      )}
      <div class="search-group">
        <p class="search-group-title" data-i18n="search.groupSkills">{isEn ? "Skills" : "Compétences"}</p>
        {(content?.skillGroups ?? []).flatMap((g: any) =>
          (g.tags ?? []).map((tag: string) => (
            <div class="search-item" data-type="skill" data-keywords={`${tag} ${g.category}`}>
              <span class="search-item-icon">◆</span>
              <span class="search-item-label">{tag}</span>
              <span class="search-item-meta">{g.category}</span>
            </div>
          ))
        )}
      </div>
      <div class="search-group">
        <p class="search-group-title" data-i18n="search.groupExpertises">{isEn ? "Expertise" : "Expertises"}</p>
        {(content?.expertise ?? []).map((e: any) => (
          <a href={`${homePath}#competences`} class="search-item" data-type="expertise" data-keywords={`${e.title} ${e.description}`}>
            <span class="search-item-icon">✦</span>
            <span class="search-item-label">{e.title}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="search-empty" id="searchEmpty" style="display:none;" data-i18n="search.empty">
      {isEn ? "No results found." : "Aucun résultat trouvé."}
    </div>
    <div class="search-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> <span data-i18n="search.nav">{isEn ? "navigate" : "naviguer"}</span></span>
      <span><kbd>↵</kbd> <span data-i18n="search.open">{isEn ? "open" : "ouvrir"}</span></span>
      <span><kbd>esc</kbd> <span data-i18n="search.close">{isEn ? "close" : "fermer"}</span></span>
    </div>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(10,26,21,.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
    opacity: 0;
    visibility: hidden;
    transition: opacity .25s, visibility .25s;
  }
  .search-overlay[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }
  .search-modal {
    background: var(--surface);
    border: 1px solid var(--line);
    width: 90%;
    max-width: 640px;
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 30px 80px rgb(var(--rgb-ink) / .35);
    transform: translateY(12px) scale(.98);
    transition: transform .25s cubic-bezier(.2,.65,.15,1);
  }
  .search-overlay[aria-hidden="false"] .search-modal {
    transform: translateY(0) scale(1);
  }
  .search-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
  }
  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .search-icon {
    width: 20px;
    height: 20px;
    color: rgb(var(--rgb-ink) / .4);
    flex-shrink: 0;
  }
  .search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: var(--body);
    font-size: 1rem;
    color: var(--ink);
    outline: none;
  }
  .search-input::placeholder {
    color: rgb(var(--rgb-ink) / .4);
  }
  .search-kbd {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .08em;
    border: 1px solid var(--line);
    padding: 4px 8px;
    color: rgb(var(--rgb-ink) / .45);
    flex-shrink: 0;
  }
  .search-body {
    overflow-y: auto;
    flex: 1;
    padding: 8px 0;
  }
  .search-group {
    padding: 4px 0;
  }
  .search-group-title {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgb(var(--rgb-ink) / .45);
    padding: 8px 20px 4px;
  }
  .search-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px;
    cursor: pointer;
    transition: background .15s;
    text-decoration: none;
    color: inherit;
  }
  .search-item:hover,
  .search-item.active {
    background: rgb(var(--rgb-amber) / .1);
  }
  .search-item-icon {
    width: 20px;
    text-align: center;
    font-size: .85rem;
    color: var(--coral);
    flex-shrink: 0;
  }
  .search-item-label {
    flex: 1;
    font-size: .92rem;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-item-meta {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .08em;
    color: rgb(var(--rgb-ink) / .45);
    flex-shrink: 0;
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-empty {
    padding: 40px 20px;
    text-align: center;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: .1em;
    color: rgb(var(--rgb-ink) / .45);
  }
  .search-footer {
    border-top: 1px solid var(--line);
    padding: 10px 20px;
    display: flex;
    gap: 20px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .08em;
    color: rgb(var(--rgb-ink) / .45);
  }
  .search-footer kbd {
    font-family: var(--mono);
    font-size: 10px;
    border: 1px solid var(--line);
    padding: 1px 5px;
    margin-right: 4px;
    border-radius: 2px;
  }
  .search-item.hidden {
    display: none;
  }
  @media (max-width: 640px) {
    .search-overlay { padding-top: 6vh; }
    .search-modal { width: 95%; max-height: 80vh; }
    .search-footer { display: none; }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const overlay = document.getElementById("searchOverlay")!;
    const input = document.getElementById("searchInput") as HTMLInputElement;
    const results = document.getElementById("searchResults")!;
    const empty = document.getElementById("searchEmpty")!;
    const trigger = document.getElementById("searchTrigger")!;
    const items = () => Array.from(results.querySelectorAll<HTMLElement>(".search-item:not(.hidden)"));
    let activeIdx = -1;

    function open() {
      overlay.setAttribute("aria-hidden", "false");
      input.value = "";
      filter("");
      setTimeout(() => input.focus(), 100);
      document.body.style.overflow = "hidden";
    }

    function close() {
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    function fuzzyMatch(text: string, query: string): boolean {
      if (text.includes(query)) return true;
      let qi = 0;
      for (let i = 0; i < text.length && qi < query.length; i++) {
        if (text[i] === query[qi]) qi++;
      }
      return qi === query.length;
    }

    function filter(q: string) {
      const query = q.toLowerCase().trim();
      let visible = 0;
      results.querySelectorAll<HTMLElement>(".search-item").forEach(el => {
        const kw = (el.dataset.keywords || "").toLowerCase();
        const label = el.querySelector(".search-item-label")?.textContent?.toLowerCase() || "";
        const show = !query || fuzzyMatch(kw, query) || fuzzyMatch(label, query);
        el.classList.toggle("hidden", !show);
        if (show) visible++;
      });
      // hide empty groups
      results.querySelectorAll<HTMLElement>(".search-group").forEach(g => {
        const hasVisible = g.querySelector(".search-item:not(.hidden)");
        g.style.display = hasVisible ? "" : "none";
      });
      empty.style.display = visible === 0 ? "" : "none";
      activeIdx = -1;
      items().forEach(el => el.classList.remove("active"));
    }

    function navigate(dir: number) {
      const list = items();
      if (!list.length) return;
      list[activeIdx]?.classList.remove("active");
      activeIdx = (activeIdx + dir + list.length) % list.length;
      list[activeIdx].classList.add("active");
      list[activeIdx].scrollIntoView({ block: "nearest" });
    }

    function activate() {
      const list = items();
      if (activeIdx >= 0 && list[activeIdx]) {
        const link = list[activeIdx].getAttribute("href");
        if (link) {
          close();
          window.location.href = link;
        } else {
          close();
        }
      }
    }

    trigger.addEventListener("click", open);
    overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });
    input.addEventListener("input", () => filter(input.value));

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); navigate(1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); navigate(-1); }
      else if (e.key === "Enter") { e.preventDefault(); activate(); }
      else if (e.key === "Escape") { close(); }
    });

    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "k") {
        e.preventDefault();
        if (overlay.getAttribute("aria-hidden") === "true") open();
        else close();
      }
    });
  });
</script>
