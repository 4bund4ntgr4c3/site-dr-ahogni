---
import { sanityClient } from "sanity:client";
import { SETTINGS_QUERY, CONTENT_QUERY } from "../lib/queries";

const settings = await sanityClient.fetch(SETTINGS_QUERY);
const content = await sanityClient.fetch(CONTENT_QUERY);

const sections = [
  { id: "apropos", label: "Profil", keywords: "profil bio à propos expérience" },
  { id: "competences", label: "Expertises", keywords: "compétences expertise domaines intervention" },
  { id: "experience", label: "Parcours", keywords: "parcours carrière experience emploi" },
  { id: "formation", label: "Formation", keywords: "formation diplôme éducation skills" },
  { id: "publications", label: "Publications", keywords: "publications articles revues recherches" },
  { id: "distinctions", label: "Distinctions", keywords: "distinctions bourses awards prix" },
  { id: "service", label: "Service", keywords: "service affiliations consultant" },
  { id: "communications", label: "Communications", keywords: "communications conférences talks posters" },
];

const pubs = content?.publications ?? [];
---

<div id="searchOverlay" class="search-overlay" aria-hidden="true">
  <div class="search-modal" role="dialog" aria-label="Recherche">
    <div class="search-header">
      <div class="search-input-wrap">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input
          type="text"
          id="searchInput"
          class="search-input"
          placeholder="Rechercher une section, publication, compétence..."
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="search-kbd">ESC</kbd>
      </div>
    </div>
    <div class="search-body" id="searchResults">
      <div class="search-group">
        <p class="search-group-title">Sections</p>
        {sections.map(s => (
          <a href={`/#${s.id}`} class="search-item" data-type="section" data-keywords={s.keywords}>
            <span class="search-item-icon">§</span>
            <span class="search-item-label">{s.label}</span>
          </a>
        ))}
      </div>
      <div class="search-group">
        <p class="search-group-title">Publications ({pubs.length})</p>
        {pubs.map((pub: any) => (
          <a
            href={pub.url || (pub.doi ? `https://doi.org/${pub.doi}` : '#')}
            class="search-item"
            data-type="publication"
            data-keywords={`${pub.title} ${pub.journal} ${pub.authors} ${pub.year}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="search-item-icon">📄</span>
            <span class="search-item-label">{pub.title}</span>
            <span class="search-item-meta">{pub.journal} · {pub.year}</span>
          </a>
        ))}
      </div>
      <div class="search-group">
        <p class="search-group-title">Compétences</p>
        {(content?.skillGroups ?? []).flatMap((g: any) =>
          (g.tags ?? []).map((tag: string) => (
            <div class="search-item" data-type="skill" data-keywords={`${tag} ${g.category}`}>
              <span class="search-item-icon">◆</span>
              <span class="search-item-label">{tag}</span>
              <span class="search-item-meta">{g.category}</span>
            </div>
          ))
        )}
      </div>
      <div class="search-group">
        <p class="search-group-title">Expertises</p>
        {(content?.expertise ?? []).map((e: any) => (
          <a href="/#competences" class="search-item" data-type="expertise" data-keywords={`${e.title} ${e.description}`}>
            <span class="search-item-icon">✦</span>
            <span class="search-item-label">{e.title}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="search-empty" id="searchEmpty" style="display:none;">
      Aucun résultat trouvé.
    </div>
    <div class="search-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> naviguer</span>
      <span><kbd>↵</kbd> ouvrir</span>
      <span><kbd>esc</kbd> fermer</span>
    </div>
  </div>
</div>

  <nav class="nav" aria-label="Navigation principale">
    <a href="/#apropos">Profil</a>
    <a href="/#competences">Expertises</a>
    <a href="/#experience">Parcours</a>
    <a href="/#formation">Formation</a>
    <a href="/publications">Publications</a>
    <a href="/#distinctions">Distinctions</a>
    <a href="/contact">Contact</a>
  </nav>

<style>
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 7px;
    background: transparent;
    color: inherit;
    border: 1px solid var(--line);
    padding: 8px 12px;
    cursor: pointer;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .1em;
    transition: background .3s, border-color .3s, color .3s;
  }
  .search-trigger:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .search-trigger svg {
    width: 15px;
    height: 15px;
  }
  .search-trigger kbd {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .08em;
    border: 1px solid rgba(13,34,28,.2);
    padding: 2px 5px;
    border-radius: 3px;
    opacity: .6;
  }
  .search-trigger:hover kbd {
    border-color: rgba(244,239,227,.3);
    opacity: .7;
  }
  body.on-contact .search-trigger {
    border-color: var(--linelt);
    color: var(--paper);
  }
  body.on-contact .search-trigger:hover {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }

  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    background: rgba(10,26,21,.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
    opacity: 0;
    visibility: hidden;
    transition: opacity .25s, visibility .25s;
  }
  .search-overlay[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }
  .search-modal {
    background: var(--paper);
    border: 1px solid var(--line);
    width: 90%;
    max-width: 640px;
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 30px 80px rgba(13,34,28,.35);
    transform: translateY(12px) scale(.98);
    transition: transform .25s cubic-bezier(.2,.65,.15,1);
  }
  .search-overlay[aria-hidden="false"] .search-modal {
    transform: translateY(0) scale(1);
  }
  .search-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
  }
  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .search-icon {
    width: 20px;
    height: 20px;
    color: rgba(13,34,28,.4);
    flex-shrink: 0;
  }
  .search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: var(--body);
    font-size: 1rem;
    color: var(--ink);
    outline: none;
  }
  .search-input::placeholder {
    color: rgba(13,34,28,.4);
  }
  .search-kbd {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .08em;
    border: 1px solid var(--line);
    padding: 4px 8px;
    color: rgba(13,34,28,.45);
    flex-shrink: 0;
  }
  .search-body {
    overflow-y: auto;
    flex: 1;
    padding: 8px 0;
  }
  .search-group {
    padding: 4px 0;
  }
  .search-group-title {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(13,34,28,.45);
    padding: 8px 20px 4px;
  }
  .search-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px;
    cursor: pointer;
    transition: background .15s;
    text-decoration: none;
    color: inherit;
  }
  .search-item:hover,
  .search-item.active {
    background: rgba(217,151,43,.1);
  }
  .search-item-icon {
    width: 20px;
    text-align: center;
    font-size: .85rem;
    color: var(--coral);
    flex-shrink: 0;
  }
  .search-item-label {
    flex: 1;
    font-size: .92rem;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-item-meta {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .08em;
    color: rgba(13,34,28,.45);
    flex-shrink: 0;
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-empty {
    padding: 40px 20px;
    text-align: center;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: .1em;
    color: rgba(13,34,28,.45);
  }
  .search-footer {
    border-top: 1px solid var(--line);
    padding: 10px 20px;
    display: flex;
    gap: 20px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .08em;
    color: rgba(13,34,28,.45);
  }
  .search-footer kbd {
    font-family: var(--mono);
    font-size: 10px;
    border: 1px solid var(--line);
    padding: 1px 5px;
    margin-right: 4px;
    border-radius: 2px;
  }
  .search-item.hidden {
    display: none;
  }
  @media (max-width: 640px) {
    .search-overlay { padding-top: 6vh; }
    .search-modal { width: 95%; max-height: 80vh; }
    .search-footer { display: none; }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const overlay = document.getElementById("searchOverlay")!;
    const input = document.getElementById("searchInput") as HTMLInputElement;
    const results = document.getElementById("searchResults")!;
    const empty = document.getElementById("searchEmpty")!;
    const trigger = document.getElementById("searchTrigger")!;
    const items = () => Array.from(results.querySelectorAll<HTMLElement>(".search-item:not(.hidden)"));
    let activeIdx = -1;

    function open() {
      overlay.setAttribute("aria-hidden", "false");
      input.value = "";
      filter("");
      setTimeout(() => input.focus(), 100);
      document.body.style.overflow = "hidden";
    }

    function close() {
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    function filter(q: string) {
      const query = q.toLowerCase().trim();
      let visible = 0;
      results.querySelectorAll<HTMLElement>(".search-item").forEach(el => {
        const kw = (el.dataset.keywords || "").toLowerCase();
        const label = el.querySelector(".search-item-label")?.textContent?.toLowerCase() || "";
        const show = !query || kw.includes(query) || label.includes(query);
        el.classList.toggle("hidden", !show);
        if (show) visible++;
      });
      empty.style.display = visible === 0 ? "" : "none";
      activeIdx = -1;
      items().forEach(el => el.classList.remove("active"));
    }

    function navigate(dir: number) {
      const list = items();
      if (!list.length) return;
      list[activeIdx]?.classList.remove("active");
      activeIdx = (activeIdx + dir + list.length) % list.length;
      list[activeIdx].classList.add("active");
      list[activeIdx].scrollIntoView({ block: "nearest" });
    }

    function activate() {
      const list = items();
      if (activeIdx >= 0 && list[activeIdx]) {
        const link = list[activeIdx].getAttribute("href");
        if (link) {
          close();
          window.location.href = link;
        }
      }
    }

    trigger.addEventListener("click", open);
    overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });
    input.addEventListener("input", () => filter(input.value));

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); navigate(1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); navigate(-1); }
      else if (e.key === "Enter") { e.preventDefault(); activate(); }
      else if (e.key === "Escape") { close(); }
    });

    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "k") {
        e.preventDefault();
        if (overlay.getAttribute("aria-hidden") === "true") open();
        else close();
      }
    });
  });
</script>
