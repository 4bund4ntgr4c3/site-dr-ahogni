---
const isEn = Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");

interface VideoItem {
  id: string;
  title: string;
  category: string;
  date: string;
  duration: string;
  description: string;
  videoUrl: string;
  embedUrl: string;
  thumbnail: string;
}

const videosFr: VideoItem[] = [
  {
    id: "pamca-2025",
    title: "Surveillance génomique des anophèles et résistance aux moustiquaires PBO en Afrique de l'Ouest",
    category: "Conférence",
    date: "Conférence Annuelle PAMCA · 2025",
    duration: "24:15",
    description: "Présentation des données de terrain sur la dynamique évolutive des marqueurs de résistance kdr et CYP450 au Bénin.",
    videoUrl: "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
    embedUrl: "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ",
    thumbnail: "https://images.unsplash.com/photo-1576086213369-97a306d36557?auto=format&fit=crop&w=800&q=80",
  },
  {
    id: "who-consultation",
    title: "Directives opérationnelles pour l'évaluation des nouveaux insecticides dans les cases expérimentales",
    category: "Webinaire",
    date: "Consultation OMS / TDR · 2024",
    duration: "42:00",
    description: "Webinaire technique détaillant les protocoles de bio-essais et la gestion de la résistance aux insecticides de nouvelle génération.",
    videoUrl: "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
    embedUrl: "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ",
    thumbnail: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
  },
  {
    id: "ortb-interview",
    title: "Lutte contre le paludisme au Bénin : Enjeux de la saison des pluies et nouvelles technologies",
    category: "Média",
    date: "ORTB Télévision Nationale · 2024",
    duration: "15:30",
    description: "Éclairage scientifique sur les stratégies de distribution des moustiquaires bi-actives et l'engagement communautaire.",
    videoUrl: "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
    embedUrl: "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ",
    thumbnail: "https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=800&q=80",
  },
];

const videosEn: VideoItem[] = [
  {
    id: "pamca-2025",
    title: "Genomic Surveillance of Anophelines and PBO LLIN Resistance Dynamics in West Africa",
    category: "Conference",
    date: "PAMCA Annual Conference · 2025",
    duration: "24:15",
    description: "Field presentation on the evolutionary dynamics of kdr and CYP450 resistance markers in Benin.",
    videoUrl: "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
    embedUrl: "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ",
    thumbnail: "https://images.unsplash.com/photo-1576086213369-97a306d36557?auto=format&fit=crop&w=800&q=80",
  },
  {
    id: "who-consultation",
    title: "Operational Guidelines for Testing Next-Generation Insecticides in Experimental Huts",
    category: "Webinar",
    date: "WHO / TDR Expert Consultation · 2024",
    duration: "42:00",
    description: "Technical webinar covering standardized bioassay protocols and resistance management frameworks.",
    videoUrl: "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
    embedUrl: "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ",
    thumbnail: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80",
  },
  {
    id: "ortb-interview",
    title: "Malaria Control in Benin: Rainy Season Challenges and Next-Generation Vector Technologies",
    category: "Media",
    date: "ORTB National Television · 2024",
    duration: "15:30",
    description: "Expert interview detailing strategic dual-active net distribution and community adoption.",
    videoUrl: "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
    embedUrl: "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ",
    thumbnail: "https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=800&q=80",
  },
];

const videos = isEn ? videosEn : videosFr;
---

<section class="sec video-sec" id="videos">
  <div class="wrap">
    <div class="sec-head">
      <p class="sec-eyebrow" data-i18n="videogallery.eyebrow">{isEn ? "08 — Video Library & Lectures" : "08 — Vidéothèque & Enseignement"}</p>
      <h2 class="title lm" data-i18n-html="videogallery.title">
        <span class="ln"><span>{isEn ? "Recorded keynotes" : "Conférences enregistrées"}</span></span>
        <span class="ln"><span>{isEn ? <>&amp; audiovisual <span class="it">presentations</span></> : <>&amp; interventions <span class="it">audiovisuelles</span></>}</span></span>
      </h2>
      <p class="video-lede" data-i18n="videogallery.lede">
        {isEn
          ? "Curated selection of recorded webinars, international symposia keynotes, and scientific broadcast interviews."
          : "Sélection de webinaires, présentations en symposiums internationaux et entretiens de vulgarisation scientifique."}
      </p>
    </div>

    <div class="video-grid rv">
      {videos.map((v) => (
        <article class="vid-card">
          <div class="vid-thumb-box">
            <img src={v.thumbnail} alt={v.title} loading="lazy" />
            <span class="vid-dur">{v.duration}</span>
            <button
              type="button"
              class="vid-play-btn"
              data-vid-embed={v.embedUrl}
              data-vid-title={v.title}
              data-vid-desc={v.description}
              aria-label={isEn ? `Play video: ${v.title}` : `Lire la vidéo : ${v.title}`}
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </button>
          </div>
          <div class="vid-body">
            <div class="vid-meta">
              <span class="vid-cat">{v.category}</span>
              <span class="vid-date">{v.date}</span>
            </div>
            <h3>{v.title}</h3>
            <p>{v.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Modal Lecteur Vidéo -->
  <div id="videoModal" class="vid-modal" role="dialog" aria-modal="true" aria-label={isEn ? "Video player" : "Lecteur vidéo"} hidden>
    <div class="vm-overlay" data-close-vid="true"></div>
    <div class="vm-card">
      <div class="vm-head">
        <h4 id="vmTitle">Titre de la vidéo</h4>
        <button type="button" class="vm-close" id="vmCloseBtn" aria-label={isEn ? "Close video" : "Fermer la vidéo"}>✕</button>
      </div>
      <div class="vm-player-frame">
        <iframe id="vmIframe" src="" title={isEn ? "Scientific video player" : "Lecteur vidéo scientifique"} frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
      <p id="vmDesc" class="vm-desc"></p>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const playBtns = document.querySelectorAll<HTMLButtonElement>(".vid-play-btn");
    const modal = document.getElementById("videoModal");
    const overlay = document.querySelector(".vm-overlay");
    const closeBtn = document.getElementById("vmCloseBtn");
    const iframe = document.getElementById("vmIframe") as HTMLIFrameElement;
    const vmTitle = document.getElementById("vmTitle");
    const vmDesc = document.getElementById("vmDesc");

    function openVideo(embedUrl: string, title: string, desc: string) {
      if (modal && iframe && vmTitle && vmDesc) {
        iframe.src = `${embedUrl}?autoplay=1`;
        vmTitle.textContent = title;
        vmDesc.textContent = desc;
        modal.hidden = false;
        document.body.style.overflow = "hidden";
        closeBtn?.focus();
      }
    }

    function closeVideo() {
      if (modal && iframe) {
        iframe.src = "";
        modal.hidden = true;
        document.body.style.overflow = "";
      }
    }

    playBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const embed = btn.dataset.vidEmbed || "";
        const title = btn.dataset.vidTitle || "";
        const desc = btn.dataset.vidDesc || "";
        openVideo(embed, title, desc);
      });
    });

    closeBtn?.addEventListener("click", closeVideo);
    overlay?.addEventListener("click", closeVideo);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && !modal.hidden) closeVideo();
    });
  });
</script>

<style>
  .video-sec { padding: 90px 5vw; }
  .video-lede { max-width: 60ch; font-size: 1.08rem; color: var(--ink2); margin-top: 18px; line-height: 1.7; }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 26px;
    margin-top: 48px;
  }
  .vid-card {
    background: var(--paper);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform .3s, border-color .3s, box-shadow .3s;
  }
  .vid-card:hover {
    transform: translateY(-4px);
    border-color: var(--amber);
    box-shadow: 0 16px 36px rgba(0,0,0,0.08);
  }

  .vid-thumb-box {
    position: relative;
    aspect-ratio: 16/9;
    background: #000000;
    overflow: hidden;
  }
  .vid-thumb-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: transform .4s ease, opacity .3s;
  }
  .vid-card:hover .vid-thumb-box img {
    transform: scale(1.05);
    opacity: 0.95;
  }

  .vid-dur {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(11, 15, 23, 0.85);
    backdrop-filter: blur(4px);
    color: #FFFFFF;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 2px;
  }

  .vid-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--amber);
    color: #0B0F17;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0,0,0,0.4);
    transition: transform .25s ease, background .25s;
  }
  .vid-play-btn svg { width: 22px; height: 22px; margin-left: 3px; }
  .vid-play-btn:hover {
    transform: translate(-50%, -50%) scale(1.15);
    background: var(--amber2);
  }

  .vid-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .vid-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-family: var(--mono);
    font-size: 10.5px;
    text-transform: uppercase;
  }
  .vid-cat {
    color: var(--coral);
    font-weight: 700;
    letter-spacing: .1em;
  }
  .vid-date {
    color: var(--ink2);
    font-size: 10px;
  }
  .vid-body h3 {
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 10px;
    color: var(--ink);
  }
  .vid-body p {
    font-size: 0.9rem;
    color: var(--ink2);
    line-height: 1.5;
    margin-top: auto;
  }

  /* ── Modal Lecteur ── */
  .vid-modal {
    position: fixed;
    inset: 0;
    z-index: 3000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .vm-overlay {
    position: absolute;
    inset: 0;
    background: rgba(11, 15, 23, 0.88);
    backdrop-filter: blur(8px);
  }
  .vm-card {
    position: relative;
    width: 100%;
    max-width: 860px;
    background: #111827;
    border: 1px solid rgba(255,255,255,0.15);
    color: #F8FAFC;
    padding: 24px;
    box-shadow: 0 24px 60px rgba(0,0,0,0.6);
    z-index: 1;
  }
  .vm-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 16px;
  }
  .vm-head h4 {
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 600;
    color: #FFFFFF;
    line-height: 1.3;
  }
  .vm-close {
    background: none;
    border: none;
    color: #CBD5E1;
    font-size: 20px;
    cursor: pointer;
    padding: 4px;
    transition: color .2s;
  }
  .vm-close:hover { color: var(--amber2); }
  .vm-player-frame {
    width: 100%;
    aspect-ratio: 16/9;
    background: #000000;
    margin-bottom: 16px;
  }
  .vm-player-frame iframe {
    width: 100%;
    height: 100%;
  }
  .vm-desc {
    font-size: 0.92rem;
    color: #CBD5E1;
    line-height: 1.5;
    margin: 0;
  }
</style>
