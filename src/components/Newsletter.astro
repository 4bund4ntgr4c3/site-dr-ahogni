---
const isEn = Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");
---

<section class="nw sec" id="newsletter">
  <div class="wrap">
    <div class="nw-inner rv">
      <div class="nw-text">
        <p class="sec-eyebrow" data-i18n="nw.eyebrow">Newsletter</p>
        <h2 class="title lm">
          <span class="ln"><span data-i18n="nw.title1">{isEn ? "Field Research" : "Lettre d'information"}</span></span>
          <span class="ln"><span><span class="it" data-i18n="nw.title2">{isEn ? "Newsletter" : "du terrain"}</span></span></span>
        </h2>
        <p class="nw-desc" data-i18n="nw.desc">
          {isEn
            ? "Malaria operational research, vector control strategies, and genomics — once a month, strictly no spam."
            : "Recherche, lutte antivectorielle et actualités du paludisme — un e-mail par mois, sans spam."}
        </p>
      </div>
      <form id="nwForm" class="nw-form" data-i18n-aria="nw.aria">
        <label class="sr-only" for="nwEmail" data-i18n="nw.email">{isEn ? "Email address" : "Adresse e-mail"}</label>
        <input id="nwEmail" type="email" name="email" autocomplete="email" required maxlength="254" data-i18n-placeholder="nw.placeholder" placeholder={isEn ? "you@organization.org" : "vous@exemple.org"} />
        <button class="btn amber" type="submit" data-i18n="nw.cta">{isEn ? "Subscribe" : "S'abonner"}</button>
      </form>
      <p class="nw-msg" id="nwMsg" role="status" aria-live="polite"></p>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("nwForm") as HTMLFormElement | null;
    const input = document.getElementById("nwEmail") as HTMLInputElement | null;
    const msg = document.getElementById("nwMsg") as HTMLElement | null;
    if (!form || !input || !msg) return;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        msg.textContent = document.documentElement.lang === "fr" ? "Adresse e-mail invalide." : "Invalid email address.";
        msg.className = "nw-msg show ko";
        return;
      }
      msg.className = "nw-msg show";
      msg.textContent = document.documentElement.lang === "fr" ? "Inscription…" : "Subscribing…";
      const btn = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (btn) btn.disabled = true;
      try {
        const r = await fetch("/api/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        const data = await r.json().catch(() => ({}));
        if (r.ok && data.ok) {
          msg.textContent = document.documentElement.lang === "fr" ? "✓ Bienvenue ! Vérifiez votre boîte de réception." : "✓ Welcome! Check your inbox.";
          msg.className = "nw-msg show ok";
          input.value = "";
        } else if (data.error === "not_configured") {
          msg.textContent = document.documentElement.lang === "fr"
            ? "La newsletter sera bientôt disponible. Merci !"
            : "The newsletter is coming soon. Thank you!";
          msg.className = "nw-msg show";
        } else {
          throw new Error("bad");
        }
      } catch {
        msg.textContent = document.documentElement.lang === "fr"
          ? "✕ Une erreur est survenue. Réessayez dans quelques instants."
          : "✕ Something went wrong. Please try again shortly.";
        msg.className = "nw-msg show ko";
      }
      if (btn) btn.disabled = false;
    });
  });
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .nw-inner {
    border: 1px solid var(--line);
    background: var(--paper2);
    padding: clamp(32px, 6vw, 64px);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 32px;
    align-items: center;
  }
  .nw-desc { max-width: 46ch; color: var(--ink); margin-top: 18px; font-size: 1.02rem; line-height: 1.7; }
  .nw-form { display: flex; gap: 10px; flex-wrap: wrap; }
  .nw-form input {
    flex: 1;
    min-width: 200px;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: .04em;
    padding: 13px 16px;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    outline: none;
    transition: border-color .25s, box-shadow .25s;
  }
  .nw-form input:focus { border-color: var(--amber); box-shadow: 0 0 0 3px rgb(var(--rgb-amber) / .22); }
  .nw-msg { grid-column: 1 / -1; font-family: var(--mono); font-size: 11px; letter-spacing: .1em; color: var(--teal); min-height: 0; opacity: 0; }
  .nw-msg.show { opacity: 1; transition: opacity .3s; }
  .nw-msg.ok { color: var(--teal); }
  .nw-msg.ko { color: var(--coral); }
  @media (max-width: 820px) {
    .nw-inner { grid-template-columns: 1fr; gap: 22px; }
  }
</style>
