---
const quickQuestions = [
  { fr: "Pourquoi l'Interceptor G2 est-il efficace à Covè ?", en: "Why is Interceptor G2 effective in Covè?" },
  { fr: "Comment calculer la correction d'Abbott ?", en: "How is Abbott correction calculated?" },
  { fr: "Différence entre mutations kdr et ace-1 ?", en: "Difference between kdr and ace-1 mutations?" },
  { fr: "Quelles sont les stations sentinelles au Bénin ?", en: "What are the sentinel field stations in Benin?" },
  { fr: "Quel est le rôle synergiste du PBO ?", en: "What is the synergist role of PBO?" },
  { fr: "Menace de l'espèce Anopheles stephensi ?", en: "Threat of invasive Anopheles stephensi?" },
  { fr: "Comment dimensionner un échantillon (Fleiss) ?", en: "How to calculate sample size (Fleiss)?" },
  { fr: "Quels sont les critères d'audit BPL / GLP ?", en: "What are the WHO GLP audit criteria?" },
];

const kb = [
  {
    id: "g2-cove",
    category: { fr: "Moustiquaires & Innovations MILDV", en: "LLINs & Vector Innovations" },
    badge: "🛡️ MILDV G2",
    title: { fr: "Efficacité d'Interceptor® G2 (Chlorfénapyr + Alpha-cyperméthrine)", en: "Interceptor® G2 Efficacy (Chlorfenapyr + Alpha-cypermethrin)" },
    keywords: ["interceptor", "chlorfénapyr", "chlorfenapyr", "g2", "covè", "cove", "alpha-cypermethrine", "pro-drogue", "mitochondrie", "atp", "cases", "phase 2", "phase ii"],
    answer: {
      fr: "L'Interceptor® G2 associe l'alpha-cyperméthrine (pyréthroïde) et le chlorfénapyr (pyrrole). Le chlorfénapyr agit comme une pro-drogue activée par les cytochromes P450 qui découple la phosphorylation oxydative mitochondriale, stoppant net la production d'ATP chez l'anophèle. Aux stations expérimentales de Covè et d'Akron, les essais conduits par le Dr Ahogni ont démontré une mortalité supérieure à 85% sur les souches d'An. gambiae s.l. hautement résistantes.",
      en: "Interceptor® G2 combines alpha-cypermethrin (pyrethroid) and chlorfenapyr (pyrrole). Chlorfenapyr acts as a pro-drug activated by cytochrome P450 enzymes that uncouples oxidative phosphorylation in insect mitochondria, disrupting ATP production. In Covè and Akron experimental hut trials led by Dr Ahogni, it achieved >85% mortality against pyrethroid-resistant An. gambiae s.l."
    },
    link: "/#moustiquaires",
    linkText: { fr: "Consulter la Matrice MILDV", en: "View LLIN Matrix" }
  },
  {
    id: "royal-guard",
    category: { fr: "Moustiquaires & Innovations MILDV", en: "LLINs & Vector Innovations" },
    badge: "🛡️ Royal Guard",
    title: { fr: "Moustiquaire Royal Guard® (Pyriproxyfène + Pyréthroïde)", en: "Royal Guard® Net (Pyriproxyfen + Pyrethroid)" },
    keywords: ["royal guard", "pyriproxyfène", "pyriproxyfen", "ppf", "igr", "croissance", "stérilité", "fécondité", "ovaires"],
    answer: {
      fr: "La moustiquaire Royal Guard® associe l'alpha-cyperméthrine et le pyriproxyfène (PPF), un régulateur de croissance des insectes (IGR) analogue de l'hormone juvénile. Le PPF perturbe la métamorphose larvaire et induit la stérilisation irréversible des femelles anophèles ayant pris un repas sanguin, réduisant la taille de la population vectorielle globale.",
      en: "Royal Guard® combines alpha-cypermethrin with pyriproxyfen (PPF), a juvenile hormone mimic insect growth regulator (IGR). PPF disrupts larval metamorphosis and induces irreversible adult female sterilization after blood feeding, suppressing vector population density over time."
    },
    link: "/#moustiquaires",
    linkText: { fr: "Comparer les Technologies MILDV", en: "Compare LLIN Technologies" }
  },
  {
    id: "pbo-nets",
    category: { fr: "Moustiquaires & Synergistes", en: "LLINs & Synergists" },
    badge: "🧪 Synergiste PBO",
    title: { fr: "Mécanisme du Butoxyde de Pipéronyle (PBO)", en: "Mechanism of Piperonyl Butoxide (PBO)" },
    keywords: ["pbo", "synergiste", "butoxyde", "piperonyle", "p450", "cytochrome", "oxydase", "détoxification", "métabolique", "résistance"],
    answer: {
      fr: "Le Butoxyde de Pipéronyle (PBO) est un agent synergiste qui inhibe spécifiquement les enzymes Cytochromes P450 monooxygénases chez l'anophèle. En bloquant la détoxification métabolique des pyréthroïdes, les moustiquaires PBO restaurent la sensibilité létale du vecteur aux pyréthroïdes en zone de résistance métabolique.",
      en: "Piperonyl Butoxide (PBO) is a chemical synergist that specifically inhibits cytochrome P450 monooxygenase enzymes in Anopheles mosquitoes. By blocking metabolic pyrethroid degradation, PBO nets restore vector susceptibility in areas with elevated metabolic resistance."
    },
    link: "/#moustiquaires",
    linkText: { fr: "En savoir plus sur les Moustiquaires PBO", en: "Learn more about PBO Nets" }
  },
  {
    id: "abbott-formula",
    category: { fr: "Méthodologie & Bio-essais OMS", en: "Methodology & WHO Bioassays" },
    badge: "📐 Bio-essais OMS",
    title: { fr: "Formule de Correction d'Abbott & Interprétation", en: "Abbott's Formula Correction & Interpretation" },
    keywords: ["abbott", "correction", "formule", "bio-essai", "témoin", "mortalité", "tubes", "cônes", "invalidation", "seuil", "susceptibilité"],
    answer: {
      fr: "La formule d'Abbott corrige la mortalité observée dans les lots traités lorsque la mortalité témoin (non traité) est comprise entre 5% et 20% : Mortalité Corrigée (%) = [(% Testé - % Témoin) / (100 - % Témoin)] × 100. Si la mortalité témoin est < 5%, aucune correction n'est requise. Si elle dépasse 20%, le bio-essai est invalidé selon les normes OMS.",
      en: "Abbott's formula corrects observed mortality in treated arms when control mortality is between 5% and 20%: Corrected Mortality (%) = [(% Treated - % Control) / (100 - % Control)] × 100. If control mortality is < 5%, no correction is needed. If control mortality exceeds 20%, the bioassay is deemed invalid under WHO SOPs."
    },
    link: "/#entomologie",
    linkText: { fr: "Lancer le Simulateur de Bio-essais OMS", en: "Open WHO Bioassay Simulator" }
  },
  {
    id: "sample-size-fleiss",
    category: { fr: "Biostatistiques & Protocoles", en: "Biostatistics & Protocols" },
    badge: "📊 Calcul d'Échantillonnage",
    title: { fr: "Dimensionnement d'Échantillon selon Fleiss", en: "Sample Size Calculation via Fleiss Method" },
    keywords: ["échantillon", "taille", "dimensionnement", "fleiss", "puissance", "bio-essais", "effectif", "moustiques", "tubes", "bras", "sample size"],
    answer: {
      fr: "Le calculateur biométrique applique la formule de Fleiss avec correction de continuité pour déterminer le nombre requis d'anophèles par groupe d'étude (avec une puissance statistique de 80% et un seuil alpha de 5%). Il permet de convertir immédiatement l'effectif requis en nombre de tubes OMS standardisés (20-25 moustiques par tube).",
      en: "The biometric sample size tool uses Fleiss' equation with continuity correction to calculate the required number of mosquitoes per study arm (80% power, 5% alpha). It instantly converts sample needs into standardized WHO tube batches (20-25 mosquitoes per tube)."
    },
    link: "/#dimensionnement",
    linkText: { fr: "Ouvrir le Calculateur d'Échantillonnage", en: "Open Sample Size Calculator" }
