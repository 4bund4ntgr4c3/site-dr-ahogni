---

<!-- Bouton Flottant au-dessus de Back-To-Top -->
<button
  id="aiTriggerBtn"
  class="ai-float-btn"
  type="button"
  aria-label="Assistant de Recherche & Base de Connaissances Scientifique"
  title="Assistant de Recherche & Base de Connaissances Scientifique"
>
  <span class="ai-float-icon">🧬</span>
  <span class="ai-pulse-dot" aria-hidden="true"></span>
  <span class="ai-float-label" data-i18n="ai.floatLabel">Base Scientifique</span>
</button>

<!-- Widget / Panneau Déroulant de la Base de Connaissances -->
<div id="aiChatWidget" class="ai-widget-container" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="aiWidgetTitle">
  <div class="ai-widget-header">
    <div class="ai-widget-avatar-info">
      <div class="ai-widget-avatar">🔬</div>
      <div>
        <strong id="aiWidgetTitle" data-i18n="ai.widgetTitle">Dr Ahogni · Base de Connaissances</strong>
        <span class="ai-widget-status" data-i18n="ai.widgetStatus">● Moteur Sémantique Certifié · 0 ms · 100% Vérifié</span>
      </div>
    </div>
    <button type="button" id="aiCloseBtn" class="ai-widget-close" aria-label="Fermer l'assistant scientifique">✕</button>
  </div>

  <!-- Dialogue et Résultats -->
  <div class="ai-widget-messages" id="aiMessagesList">
    <div class="ai-msg bot">
      <div class="aim-bubble" data-i18n-html="ai.welcomeMsg">
        <p><strong>Bienvenue sur la Base de Connaissances du Dr Idelphonse Ahogni.</strong></p>
        <p style="margin-top:6px;font-size:0.88rem;color:var(--ink2);">Recherche sémantique instantanée sur 25+ publications, protocoles OMS, génétique des vecteurs (<em>kdr/ace-1</em>), moustiquaires MILDV, données de terrain et outils médico-économiques.</p>
      </div>
    </div>
  </div>

  <!-- Suggestions rapides -->
  <div class="ai-widget-quick-qs">
    <span class="aq-lbl" data-i18n="ai.quickLabel">Questions fréquentes & Suggestions :</span>
    <div class="aq-chips" id="aiQuickChips">
      {quickQuestions.map((q) => (
        <button type="button" class="aq-btn" data-q-fr={q.fr} data-q-en={q.en}>{q.fr}</button>
      ))}
    </div>
  </div>

  <!-- Formulaire de saisie -->
  <form class="ai-widget-input-bar" id="aiChatForm">
    <input
      type="text"
      id="aiQueryInput"
      placeholder="Ex: Interceptor G2, Abbott, kdr, Covè, Fleiss, BPL..."
      data-i18n-placeholder="ai.inputPlaceholder"
      autocomplete="off"
    />
    <button type="submit" class="btn amber ai-submit-btn" data-i18n="ai.btnSubmit" title="Rechercher">
      <span>→</span>
    </button>
  </form>
</div>

<script define:vars={{ kb }}>
  document.addEventListener("DOMContentLoaded", () => {
    const triggerBtn = document.getElementById("aiTriggerBtn");
    const widget = document.getElementById("aiChatWidget");
    const closeBtn = document.getElementById("aiCloseBtn");
    const chatForm = document.getElementById("aiChatForm");
    const queryInput = document.getElementById("aiQueryInput");
    const messagesList = document.getElementById("aiMessagesList");
    const qButtons = document.querySelectorAll(".aq-btn");

    function getLang() {
      return document.documentElement.lang === "en" ? "en" : "fr";
    }

    function openAssistant() {
      if (!widget) return;
      widget.classList.add("open");
      widget.setAttribute("aria-hidden", "false");
      triggerBtn?.classList.add("active");
      setTimeout(() => queryInput?.focus(), 150);
    }

    function closeAssistant() {
      if (!widget) return;
      widget.classList.remove("open");
      widget.setAttribute("aria-hidden", "true");
      triggerBtn?.classList.remove("active");
    }

    function toggleAssistant() {
      if (widget?.classList.contains("open")) {
        closeAssistant();
      } else {
        openAssistant();
      }
    }

    triggerBtn?.addEventListener("click", toggleAssistant);
    closeBtn?.addEventListener("click", closeAssistant);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && widget?.classList.contains("open")) {
        closeAssistant();
      }
    });

    // Interception des liens menant à #assistant-ia pour ouvrir le widget
    document.querySelectorAll('a[href*="#assistant-ia"]').forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        openAssistant();
      });
    });

    function cleanStr(s) {
      if (!s) return "";
      return s
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^\w\s]/g, " ")
        .trim();
    }

    const stopWords = new Set([
      "le", "la", "les", "un", "une", "des", "du", "de", "d", "en", "au", "aux",
      "pour", "par", "dans", "sur", "avec", "et", "ou", "qui", "que", "quoi",
      "comment", "pourquoi", "quel", "quelle", "quels", "quelles", "est", "sont",
      "a", "ce", "cet", "cette", "ces", "the", "a", "an", "and", "or", "in", "on",
      "for", "with", "is", "are", "what", "how", "why", "which", "does", "of", "to"
    ]);

    function addMessage(htmlContent, sender) {
      if (!messagesList) return;
      const msgDiv = document.createElement("div");
      msgDiv.className = `ai-msg ${sender}`;

      const bubble = document.createElement("div");
      bubble.className = "aim-bubble";
      bubble.innerHTML = htmlContent;

      msgDiv.appendChild(bubble);
      messagesList.appendChild(msgDiv);
      messagesList.scrollTop = messagesList.scrollHeight;
    }

    function searchKnowledgeBase(rawQuery) {
      const qClean = cleanStr(rawQuery);
      if (!qClean) return;

      const lang = getLang();

      // Message utilisateur
      addMessage(`<strong>${rawQuery.replace(/</g, "&lt;")}</strong>`, "user");

      const tokens = qClean
        .split(/\s+/)
        .filter((t) => t.length >= 2 && !stopWords.has(t));

      setTimeout(() => {
        const scoredItems = [];

        kb.forEach((item) => {
          let score = 0;
          const itemKeywords = (item.keywords || []).map(cleanStr);
          const titleFr = cleanStr(item.title?.fr || "");
          const titleEn = cleanStr(item.title?.en || "");
          const catFr = cleanStr(item.category?.fr || "");
          const catEn = cleanStr(item.category?.en || "");
          const ansFr = cleanStr(item.answer?.fr || "");
          const ansEn = cleanStr(item.answer?.en || "");

          tokens.forEach((token) => {
            // Correspondance exacte dans mots-clés
            if (itemKeywords.includes(token)) score += 10;
            // Correspondance partielle dans mots-clés
            else if (itemKeywords.some((kw) => kw.includes(token) || token.includes(kw))) score += 6;

            // Correspondance dans le titre
            if (titleFr.includes(token) || titleEn.includes(token)) score += 8;

            // Correspondance dans la catégorie
            if (catFr.includes(token) || catEn.includes(token)) score += 5;

            // Correspondance dans le texte de la réponse
            if (ansFr.includes(token) || ansEn.includes(token)) score += 3;
          });

          if (score > 0) {
            scoredItems.push({ item, score });
          }
        });

        scoredItems.sort((a, b) => b.score - a.score);

        const isEn = lang === "en";
        const pfx = isEn ? "/en" : "";
        const formatLink = (l) => {
          if (!l) return "#";
          if (l.startsWith("/#")) return isEn ? "/en" + l.slice(1) : l;
          if (l.startsWith("/")) return pfx + l;
          return l;
        };

        if (scoredItems.length > 0) {
          const top = scoredItems[0].item;
          const cat = top.category[lang] || top.category.fr;
          const title = top.title[lang] || top.title.fr;
          const ans = top.answer[lang] || top.answer.fr;
          const lText = top.linkText[lang] || top.linkText.fr;
          const topLink = formatLink(top.link);

          let resHtml = `
            <div class="aim-badge-bar">
              <span class="aim-badge">${top.badge || "🔬"} ${cat}</span>
            </div>
            <h4 class="aim-title">${title}</h4>
            <p class="aim-text">${ans}</p>
            <a href="${topLink}" class="aim-link">🔗 ${lText} →</a>
          `;

          // Suggestions secondaires si plusieurs résultats très pertinents
          if (scoredItems.length > 1 && scoredItems[1].score >= 6) {
            const second = scoredItems[1].item;
            const secondTitle = second.title[lang] || second.title.fr;
            const secondLink = second.linkText[lang] || second.linkText.fr;
            const secondHref = formatLink(second.link);
            resHtml += `
              <div class="aim-related">
                <span class="aim-rel-lbl">${lang === "en" ? "Related Topic:" : "Sujet Connexe :"}</span>
                <a href="${secondHref}" class="aim-rel-link">${second.badge || "📄"} ${secondTitle} →</a>
              </div>
            `;
          }

          addMessage(resHtml, "bot");
        } else {
          const notFoundHtml = lang === "en"
            ? `<p>No direct match was found in the indexed knowledge base for <em>"${rawQuery.replace(/</g, "&lt;")}"</em>.</p>
               <p style="margin-top:6px;font-size:0.88rem;color:var(--ink2);">For specialized data audits, consulting missions, or customized scientific inquiries, you can reach Dr Idelphonse Ahogni directly:</p>
               <a href="/en/contact" class="aim-link">✉️ Contact Dr Ahogni →</a>`
            : `<p>Aucune correspondance directe n'a été trouvée dans la base de connaissances indexée pour <em>"${rawQuery.replace(/</g, "&lt;")}"</em>.</p>
               <p style="margin-top:6px;font-size:0.88rem;color:var(--ink2);">Pour une analyse détaillée de vos données, une mission d'évaluation ou une collaboration scientifique, vous pouvez contacter directement le Dr Idelphonse Ahogni :</p>
               <a href="/contact" class="aim-link">✉️ Contacter le Dr Ahogni →</a>`;

          addMessage(notFoundHtml, "bot");
        }
      }, 150);
    }

    chatForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const val = queryInput?.value || "";
      if (!val.trim()) return;
      searchKnowledgeBase(val);
      if (queryInput) queryInput.value = "";
    });

    qButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const lang = getLang();
        const q = lang === "en" ? btn.dataset.qEn : btn.dataset.qFr;
        if (q) searchKnowledgeBase(q);
      });
    });

    // Mise à jour de la langue des suggestions rapides lors de la bascule FR/EN
    function updateQuickChipsLang() {
      const lang = getLang();
      qButtons.forEach((btn) => {
        btn.textContent = lang === "en" ? btn.dataset.qEn : btn.dataset.qFr;
      });
    }

    document.querySelectorAll("#langSwitch, #langSwitchPanel").forEach((sw) => {
      sw.addEventListener("click", () => setTimeout(updateQuickChipsLang, 50));
    });
    updateQuickChipsLang();
  });
</script>

