---
import { sanityClient } from "sanity:client";
import { createImageUrlBuilder } from "@sanity/image-url";
import { SETTINGS_QUERY, CONTENT_QUERY, cachedFetch } from "../lib/queries";
import Calendly from "./Calendly.astro";
import "../styles/contact.css";

const settings = await cachedFetch(sanityClient, SETTINGS_QUERY);
const content = await cachedFetch(sanityClient, CONTENT_QUERY);
const urlFor = (source: any) => sanityClient.config().projectId ? createImageUrlBuilder({ projectId: sanityClient.config().projectId!, dataset: sanityClient.config().dataset! }).image(source) : null;
const officeImg = settings?.officeImage ? urlFor(settings.officeImage)?.width(800).auto("format").quality(80).url() : null;
---

<section class="cpage">
  <svg class="deco-mosq" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <path d="M45 60 Q30 50 18 30"/><path d="M47 66 Q28 66 12 58"/><path d="M50 72 Q36 84 24 98"/>
    <path d="M62 72 Q70 88 88 100"/><path d="M64 66 Q84 70 98 62"/><path d="M62 60 Q80 50 96 34"/>
    <ellipse cx="70" cy="52" rx="20" ry="7" transform="rotate(-32 70 52)"/>
    <ellipse cx="52" cy="62" rx="9" ry="8"/><circle cx="44" cy="68" r="5"/><path d="M40 72 L26 84"/>
  </svg>
  <div class="cpage-head">
    <p class="sec-eyebrow">Contacter le Dr Idelphonse B. AHOGNI</p>
    <h1 class="lm"><span class="ln"><span>Travaillons <span class="it">ensemble</span> contre</span></span><span class="ln"><span>le paludisme.</span></span></h1>
    <p class="lead">{content?.contactLead}</p>
    <p class="avail"><span class="dot"></span> Disponible — réponse sous 48 h ouvrées</p>
  </div>

  <div class="ccontent">
    <div class="cgrid">
    <!-- FORMULAIRE -->
    <form id="cform" class="cform rv" name="contact" method="POST" action="/api/contact" netlify-honeypot="bot-field" data-contact-email={settings?.contactEmail || "contact@idelphonseahogni.com"}>
      <span class="corner c-tl"></span><span class="corner c-tr"></span><span class="corner c-bl"></span><span class="corner c-br"></span>
      <h3>Envoyer un message</h3>
      <input type="hidden" name="form-name" value="contact">
      <p class="hpot" aria-hidden="true" style="display:none!important">
        <label>Ne pas remplir si vous êtes humain&nbsp;: <input name="bot-field"></label>
      </p>
      <p class="fsub">Les champs marqués <b style="color:var(--coral)">*</b> sont obligatoires. Votre message sera envoyé de façon sécurisée et vous recevrez une réponse sous 48 h ouvrées.</p>
      <div class="f-row">
        <div class="field" id="f-name">
          <label for="c-name">Nom complet <b>*</b></label>
          <input id="c-name" name="name" type="text" autocomplete="name" placeholder="Dr Awa Diallo">
          <span class="err">Veuillez saisir votre nom.</span>
        </div>
        <div class="field" id="f-email">
          <label for="c-email">Adresse e-mail <b>*</b></label>
          <input id="c-email" name="email" type="email" autocomplete="email" placeholder="vous@organisation.org">
          <span class="err">Adresse e-mail invalide.</span>
        </div>
      </div>
      <div class="f-row">
        <div class="field">
          <label for="c-org">Organisation</label>
          <input id="c-org" name="org" type="text" autocomplete="organization" placeholder="Ministère, ONG, université…">
        </div>
        <div class="field">
          <label for="c-subj">Objet de la demande</label>
          <select id="c-subj" name="subject">
            {content?.contactSubjects?.map((subj: string) => <option>{subj}</option>)}
          </select>
        </div>
      </div>
      <div class="field" id="f-msg">
        <label for="c-msg">Message <b>*</b></label>
        <span class="count" id="c-count">0 / 1000</span>
        <textarea id="c-msg" name="message" maxlength="1000" placeholder="Décrivez votre demande : contexte, échéances, pays concernés…"></textarea>
        <span class="err">Merci de détailler votre message (20 caractères min.).</span>
      </div>
      <button class="btn amber" type="submit" style="width:100%;justify-content:center">Envoyer le message ↗</button>
      <p class="form-msg" id="c-msgstate" role="status" aria-live="polite"></p>
    </form>

    <!-- INFOS & CONTACT CARD -->
    <aside class="cinfo">
      <!-- vCard & QR Code Card -->
      <div class="icard vcard-box rv">
        <span class="k">Carte de visite numérique</span>
        <div class="vcard-actions">
          <a class="btn vcf-btn" href="/contact.vcf" download="Dr_Idelphonse_AHOGNI.vcf" title="Télécharger la fiche contact pour smartphone ou Outlook">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Enregistrer contact (.vcf)
          </a>
          <button type="button" class="btn ghost qr-trigger" id="qrOpenBtn" title="Afficher le QR code à scanner sur smartphone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            QR Code
          </button>
        </div>
        <span class="sub">Compatible iPhone, Android, Outlook &amp; Carnet d'adresses</span>
      </div>

      <div class="icard rv">
        <span class="k">E-mail</span>
        <span class="v"><a href={`mailto:${settings?.contactEmail}`}>{settings?.contactEmail}</a></span>
        <span class="sub">Canal privilégié — pièces jointes bienvenues</span>
      </div>
      <div class="icard rv">
        <span class="k">Téléphone / WhatsApp</span>
        <span class="v"><a href={settings?.contactPhoneLink}>{settings?.contactPhone}</a></span>
        <span class="sub">Lun – Ven · 8 h – 18 h GMT+1</span>
      </div>
      <div class="icard rv">
        <span class="k">Heure locale à Cotonou</span>
        <span class="clock-time" id="cot-clock">--:--:--</span>
        <span class="sub">Cotonou, Bénin · 6°22′N — 2°23′E · GMT+1</span>
      </div>
      <div class="icard rv">
        <span class="k">Langues &amp; réseaux</span>
        <span class="v">Français &amp; Fon (natifs) · Anglais (scientifique)</span>
        <span class="sub">
          {settings?.linkedin && settings?.linkedin !== "#" && <a href={settings.linkedin} style="color:var(--amber2)" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>}
          {settings?.linkedin && settings?.linkedin !== "#" && settings?.researchGate !== "#" && settings?.researchGate && " · "}
          {settings?.researchGate && settings?.researchGate !== "#" && <a href={settings.researchGate} style="color:var(--amber2)" target="_blank" rel="noopener noreferrer">ResearchGate ↗</a>}
          {settings?.orcid && settings?.orcid !== "#" && (settings?.researchGate && settings?.researchGate !== "#" ? " · " : "")}
          {settings?.orcid && settings?.orcid !== "#" && <a href={settings.orcid} style="color:var(--amber2)" target="_blank" rel="noopener noreferrer">ORCID ↗</a>}
          {settings?.googleScholar && settings?.googleScholar !== "#" && <><span> · </span><a href={settings.googleScholar} style="color:var(--amber2)" target="_blank" rel="noopener noreferrer">Scholar ↗</a></>}
        </span>
      </div>
      <div style="margin-top:2px"><Calendly /></div>
      {officeImg && (
        <figure class="cfig rv">
          <img src={officeImg} alt="Bureau de travail à Cotonou" loading="lazy" decoding="async">
          <figcaption>
            <span>{settings?.officeFigCaption?.left}</span>
            <span>{settings?.officeFigCaption?.right}</span>
          </figcaption>
        </figure>
      )}
    </aside>
  </div>

  <!-- FAQ -->
  {content?.faq?.length > 0 && (
    <div class="faq">
      <h3 class="faq-t rv">Questions fréquentes</h3>
      {content.faq.map((item: { question: string; answer: string }) => (
        <details class="rv">
          <summary>{item.question}<span class="pl" aria-hidden="true"></span></summary>
          <div class="faq-a"><div class="faq-a-in"><p class="a">{item.answer}</p></div></div>
        </details>
      ))}
    </div>
  )}

  </div><!-- /ccontent -->

  <!-- Modal QR Code -->
  <div id="qrModal" class="qr-modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Scanner la carte de visite numérique">
    <div class="qr-card">
      <div class="qr-head">
        <h3>Scanner le contact</h3>
        <button type="button" class="qr-close" id="qrCloseBtn" aria-label="Fermer">✕</button>
      </div>
      <div class="qr-graphic">
        <svg viewBox="0 0 200 200" class="qr-svg" aria-label="QR Code vCard Dr Idelphonse Ahogni">
          <rect width="200" height="200" fill="#F4EFE3"/>
          <!-- Position Detection Patterns (Corners) -->
          <rect x="20" y="20" width="45" height="45" fill="#0D221C"/>
          <rect x="27" y="27" width="31" height="31" fill="#F4EFE3"/>
          <rect x="34" y="34" width="17" height="17" fill="#0D221C"/>

          <rect x="135" y="20" width="45" height="45" fill="#0D221C"/>
          <rect x="142" y="27" width="31" height="31" fill="#F4EFE3"/>
          <rect x="149" y="34" width="17" height="17" fill="#0D221C"/>

          <rect x="20" y="135" width="45" height="45" fill="#0D221C"/>
          <rect x="27" y="142" width="31" height="31" fill="#F4EFE3"/>
          <rect x="34" y="149" width="17" height="17" fill="#0D221C"/>

          <!-- Decorative Matrix Modules representing Dr Ahogni vCard -->
          <rect x="75" y="25" width="10" height="10" fill="#0D221C"/>
          <rect x="95" y="25" width="10" height="10" fill="#0D221C"/>
          <rect x="115" y="25" width="10" height="10" fill="#0D221C"/>
          <rect x="75" y="45" width="10" height="10" fill="#0D221C"/>
          <rect x="85" y="55" width="10" height="10" fill="#0D221C"/>
          <rect x="105" y="45" width="10" height="10" fill="#0D221C"/>
          <rect x="115" y="55" width="10" height="10" fill="#0D221C"/>

          <rect x="25" y="75" width="10" height="10" fill="#0D221C"/>
          <rect x="45" y="75" width="10" height="10" fill="#0D221C"/>
          <rect x="35" y="85" width="10" height="10" fill="#0D221C"/>
          <rect x="55" y="85" width="10" height="10" fill="#0D221C"/>

          <rect x="75" y="75" width="50" height="50" fill="#C4503B"/>
          <rect x="85" y="85" width="30" height="30" fill="#F4EFE3"/>
          <text x="100" y="105" font-family="'Fraunces Variable', Georgia, serif" font-weight="700" font-size="14" fill="#C4503B" text-anchor="middle">IA</text>

          <rect x="135" y="75" width="10" height="10" fill="#0D221C"/>
          <rect x="155" y="75" width="10" height="10" fill="#0D221C"/>
          <rect x="145" y="85" width="10" height="10" fill="#0D221C"/>
          <rect x="165" y="85" width="10" height="10" fill="#0D221C"/>

          <rect x="75" y="135" width="10" height="10" fill="#0D221C"/>
          <rect x="95" y="135" width="10" height="10" fill="#0D221C"/>
          <rect x="115" y="135" width="10" height="10" fill="#0D221C"/>
          <rect x="85" y="145" width="10" height="10" fill="#0D221C"/>
          <rect x="105" y="145" width="10" height="10" fill="#0D221C"/>
          <rect x="75" y="155" width="10" height="10" fill="#0D221C"/>
          <rect x="115" y="155" width="10" height="10" fill="#0D221C"/>
          <rect x="95" y="165" width="10" height="10" fill="#0D221C"/>

          <rect x="135" y="135" width="10" height="10" fill="#0D221C"/>
          <rect x="155" y="135" width="10" height="10" fill="#0D221C"/>
          <rect x="145" y="145" width="10" height="10" fill="#0D221C"/>
          <rect x="165" y="155" width="10" height="10" fill="#0D221C"/>
          <rect x="135" y="165" width="10" height="10" fill="#0D221C"/>
        </svg>
      </div>
      <p class="qr-desc">Scannez ce code avec l'appareil photo de votre smartphone pour enregistrer directement le <b>Dr Idelphonse AHOGNI</b> dans vos contacts.</p>
      <div class="qr-foot">
        <a class="btn amber" href="/contact.vcf" download="Dr_Idelphonse_AHOGNI.vcf">Télécharger .vcf direct</a>
      </div>
    </div>
  </div>

  <div class="cfoot">
    <span>© 2026 Dr I. B. Ahogni, PhD · Cotonou, Bénin</span>
    <a href="/">← Retour au site</a>
  </div>
</section>

<style>
  .vcard-box {
    background: var(--paper2);
    border-left: 3px solid var(--amber);
  }
  .vcard-actions {
    display: flex;
    gap: 8px;
    margin: 10px 0 6px;
    flex-wrap: wrap;
  }
  .vcf-btn {
    font-size: 11px;
    padding: 8px 14px;
    background: var(--ink);
    color: var(--paper);
  }
  .vcf-btn svg, .qr-trigger svg { width: 14px; height: 14px; }
  .vcf-btn:hover { background: var(--amber); color: var(--ink3); }

  /* ── Modal QR Code ── */
  .qr-modal-overlay {
    position: fixed; inset: 0; z-index: 2000;
    background: rgba(10, 26, 21, 0.75);
    backdrop-filter: blur(8px);
    display: none; align-items: center; justify-content: center;
    padding: 20px;
  }
  .qr-modal-overlay.open { display: flex; }
  .qr-card {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--ink);
    width: 100%; max-width: 440px;
    padding: 28px;
    box-shadow: 0 20px 50px rgba(0,0,0,.4);
    text-align: center;
  }
  html[data-theme="dark"] .qr-card {
    background: var(--ink3);
    color: var(--paper);
    border-color: var(--linelt);
  }
  .qr-head {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 20px;
  }
  .qr-head h3 {
    font-family: var(--display); font-size: 1.25rem; font-weight: 600;
  }
  .qr-close {
    background: transparent; border: none; font-size: 18px;
    cursor: pointer; color: inherit; opacity: .7; transition: opacity .2s;
  }
  .qr-close:hover { opacity: 1; }
  .qr-graphic {
    background: #F4EFE3;
    padding: 16px;
    border: 1px solid var(--line);
    display: inline-block;
    margin-bottom: 16px;
    box-shadow: 0 4px 14px rgba(0,0,0,.08);
  }
  .qr-svg { width: 180px; height: 180px; display: block; }
  .qr-desc {
    font-size: 0.92rem; line-height: 1.6;
    color: rgb(var(--rgb-ink) / .8);
    margin-bottom: 20px;
  }
  html[data-theme="dark"] .qr-desc { color: rgba(244,239,227,.8); }
  .qr-foot { display: flex; justify-content: center; }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const RM = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const faqs = Array.from(document.querySelectorAll<HTMLDetailsElement>(".faq details"));
    faqs.forEach((d) => {
      const inner = d.querySelector<HTMLElement>(".faq-a-in");
      if (!inner) return;
      d.addEventListener("toggle", () => {
        if (d.open) {
          faqs.forEach((o) => { if (o !== d && o.open) o.open = false; });
          inner.style.maxHeight = RM ? "none" : inner.scrollHeight + "px";
          inner.style.opacity = "1";
          inner.style.transform = "translateY(0)";
        } else {
          inner.style.maxHeight = "0px";
          inner.style.opacity = "0";
          inner.style.transform = "translateY(-4px)";
        }
      });
    });

    // ── Gestion QR Modal ──
    const qrModal = document.getElementById("qrModal") as HTMLElement;
    const qrOpenBtn = document.getElementById("qrOpenBtn");
    const qrCloseBtn = document.getElementById("qrCloseBtn");

    function openQr() {
      if (qrModal) {
        qrModal.classList.add("open");
        qrModal.setAttribute("aria-hidden", "false");
      }
    }
    function closeQr() {
      if (qrModal) {
        qrModal.classList.remove("open");
        qrModal.setAttribute("aria-hidden", "true");
      }
    }

    qrOpenBtn?.addEventListener("click", openQr);
    qrCloseBtn?.addEventListener("click", closeQr);
    qrModal?.addEventListener("click", (e) => {
      if (e.target === qrModal) closeQr();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && qrModal?.classList.contains("open")) closeQr();
    });
  });
</script>
