---
interface Student {
  name: string;
  degree: "Doctorat (PhD)" | "Master 2 Recherche" | "Ingénieur de Santé Publique";
  year: string;
  institution: string;
  topic: string;
  currentRole: string;
}

const students: Student[] = [
  {
    name: "Dr Sylvain K. Houndété",
    degree: "Doctorat (PhD)",
    year: "2024",
    institution: "Université d'Abomey-Calavi (UAC) / CREC",
    topic: "Dynamique spatiale de la multirésistance (kdr/ace-1) chez Anopheles coluzzii dans les agrosystèmes maraîchers du sud-Bénin.",
    currentRole: "Chercheur Post-doctoral, LSHTM & Consultant OMS",
  },
  {
    name: "Aimé R. Tossou",
    degree: "Master 2 Recherche",
    year: "2023",
    institution: "Faculté des Sciences et Techniques (FAST / UAC)",
    topic: "Évaluation de la bio-efficacité rémanente des moustiquaires Interceptor G2 après 24 mois d'usage en communauté.",
    currentRole: "Responsable Entomologiste de Terrain, Projet VectorLink",
  },
  {
    name: "Béatrice F. Agbo",
    degree: "Master 2 Recherche",
    year: "2022",
    institution: "École Doctorale Sciences de la Vie et de la Terre (UAC)",
    topic: "Caractérisation enzymatique des Cytochromes P450 chez les populations d'Anopheles funestus de saison sèche.",
    currentRole: "Doctorante boursière, Institut Pasteur / PAMCA Fellow",
  },
  {
    name: "Dr Christian M. Gbaguidi",
    degree: "Doctorat (PhD)",
    year: "2021",
    institution: "Université d'Abomey-Calavi / IRSS",
    topic: "Impact des mutations du gène Vgsc sur le comportement d'évitement et la survie d'Anopheles gambiae sous moustiquaires PBO.",
    currentRole: "Chargé de Recherche au CREC & Enseignant vacataire UAC",
  },
];
---

<section class="sec mentor-sec" id="mentorat">
  <div class="wrap">
    <div class="sec-head">
      <p class="sec-eyebrow" data-i18n="mentor.eyebrow">10 — Transmission &amp; Nouvelle Génération</p>
      <h2 class="title lm">
        <span class="ln"><span>Encadrement académique</span></span>
        <span class="ln"><span>&amp; réseau des <span class="it">chercheurs formés</span></span></span>
      </h2>
      <p class="mentor-lede">
        Formation par la recherche, co-direction de thèses de doctorat et mémoires de master en entomologie médicale et santé publique.
      </p>
    </div>

    <!-- Grille des diplômés encadrés -->
    <div class="mentor-grid rv">
      {students.map((st) => (
        <article class="mentor-card">
          <div class="mentor-top">
            <span class={`mentor-degree-badge ${st.degree.includes("PhD") ? "phd" : "master"}`}>{st.degree}</span>
            <span class="mentor-year">{st.year} · {st.institution.split("/")[0]}</span>
          </div>

          <h3>{st.name}</h3>
          <p class="mentor-topic"><strong>Thème de recherche :</strong> « {st.topic} »</p>

          <div class="mentor-current">
            <span class="mc-lbl">Poste &amp; Devenir actuel :</span>
            <span class="mc-val">📍 {st.currentRole}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .mentor-sec { padding: 90px 5vw; background: var(--paper); border-top: 1px solid var(--line); }
  .mentor-lede { max-width: 62ch; font-size: 1.08rem; color: var(--ink2); margin-top: 18px; line-height: 1.7; }

  .mentor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    margin-top: 48px;
  }
  .mentor-card {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform .3s, border-color .3s, box-shadow .3s;
  }
  .mentor-card:hover {
    transform: translateY(-4px);
    border-color: var(--amber);
    box-shadow: 0 14px 34px rgba(0,0,0,0.08);
  }

  .mentor-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .mentor-degree-badge {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 4px 8px;
  }
  .mentor-degree-badge.phd { background: rgba(217, 130, 24, 0.15); color: var(--amber); }
  .mentor-degree-badge.master { background: rgba(13, 148, 136, 0.15); color: var(--teal); }

  .mentor-year { font-family: var(--mono); font-size: 10.5px; color: var(--ink2); }

  .mentor-card h3 {
    font-family: var(--display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .mentor-topic {
    font-size: 0.92rem;
    color: var(--ink2);
    line-height: 1.55;
    margin-bottom: 20px;
  }
  .mentor-topic strong { color: var(--ink); }

  .mentor-current {
    background: var(--paper);
    border-left: 3px solid var(--teal);
    padding: 12px 16px;
    margin-top: auto;
  }
  .mc-lbl {
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--teal);
    display: block;
    margin-bottom: 4px;
  }
  .mc-val { font-size: 0.88rem; color: var(--ink); font-weight: 600; }

  @media (max-width: 640px) {
    .mentor-card { padding: 22px 16px; }
  }
</style>
