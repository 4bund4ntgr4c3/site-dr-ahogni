const fundedProjects = isEn ? fundedProjectsEn : fundedProjectsFr;
---

<section class="sec prj-timeline-sec" id="timeline-projets">
  <div class="wrap">
    <div class="sec-head">
      <p class="sec-eyebrow" data-i18n="timeline.eyebrow">{isEn ? "04 — Grants & Operational Research" : "04 — Financements & Recherche Opérationnelle"}</p>
      <h2 class="title lm" data-i18n-html="timeline.title">
        <span class="ln"><span>{isEn ? "Funded research" : "Programmes de recherche"}</span></span>
        <span class="ln"><span>{isEn ? <>programs &amp; <span class="it">grants</span></> : <>&amp; projets <span class="it">financés</span></>}</span></span>
      </h2>
      <p class="ptl-lede" data-i18n="timeline.lede">
        {isEn
          ? "Translational research grants and large-scale operational trials conducted in partnership with international funding bodies and Ministries of Health."
          : "Projets de recherche translationnelle et d'évaluation opérationnelle conduits avec les agences de financement internationales et les ministères de la santé."}
      </p>
    </div>

    <!-- Filtres Bailleurs -->
    <div class="ptl-filters">
      <button class="ptl-fbtn active" data-ptl-filter="all" data-i18n="timeline.filterAll">{isEn ? `All programs (${fundedProjects.length})` : `Tous les programmes (${fundedProjects.length})`}</button>
      <button class="ptl-fbtn" data-ptl-filter="global-fund">Global Fund</button>
      <button class="ptl-fbtn" data-ptl-filter="usaid-pmi">USAID / PMI</button>
      <button class="ptl-fbtn" data-ptl-filter="who-tdr">WHO / TDR</button>
      <button class="ptl-fbtn" data-ptl-filter="wellcome">Wellcome Trust</button>
    </div>

    <!-- Liste chronologique -->
    <div class="ptl-timeline rv">
      {fundedProjects.map((p, idx) => (
        <div class="ptl-item" data-funder={p.funderKey}>
          <div class="ptl-node">
            <span class="ptl-dot"></span>
            <span class="ptl-period">{p.period}</span>
          </div>
          <article class="ptl-card">
            <div class="ptl-top">
              <div class="ptl-badges">
                <span class="ptl-funder-badge">{p.funderBadge}</span>
                <span class={`ptl-status-badge ${p.status === "En cours" || p.status === "Ongoing" ? "ongoing" : "done"}`}>{p.status}</span>
              </div>
              <span class="ptl-loc">📍 {p.location}</span>
            </div>

            <h3>{p.title}</h3>
            <p class="ptl-role"><strong data-i18n="timeline.lblRole">{isEn ? "Role:" : "Rôle :"}</strong> {p.role}</p>
            <p class="ptl-desc">{p.description}</p>

            <div class="ptl-deliverables">
              <span class="ptl-deliv-title" data-i18n="timeline.lblDeliv">{isEn ? "Deliverables & Key Impacts:" : "Livrables & Impacts clés :"}</span>
              <ul>
                {p.deliverables.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const fbtns = document.querySelectorAll<HTMLButtonElement>(".ptl-fbtn");
    const items = document.querySelectorAll<HTMLElement>(".ptl-item");

    fbtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        fbtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const filter = btn.dataset.ptlFilter || "all";
        items.forEach((it) => {
          it.style.display = (filter === "all" || it.dataset.funder === filter) ? "" : "none";
        });
      });
    });
  });
</script>

<style>
  .prj-timeline-sec { padding: 90px 5vw; background: var(--surface); border-top: 1px solid var(--line); }
  .ptl-lede { max-width: 62ch; font-size: 1.08rem; color: var(--ink2); margin-top: 18px; line-height: 1.7; }

  .ptl-filters {
    display: flex;
    gap: 10px;
    margin: 36px 0 40px;
    flex-wrap: wrap;
  }
  .ptl-fbtn {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    background: var(--paper);
    color: var(--ink);
    border: 1.5px solid var(--line);
    padding: 10px 16px;
    cursor: pointer;
    transition: all .25s ease;
  }
  .ptl-fbtn:hover { border-color: var(--amber); }
  .ptl-fbtn.active {
    background: var(--amber);
    color: #0B0F17;
    border-color: var(--amber);
    font-weight: 700;
  }

  .ptl-timeline {
    position: relative;
    padding-left: 32px;
    border-left: 2px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ptl-item { position: relative; }
  .ptl-node {
    position: absolute;
    left: -43px;
    top: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ptl-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--amber);
    border: 4px solid var(--surface);
    box-shadow: 0 0 0 1px var(--amber);
  }
  .ptl-period {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .1em;
    color: var(--coral);
    display: none;
  }

  .ptl-card {
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 32px;
    transition: transform .3s, border-color .3s, box-shadow .3s;
  }
  .ptl-card:hover {
    transform: translateX(4px);
    border-color: var(--amber);
    box-shadow: 0 14px 34px rgba(0,0,0,0.08);
  }

  .ptl-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .ptl-badges { display: flex; gap: 8px; align-items: center; }
  .ptl-funder-badge {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    background: rgba(13, 148, 136, 0.12);
    color: var(--teal);
    padding: 4px 8px;
  }
  .ptl-status-badge {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: 4px 8px;
  }
  .ptl-status-badge.ongoing { background: var(--amber); color: #0B0F17; }
  .ptl-status-badge.done { background: rgba(100, 116, 139, 0.15); color: var(--ink2); }
  .ptl-loc { font-family: var(--mono); font-size: 11px; color: var(--ink2); }

  .ptl-card h3 {
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .ptl-role {
    font-size: 0.95rem;
    color: var(--amber);
    margin-bottom: 12px;
  }
  .ptl-role strong { color: var(--ink); }
  .ptl-desc {
    font-size: 0.93rem;
    color: var(--ink2);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .ptl-deliverables {
    background: var(--surface);
    border: 1px dashed var(--line);
    border-left: 3px solid var(--teal);
    padding: 16px 20px;
  }
  .ptl-deliv-title {
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--teal);
    display: block;
    margin-bottom: 8px;
  }
  .ptl-deliverables ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .ptl-deliverables li { font-size: 0.88rem; color: var(--ink); position: relative; padding-left: 16px; }
  .ptl-deliverables li::before { content: "✓"; position: absolute; left: 0; color: var(--teal); font-weight: 700; }

  @media (max-width: 640px) {
    .ptl-timeline { padding-left: 20px; }
    .ptl-node { left: -31px; }
    .ptl-dot { width: 16px; height: 16px; }
    .ptl-card { padding: 20px 16px; }
  }
</style>
