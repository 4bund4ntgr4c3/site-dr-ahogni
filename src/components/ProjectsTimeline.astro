---
interface ProjectItem {
  id: string;
  title: string;
  funder: "Fonds Mondial" | "USAID / PMI" | "OMS / TDR" | "Wellcome Trust" | "PAMCA / BMGF";
  funderBadge: string;
  period: string;
  status: "En cours" | "Conclu";
  role: string;
  location: string;
  description: string;
  deliverables: string[];
}

const fundedProjects: ProjectItem[] = [
  {
    id: "pbo-trial",
    title: "Évaluation de l'efficacité épidémiologique et entomologique des moustiquaires bi-actives à large échelle au Bénin",
    funder: "Fonds Mondial",
    funderBadge: "Global Fund",
    period: "2023 — 2026",
    status: "En cours",
    role: "Investigateur Principal & Responsable Entomologique",
    location: "Départements du Zou et de l'Ouémé, Bénin",
    description: "Coordination des suivis de cas de paludisme et de la bio-efficacité des moustiquaires Interceptor G2 distribuées lors de la campagne nationale de masse.",
    deliverables: [
      "Suivi mensuel de 120 cases sentinelles",
      "Évaluation de la rémanence insecticide sur 36 mois",
      "Rapports stratégiques pour le Programme National de Lutte contre le Paludisme (PNLP)",
    ],
  },
  {
    id: "pmi-vectorlink",
    title: "Surveillance entomologique nationale et suivi de la résistance aux insecticides (Projet VectorLink / Vector Control Activity)",
    funder: "USAID / PMI",
    funderBadge: "USAID / PMI",
    period: "2021 — 2024",
    status: "Conclu",
    role: "Co-Investigateur & Expert Technique",
    location: "12 départements sanitaires, Bénin",
    description: "Établissement de la cartographie annuelle de la sensibilité aux insecticides dans les sites sentinelles du Bénin et formation des équipes de terrain.",
    deliverables: [
      "Plus de 45 000 moustiques testés en tubes OMS et bouteilles CDC",
      "Caractérisation moléculaire des allèles kdr L1014F et ace-1 G119S",
      "Manuel standardisé des procédures de capture et de bio-essais",
    ],
  },
  {
    id: "who-stephensi",
    title: "Système d'alerte précoce et détection moléculaire d'Anopheles stephensi en Afrique de l'Ouest",
    funder: "OMS / TDR",
    funderBadge: "WHO / AFRO",
    period: "2024 — 2026",
    status: "En cours",
    role: "Chercheur Référent & Point Focal",
    location: "Zones portuaires, aéroportuaires et corridors urbains",
    description: "Mise en place de protocoles de surveillance ciblée pour intercepter et caractériser précocement l'introduction du vecteur invasif asiatique en milieu urbain.",
    deliverables: [
      "Réseau de pièges BG-Sentinel et ovipièges aux points d'entrée",
      "PCR multiplex d'identification spécifique instantanée",
      "Directives de riposte précoce pour les autorités sanitaires",
    ],
  },
  {
    id: "wellcome-genomics",
    title: "Génomique des populations et flux de gènes de résistance chez Anopheles coluzzii et Anopheles gambiae",
    funder: "Wellcome Trust",
    funderBadge: "Wellcome Trust",
    period: "2020 — 2023",
    status: "Conclu",
    role: "Chercheur Post-Doctoral Associé (CREC / LSHTM)",
    location: "Bénin & Royaume-Uni",
    description: "Séquençage du génome entier d'anophèles collectés le long d'un gradient écoclimatique et analyse des signatures de sélection autour des locus P450.",
    deliverables: [
      "3 publications majeures en revues internationales Q1",
      "Cartographie des duplications génomiques CYP6P9a/b",
      "Base de données génomique ouverte sur VectorBase",
    ],
  },
];
---

<section class="sec prj-timeline-sec" id="timeline-projets">
  <div class="wrap">
    <div class="sec-head">
      <p class="sec-eyebrow" data-i18n="prj.eyebrow">04 — Financements &amp; Recherche Opérationnelle</p>
      <h2 class="title lm">
        <span class="ln"><span>Programmes de recherche</span></span>
        <span class="ln"><span>&amp; projets <span class="it">financés</span></span></span>
      </h2>
      <p class="ptl-lede">
        Projets de recherche translationnelle et d'évaluation opérationnelle conduits avec les agences de financement internationales et les ministères de la santé.
      </p>
    </div>

    <!-- Filtres Bailleurs -->
    <div class="ptl-filters">
      <button class="ptl-fbtn active" data-ptl-filter="all">Tous les programmes ({fundedProjects.length})</button>
      <button class="ptl-fbtn" data-ptl-filter="Fonds Mondial">Fonds Mondial</button>
      <button class="ptl-fbtn" data-ptl-filter="USAID / PMI">USAID / PMI</button>
      <button class="ptl-fbtn" data-ptl-filter="OMS / TDR">OMS / TDR</button>
      <button class="ptl-fbtn" data-ptl-filter="Wellcome Trust">Wellcome Trust</button>
    </div>

    <!-- Liste chronologique -->
    <div class="ptl-timeline rv">
      {fundedProjects.map((p, idx) => (
        <div class="ptl-item" data-funder={p.funder}>
          <div class="ptl-node">
            <span class="ptl-dot"></span>
            <span class="ptl-period">{p.period}</span>
          </div>
          <article class="ptl-card">
            <div class="ptl-top">
              <div class="ptl-badges">
                <span class="ptl-funder-badge">{p.funderBadge}</span>
                <span class={`ptl-status-badge ${p.status === "En cours" ? "ongoing" : "done"}`}>{p.status}</span>
              </div>
              <span class="ptl-loc">📍 {p.location}</span>
            </div>

            <h3>{p.title}</h3>
            <p class="ptl-role"><strong>Rôle :</strong> {p.role}</p>
            <p class="ptl-desc">{p.description}</p>

            <div class="ptl-deliverables">
              <span class="ptl-deliv-title">Livrables &amp; Impacts clés :</span>
              <ul>
                {p.deliverables.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const fbtns = document.querySelectorAll<HTMLButtonElement>(".ptl-fbtn");
    const items = document.querySelectorAll<HTMLElement>(".ptl-item");

    fbtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        fbtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        const filter = btn.dataset.ptlFilter || "all";
        items.forEach((it) => {
          it.style.display = (filter === "all" || it.dataset.funder === filter) ? "" : "none";
        });
      });
    });
  });
</script>

<style>
  .prj-timeline-sec { padding: 90px 5vw; background: var(--surface); border-top: 1px solid var(--line); }
  .ptl-lede { max-width: 62ch; font-size: 1.08rem; color: var(--ink2); margin-top: 18px; line-height: 1.7; }

  .ptl-filters {
    display: flex;
    gap: 10px;
    margin: 36px 0 40px;
    flex-wrap: wrap;
  }
  .ptl-fbtn {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    background: var(--paper);
    color: var(--ink);
    border: 1.5px solid var(--line);
    padding: 10px 16px;
    cursor: pointer;
    transition: all .25s ease;
  }
  .ptl-fbtn:hover { border-color: var(--amber); }
  .ptl-fbtn.active {
    background: var(--amber);
    color: #0B0F17;
    border-color: var(--amber);
    font-weight: 700;
  }

  .ptl-timeline {
    position: relative;
    padding-left: 32px;
    border-left: 2px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ptl-item { position: relative; }
  .ptl-node {
    position: absolute;
    left: -43px;
    top: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ptl-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--amber);
    border: 4px solid var(--surface);
    box-shadow: 0 0 0 1px var(--amber);
  }
  .ptl-period {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .1em;
    color: var(--coral);
    display: none;
  }

  .ptl-card {
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 32px;
    transition: transform .3s, border-color .3s, box-shadow .3s;
  }
  .ptl-card:hover {
    transform: translateX(4px);
    border-color: var(--amber);
    box-shadow: 0 14px 34px rgba(0,0,0,0.08);
  }

  .ptl-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .ptl-badges { display: flex; gap: 8px; align-items: center; }
  .ptl-funder-badge {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    background: rgba(13, 148, 136, 0.12);
    color: var(--teal);
    padding: 4px 8px;
  }
  .ptl-status-badge {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: 4px 8px;
  }
  .ptl-status-badge.ongoing { background: var(--amber); color: #0B0F17; }
  .ptl-status-badge.done { background: rgba(100, 116, 139, 0.15); color: var(--ink2); }
  .ptl-loc { font-family: var(--mono); font-size: 11px; color: var(--ink2); }

  .ptl-card h3 {
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .ptl-role {
    font-size: 0.95rem;
    color: var(--amber);
    margin-bottom: 12px;
  }
  .ptl-role strong { color: var(--ink); }
  .ptl-desc {
    font-size: 0.93rem;
    color: var(--ink2);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .ptl-deliverables {
    background: var(--surface);
    border: 1px dashed var(--line);
    border-left: 3px solid var(--teal);
    padding: 16px 20px;
  }
  .ptl-deliv-title {
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--teal);
    display: block;
    margin-bottom: 8px;
  }
  .ptl-deliverables ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .ptl-deliverables li { font-size: 0.88rem; color: var(--ink); position: relative; padding-left: 16px; }
  .ptl-deliverables li::before { content: "✓"; position: absolute; left: 0; color: var(--teal); font-weight: 700; }

  @media (max-width: 640px) {
    .ptl-timeline { padding-left: 20px; }
    .ptl-node { left: -31px; }
    .ptl-dot { width: 16px; height: 16px; }
    .ptl-card { padding: 20px 16px; }
  }
</style>
