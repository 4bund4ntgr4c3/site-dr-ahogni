---
import { sanityClient } from "sanity:client";
import { SETTINGS_QUERY, cachedFetch } from "../lib/queries";
const settings = await cachedFetch(sanityClient, SETTINGS_QUERY);
const url = settings?.calendlyUrl;
const isContact = Astro.url.pathname === "/contact" || Astro.url.pathname === "/en/contact";
const isEn = Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");
---

{url && url !== "#" && (
  <a class={isContact ? "cal-btn contact" : "cal-btn"} href={url} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
    <span data-i18n="action.meeting">{isEn ? "Book a Meeting" : "Prendre rendez-vous"}</span>
  </a>
)}

<style>
  .cal-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    background: transparent;
    color: var(--teal);
    border: 1.5px solid var(--teal);
    padding: 12px 20px;
    text-decoration: none;
    transition: all .3s ease;
  }
  .cal-btn svg { width: 16px; height: 16px; color: currentColor; }
  .cal-btn:hover {
    background: var(--teal);
    color: #FFFFFF;
    border-color: var(--teal);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(13, 148, 136, 0.25);
  }
  .cal-btn.contact {
    background: var(--amber);
    color: #0B0F17;
    border-color: var(--amber);
    font-weight: 700;
  }
  .cal-btn.contact:hover {
    background: var(--amber2);
    border-color: var(--amber2);
    color: #0B0F17;
    transform: translateY(-2px);
  }
  html[data-theme="dark"] .cal-btn {
    color: var(--teal);
    border-color: var(--teal);
  }
  html[data-theme="dark"] .cal-btn:hover {
    background: var(--teal);
    color: #0B0F17;
    border-color: var(--teal);
  }
</style>