---
interface Metric {
  num: string;
  lbl: string;
  sub: string;
  highlight?: boolean;
}

const metrics: Metric[] = [
  { num: "500+", lbl: "Citations totales", sub: "Google Scholar & Crossref", highlight: true },
  { num: "12", lbl: "Indice h", sub: "Impact continu de la recherche" },
  { num: "15", lbl: "Indice i10", sub: "Publications avec ≥10 citations" },
  { num: "25+", lbl: "Articles publiés", sub: "Revues internationales Q1/Q2" },
  { num: "100%", lbl: "Open Access", sub: "Recherche accessible à tous" },
  { num: "10+", lbl: "Pays d'intervention", sub: "Afrique & collaborations mondiales" },
];

const partners = [
  { name: "CREC", full: "Centre de Recherche Entomologique de Cotonou", loc: "Bénin", type: "national", x: 180, y: 150, r: 28 },
  { name: "LSHTM", full: "London School of Hygiene & Tropical Medicine", loc: "Royaume-Uni", type: "academic", x: 380, y: 80, r: 32 },
  { name: "PAMCA", full: "Pan-African Mosquito Control Association", loc: "Afrique", type: "regional", x: 320, y: 220, r: 30 },
  { name: "OMS / WHO", full: "Organisation Mondiale de la Santé", loc: "Genève / AFRO", type: "global", x: 540, y: 120, r: 34 },
  { name: "CDC", full: "US Centers for Disease Control and Prevention", loc: "Atlanta, USA", type: "global", x: 100, y: 80, r: 26 },
  { name: "UAC", full: "Université d'Abomey-Calavi", loc: "Bénin", type: "national", x: 120, y: 240, r: 26 },
  { name: "LSTM", full: "Liverpool School of Tropical Medicine", loc: "Royaume-Uni", type: "academic", x: 490, y: 230, r: 28 },
  { name: "IRSS", full: "Institut de Recherche en Sciences de la Santé", loc: "Burkina Faso", type: "regional", x: 230, y: 290, r: 24 },
];
---

<section class="sec impact-sec" id="impact">
  <div class="wrap">
    <div class="sec-head">
      <p class="sec-eyebrow" data-i18n="impact.eyebrow">03 — Métriques &amp; Rayonnement</p>
      <h2 class="title lm">
        <span class="ln"><span>Impact scientifique</span></span>
        <span class="ln"><span>&amp; réseau de <span class="it">collaboration</span></span></span>
      </h2>
      <p class="impact-lede">
        Une recherche axée sur l'application opérationnelle, mesurée par des citations scientifiques mondiales et un réseau international dense d'institutions partenaires.
      </p>
    </div>

    <!-- Grille des Métriques -->
    <div class="impact-metrics-grid rv">
      {metrics.map((m) => (
        <div class:list={["im-card", { hl: m.highlight }]}>
          <div class="im-num">{m.num}</div>
          <div class="im-lbl">{m.lbl}</div>
          <div class="im-sub">{m.sub}</div>
        </div>
      ))}
    </div>

    <!-- Graphe Interactif du Réseau de Recherche -->
    <div class="impact-graph-wrap rv">
      <div class="ig-header">
        <div class="ig-title-area">
          <span class="ig-tag">Cartographie du Réseau de Recherche</span>
          <h3>Écosystème de Coopération Scientifique</h3>
        </div>
        <div class="ig-legend">
          <span class="leg-item"><span class="leg-dot nat"></span> Bénin (National)</span>
          <span class="leg-item"><span class="leg-dot reg"></span> Afrique (Régional)</span>
          <span class="leg-item"><span class="leg-dot acad"></span> Académique Int.</span>
          <span class="leg-item"><span class="leg-dot glob"></span> Agences Mondiales</span>
        </div>
      </div>

      <div class="ig-canvas-box" id="networkBox">
        <svg id="networkSvg" viewBox="0 0 640 360" preserveAspectRatio="xMidYMid meet" aria-label="Graphe de réseau scientifique">
          <!-- Lignes de liaison animées -->
          <g class="net-links">
            <line x1="180" y1="150" x2="380" y2="80" class="nlink" />
            <line x1="180" y1="150" x2="320" y2="220" class="nlink" />
            <line x1="180" y1="150" x2="120" y2="240" class="nlink" />
            <line x1="180" y1="150" x2="100" y2="80" class="nlink" />
            <line x1="380" y1="80" x2="540" y2="120" class="nlink" />
            <line x1="380" y1="80" x2="490" y2="230" class="nlink" />
            <line x1="320" y1="220" x2="540" y2="120" class="nlink" />
            <line x1="320" y1="220" x2="230" y2="290" class="nlink" />
            <line x1="120" y1="240" x2="230" y2="290" class="nlink" />
            <line x1="490" y1="230" x2="540" y2="120" class="nlink" />
          </g>

          <!-- Nœud Central Dr Ahogni -->
          <g class="center-node" transform="translate(290, 150)">
            <circle r="36" class="cn-pulse" />
            <circle r="32" class="cn-base" />
            <text text-anchor="middle" dy="4" class="cn-text">Dr AHOGNI</text>
          </g>

          <!-- Nœuds Partenaires -->
          {partners.map((p) => (
            <g class={`node-grp node-${p.type}`} transform={`translate(${p.x}, ${p.y})`} data-name={p.name} data-full={p.full} data-loc={p.loc} tabindex="0" role="button" aria-label={`${p.name} - ${p.full}`}>
              <circle r={p.r} class="node-circle" />
              <text text-anchor="middle" dy="4" class="node-text">{p.name}</text>
            </g>
          ))}
        </svg>

        <!-- Carte Infobulle Nœud sélectionné -->
        <div id="nodeTooltip" class="node-tooltip" aria-hidden="true">
          <span class="nt-tag" id="ntTag">Institution</span>
          <strong id="ntTitle">Nom de l'institution</strong>
          <span class="nt-loc" id="ntLoc">Localisation</span>
          <p id="ntDesc">Projets conjoints en évaluation d'insecticides et surveillance génomique.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const nodes = document.querySelectorAll<SVGGElement>(".node-grp");
    const tt = document.getElementById("nodeTooltip");
    const ntTag = document.getElementById("ntTag");
    const ntTitle = document.getElementById("ntTitle");
    const ntLoc = document.getElementById("ntLoc");

    if (tt && ntTag && ntTitle && ntLoc) {
      nodes.forEach((n) => {
        const updateInfo = () => {
          const name = n.dataset.name || "";
          const full = n.dataset.full || "";
          const loc = n.dataset.loc || "";
          ntTag.textContent = n.classList.contains("node-nat") ? "Partenaire National" :
                             n.classList.contains("node-acad") ? "Partenaire Académique" :
                             n.classList.contains("node-reg") ? "Réseau Régional" : "Agence Mondiale";
          ntTitle.textContent = `${name} — ${full}`;
          ntLoc.textContent = `📍 ${loc}`;
          tt.classList.add("show");
        };

        n.addEventListener("mouseenter", updateInfo);
        n.addEventListener("focus", updateInfo);
        n.addEventListener("click", (e) => {
          e.stopPropagation();
          updateInfo();
        });
      });

      document.addEventListener("click", () => {
        tt.classList.remove("show");
      });
    }
  });
</script>

<style>
  .impact-sec { padding: 90px 5vw; }
  .impact-lede { max-width: 60ch; font-size: 1.08rem; color: var(--ink2); margin-top: 18px; line-height: 1.7; }

  /* ── Grille Métriques ── */
  .impact-metrics-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    margin: 48px 0 56px;
  }
  .im-card {
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 24px 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform .3s, border-color .3s, box-shadow .3s;
  }
  .im-card:hover {
    transform: translateY(-4px);
    border-color: var(--amber);
    box-shadow: 0 14px 30px rgba(0,0,0,0.08);
  }
  .im-card.hl {
    border-left: 3px solid var(--amber);
    background: var(--paper2);
  }
  .im-num {
    font-family: var(--display);
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--amber);
    margin-bottom: 12px;
  }
  .im-lbl {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .im-sub {
    font-size: 0.82rem;
    color: var(--ink2);
    line-height: 1.4;
  }

  /* ── Graphe Réseau ── */
  .impact-graph-wrap {
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 36px;
    position: relative;
  }
  .ig-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 20px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .ig-tag {
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--coral);
    display: block;
    margin-bottom: 4px;
  }
  .ig-title-area h3 {
    font-family: var(--display);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--ink);
  }
  .ig-legend {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ink2);
  }
  .leg-item { display: inline-flex; align-items: center; gap: 6px; }
  .leg-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .leg-dot.nat { background: var(--coral); }
  .leg-dot.reg { background: var(--amber); }
  .leg-dot.acad { background: var(--teal); }
  .leg-dot.glob { background: #3B82F6; }

  .ig-canvas-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    max-height: 480px;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  #networkSvg { width: 100%; height: 100%; }

  /* Links */
  .nlink {
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    opacity: 0.22;
    animation: dash 30s linear infinite;
  }
  @keyframes dash { to { stroke-dashoffset: -200; } }

  /* Central Node */
  .cn-pulse {
    fill: var(--amber);
    opacity: 0.2;
    animation: cnpulse 3s ease-out infinite;
  }
  @keyframes cnpulse {
    0% { r: 32px; opacity: 0.4; }
    100% { r: 48px; opacity: 0; }
  }
  .cn-base {
    fill: var(--amber);
    stroke: var(--paper);
    stroke-width: 3;
    cursor: default;
  }
  .cn-text {
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 700;
    fill: #0B0F17;
    letter-spacing: .08em;
  }

  /* Partner Nodes */
  .node-grp { cursor: pointer; transition: transform .25s ease; outline: none; }
  .node-grp:hover, .node-grp:focus-visible { transform: scale(1.12); }
  .node-circle {
    stroke: var(--paper);
    stroke-width: 2.5;
    transition: filter .25s;
  }
  .node-nat .node-circle { fill: var(--coral); }
  .node-reg .node-circle { fill: var(--amber); }
  .node-acad .node-circle { fill: var(--teal); }
  .node-glob .node-circle { fill: #3B82F6; }

  .node-text {
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 700;
    fill: #FFFFFF;
    letter-spacing: .06em;
    pointer-events: none;
  }

  /* Tooltip */
  .node-tooltip {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    background: rgba(11, 15, 23, 0.94);
    backdrop-filter: blur(10px);
    border: 1px solid var(--amber);
    color: #F8FAFC;
    padding: 16px 20px;
    max-width: 440px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all .25s ease;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    z-index: 10;
  }
  .node-tooltip.show { opacity: 1; visibility: visible; transform: translateY(0); }
  .nt-tag { font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--amber); display: block; margin-bottom: 2px; font-weight: 700; }
  .node-tooltip strong { font-size: 1rem; color: #FFFFFF; display: block; margin-bottom: 2px; }
  .nt-loc { font-family: var(--mono); font-size: 10px; color: #CBD5E1; display: block; margin-bottom: 6px; }
  .node-tooltip p { font-size: 0.88rem; color: #E2E8F0; line-height: 1.4; margin: 0; }

  @media (max-width: 1080px) {
    .impact-metrics-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 640px) {
    .impact-metrics-grid { grid-template-columns: repeat(2, 1fr); }
    .impact-graph-wrap { padding: 20px 16px; }
    .ig-canvas-box { aspect-ratio: 4/3; }
  }
</style>
