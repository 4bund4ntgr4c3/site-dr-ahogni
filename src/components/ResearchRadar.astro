---
const isEn = Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");
const pfx = isEn ? "/en" : "";
const homePath = isEn ? "/en" : "/";

const frAxes = [
  { label: "Bio-essais & Phase II", value: 95, desc: "Tubes OMS, bouteilles CDC, rémanence en cases expérimentales" },
  { label: "Génomique & Marqueurs kdr/ace-1", value: 90, desc: "PCR, séquençage, analyse des flux de gènes de résistance" },
  { label: "Évaluation des MILDV", value: 92, desc: "Moustiquaires PBO, chlorfénapyr, pyriproxyfène en vie réelle" },
  { label: "Épidémiologie & TIE", value: 85, desc: "Taux d'inoculation entomologique, dynamique de transmission" },
  { label: "Gestion de Programme & PNLP", value: 88, desc: "Coordination de projets nationaux, plaidoyer politique" },
  { label: "Formation & Mentorat", value: 90, desc: "Masterclass, encadrement de thèses, renforcement de capacités" },
];

const enAxes = [
  { label: "Bioassays & Phase II Trials", value: 95, desc: "WHO tubes, CDC bottles, residual efficacy in experimental huts" },
  { label: "Genomics & kdr/ace-1 Markers", value: 90, desc: "PCR, high-throughput sequencing, resistance gene tracking" },
  { label: "Dual-Active LLIN Evaluation", value: 92, desc: "PBO, chlorfenapyr, pyriproxyfen community and semi-field trials" },
  { label: "Epidemiology & EIR Modeling", value: 85, desc: "Entomological Inoculation Rate, vector transmission dynamics" },
  { label: "NMCP Program Management", value: 88, desc: "National strategic plans, Global Fund advisory, policy leadership" },
  { label: "Teaching & Capacity Mentoring", value: 90, desc: "Masterclasses, thesis co-supervision, training African scholars" },
];

const expertiseAxes = isEn ? enAxes : frAxes;

const frKeywords = [
  { text: "Anopheles gambiae", count: 24, href: `${pfx}/publications` },
  { text: "Résistance Pyréthroïdes", count: 21, href: `${pfx}/publications` },
  { text: "Interceptor G2", count: 16, href: `${pfx}/publications` },
  { text: "kdr L1014F", count: 18, href: `${pfx}/publications` },
  { text: "Cases Expérimentales", count: 14, href: `${pfx}/publications` },
  { text: "Cytochromes P450", count: 12, href: `${pfx}/publications` },
  { text: "OMS / WHO Guidelines", count: 15, href: `${pfx}/speaking` },
  { text: "Santé Publique Bénin", count: 19, href: `${homePath}#apropos` },
  { text: "Anopheles stephensi", count: 9, href: `${homePath}#entomologie` },
  { text: "PBO Synergiste", count: 13, href: `${homePath}#moustiquaires` },
  { text: "Bouteilles CDC", count: 11, href: `${homePath}#entomologie` },
  { text: "Bio-essais Tubes OMS", count: 22, href: `${homePath}#entomologie` },
];

const enKeywords = [
  { text: "Anopheles gambiae", count: 24, href: `${pfx}/publications` },
  { text: "Pyrethroid Resistance", count: 21, href: `${pfx}/publications` },
  { text: "Interceptor G2", count: 16, href: `${pfx}/publications` },
  { text: "kdr L1014F Allele", count: 18, href: `${pfx}/publications` },
  { text: "Experimental Huts", count: 14, href: `${pfx}/publications` },
  { text: "P450 Cytochromes", count: 12, href: `${pfx}/publications` },
  { text: "WHO Guidelines", count: 15, href: `${pfx}/speaking` },
  { text: "Public Health Benin", count: 19, href: `${homePath}#apropos` },
  { text: "Anopheles stephensi", count: 9, href: `${homePath}#entomologie` },
  { text: "PBO Synergist", count: 13, href: `${homePath}#moustiquaires` },
  { text: "CDC Bottle Bioassays", count: 11, href: `${homePath}#entomologie` },
  { text: "WHO Tube Assays", count: 22, href: `${homePath}#entomologie` },
];

const keywords = isEn ? enKeywords : frKeywords;
---

<section class="sec radar-sec" id="axes-recherche">
  <div class="wrap">
    <div class="sec-head">
      <p class="sec-eyebrow" data-i18n="radar.eyebrow">{isEn ? "03 — Skill Mapping" : "03 — Cartographie des Compétences"}</p>
      <h2 class="title lm" data-i18n-html="radar.title">
        {isEn ? (
          <span class="ln"><span>Scientific expertise radar</span></span>
          <span class="ln"><span>&amp; keyword <span class="it">cloud</span></span></span>
        ) : (
          <span class="ln"><span>Radar d'expertise scientifique</span></span>
          <span class="ln"><span>&amp; nuage de <span class="it">mots-clés</span></span></span>
        )}
      </h2>
      <p class="radar-lede" data-i18n="radar.lede">
        {isEn
          ? "Polygonal visualization of Dr. Ahogni's expertise pillars, spanning fundamental entomology to public health policy implementation."
          : "Visualisation polygonale des piliers d'expertise du Dr Ahogni, de l'entomologie fondamentale à la mise en œuvre des politiques de santé publique."}
      </p>
    </div>

    <div class="radar-container rv">
      <!-- Radar Chart SVG -->
      <div class="radar-chart-box">
        <div class="rc-title" data-i18n="radar.chartTitle">{isEn ? "Multidisciplinary Expertise Profile" : "Profil d'Expertise Polyvalente"}</div>
        <svg viewBox="0 0 400 400" preserveAspectRatio="xMidYMid meet" class="radar-svg" aria-label={isEn ? "Expertise radar chart" : "Radar chart des compétences"}>
          <!-- Cercles de niveau -->
          <circle cx="200" cy="200" r="140" class="r-grid" />
          <circle cx="200" cy="200" r="105" class="r-grid" />
          <circle cx="200" cy="200" r="70" class="r-grid" />
          <circle cx="200" cy="200" r="35" class="r-grid" />

          <!-- Rayons axiaux (6 axes) -->
          <line x1="200" y1="200" x2="200" y2="60" class="r-axis" />
          <line x1="200" y1="200" x2="321" y2="130" class="r-axis" />
          <line x1="200" y1="200" x2="321" y2="270" class="r-axis" />
          <line x1="200" y1="200" x2="200" y2="340" class="r-axis" />
          <line x1="200" y1="200" x2="79" y2="270" class="r-axis" />
          <line x1="200" y1="200" x2="79" y2="130" class="r-axis" />

          <!-- Polygone de données rempli -->
          <polygon
            points="200,67 309,137 311,264 200,319 93,262 91,137"
            class="radar-poly"
          />

          <!-- Points nodaux -->
          <circle cx="200" cy="67" r="4.5" class="r-dot" />
          <circle cx="309" cy="137" r="4.5" class="r-dot" />
          <circle cx="311" cy="264" r="4.5" class="r-dot" />
          <circle cx="200" cy="319" r="4.5" class="r-dot" />
          <circle cx="93" cy="262" r="4.5" class="r-dot" />
          <circle cx="91" cy="137" r="4.5" class="r-dot" />

          <!-- Libellés des axes -->
          <text x="200" y="45" text-anchor="middle" class="r-label" data-i18n="radar.ax1">{isEn ? "Bioassays (95%)" : "Bio-essais (95%)"}</text>
          <text x="335" y="125" text-anchor="start" class="r-label" data-i18n="radar.ax2">{isEn ? "Genomics & kdr (90%)" : "Génomique & kdr (90%)"}</text>
          <text x="335" y="280" text-anchor="start" class="r-label" data-i18n="radar.ax3">{isEn ? "LLINs (92%)" : "MILDV (92%)"}</text>
          <text x="200" y="365" text-anchor="middle" class="r-label" data-i18n="radar.ax4">{isEn ? "EIR & Epidemio (85%)" : "TIE & Épidémio (85%)"}</text>
          <text x="65" y="280" text-anchor="end" class="r-label" data-i18n="radar.ax5">{isEn ? "NMCP Leadership (88%)" : "Gestion PNLP (88%)"}</text>
          <text x="65" y="125" text-anchor="end" class="r-label" data-i18n="radar.ax6">{isEn ? "Mentorship (90%)" : "Mentorat (90%)"}</text>
        </svg>
      </div>

      <!-- Nuage de Mots-Clés et Légende -->
      <div class="radar-info-box">
        <div class="kw-title" data-i18n="radar.cloudTitle">{isEn ? "Thematic Index & Key Concepts" : "Index Thématique & Concepts Clés"}</div>
        <p class="kw-desc" data-i18n="radar.cloudDesc">{isEn ? "Scientific keywords associated with publications and keynote lectures:" : "Mots-clés scientifiques associés aux articles publiés et conférences dispensées :"}</p>

        <div class="kw-cloud" data-i18n-html="radar.cloud">
          {keywords.map((kw) => (
            <a href={kw.href} class="kw-chip">
              <span>{kw.text}</span>
              <span class="kw-count">{kw.count}</span>
            </a>
          ))}
        </div>

        <div class="axes-breakdown" data-i18n-html="radar.axes">
          {expertiseAxes.map((ax) => (
            <div class="ax-row">
              <div class="ax-top">
                <strong>{ax.label}</strong>
                <span class="ax-val">{ax.value}%</span>
              </div>
              <p>{ax.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .radar-sec { padding: 90px 5vw; background: var(--surface); border-top: 1px solid var(--line); }
  .radar-lede { max-width: 62ch; font-size: 1.08rem; color: var(--ink2); margin-top: 18px; line-height: 1.7; }

  .radar-container {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 36px;
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 36px;
    margin-top: 48px;
  }

  .rc-title, .kw-title {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--coral);
    margin-bottom: 16px;
  }

  .radar-chart-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 24px;
  }
  .radar-svg { width: 100%; max-width: 360px; height: auto; }

  .r-grid { fill: none; stroke: var(--line); stroke-dasharray: 2 2; }
  .r-axis { stroke: var(--line); stroke-width: 1.5; }
  .radar-poly {
    fill: rgba(217, 130, 24, 0.25);
    stroke: var(--amber);
    stroke-width: 2.5;
  }
  .radar-dot { fill: var(--amber); stroke: var(--paper); stroke-width: 2; }
  .r-label {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    fill: var(--ink);
    letter-spacing: .04em;
  }

  .radar-info-box {
    display: flex;
    flex-direction: column;
  }
  .kw-desc { font-size: 0.92rem; color: var(--ink2); margin-bottom: 18px; }

  .kw-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }
  .kw-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 6px 12px;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink);
    text-decoration: none;
    transition: all .2s;
  }
  .kw-chip:hover {
    border-color: var(--amber);
    background: var(--paper2);
    transform: translateY(-2px);
  }
  .kw-count {
    background: rgba(13, 148, 136, 0.15);
    color: var(--teal);
    padding: 1px 5px;
    border-radius: 10px;
    font-size: 9.5px;
    font-weight: 700;
  }

  .axes-breakdown {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px dashed var(--line);
    padding-top: 20px;
    margin-top: auto;
  }
  .ax-row { display: flex; flex-direction: column; gap: 2px; }
  .ax-top { display: flex; justify-content: space-between; align-items: center; }
  .ax-top strong { font-size: 0.92rem; color: var(--ink); }
  .ax-val { font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--amber); }
  .ax-row p { font-size: 0.84rem; color: var(--ink2); margin: 0; line-height: 1.4; }

  @media (max-width: 900px) {
    .radar-container { grid-template-columns: 1fr; padding: 22px 16px; }
  }
</style>
