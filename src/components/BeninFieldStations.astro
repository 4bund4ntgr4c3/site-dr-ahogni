const stations = isEn ? enStations : frStations;
---

<section class="sec stations-sec" id="stations-benin">
  <div class="wrap">
    <div class="sec-head">
      <p class="sec-eyebrow" data-i18n="stations.eyebrow">{isEn ? "05 — Field Ecology & Experimental Stations" : "05 — Écologie de Terrain & Sites Expérimentaux"}</p>
      <h2 class="title lm" data-i18n-html="stations.title">
        {isEn ? (
          <span class="ln"><span>Research stations</span></span>
          <span class="ln"><span>&amp; sentinel sites across <span class="it">Benin</span></span></span>
        ) : (
          <span class="ln"><span>Stations de recherche</span></span>
          <span class="ln"><span>&amp; sites sentinelles au <span class="it">Bénin</span></span></span>
        )}
      </h2>
      <p class="stations-lede" data-i18n="stations.lede">
        {isEn
          ? "National network of experimental hut stations, reference insectaries, and entomological surveillance sites coordinated for vector control evaluation."
          : "Réseau national de stations de cases expérimentales, insectariums et sites de surveillance entomologique coordonnés pour évaluer les outils de lutte antivectorielle."}
      </p>
    </div>

    <!-- Sélecteur interactif des stations -->
    <div class="st-grid rv">
      <div class="st-list-col">
        <div class="st-list-title" data-i18n="stations.selectTitle">{isEn ? "Select a research field station:" : "Sélectionnez une station de recherche :"}</div>
        <div class="st-buttons" data-i18n-html="stations.buttons">
          {stations.map((s, i) => (
            <button
              type="button"
              class:list={["st-btn", { active: i === 0 }]}
              data-station-id={s.id}
            >
              <div class="st-btn-top">
                <span class="st-btn-type">{s.type}</span>
                <span class="st-btn-loc">{s.department.split("(")[0]}</span>
              </div>
              <strong>{s.name}</strong>
            </button>
          ))}
        </div>
      </div>

      <div class="st-details-col" data-i18n-html="stations.details">
        {stations.map((s, i) => (
          <article
            class:list={["st-detail-card", { active: i === 0 }]}
            id={`stDetail-${s.id}`}
          >
            <div class="std-header">
              <span class="std-badge">{s.type}</span>
              <h3>{s.name}</h3>
              <div class="std-meta">
                <span>📍 {s.department}</span>
                <span>🌐 GPS : {s.coords}</span>
              </div>
            </div>

            <div class="std-body">
              <div class="std-row">
                <strong class="std-lbl" data-i18n="stations.lblEco">{isEn ? "🌿 Ecoclimatic context:" : "🌿 Contexte écoclimatique :"}</strong>
                <p>{s.ecology}</p>
              </div>

              <div class="std-row">
                <strong class="std-lbl" data-i18n="stations.lblVec">{isEn ? "🦟 Dominant vector species:" : "🦟 Espèces vectorielles prédominantes :"}</strong>
                <p>{s.vectors}</p>
              </div>

              <div class="std-row">
                <strong class="std-lbl" data-i18n="stations.lblRes">{isEn ? "🧬 Documented resistance profile:" : "🧬 Profil de résistance documenté :"}</strong>
                <p class="std-res">{s.resistanceProfile}</p>
              </div>

              <div class="std-row">
                <strong class="std-lbl" data-i18n="stations.lblExp">{isEn ? "🔬 Major trials & projects:" : "🔬 Essais & Programmes majeurs :"}</strong>
                <p>{s.experiments}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btns = document.querySelectorAll<HTMLButtonElement>(".st-btn");
    const cards = document.querySelectorAll<HTMLElement>(".st-detail-card");

    btns.forEach((btn) => {
      btn.addEventListener("click", () => {
        btns.forEach((b) => b.classList.remove("active"));
        cards.forEach((c) => c.classList.remove("active"));

        btn.classList.add("active");
        const sid = btn.dataset.stationId;
        const target = document.getElementById(`stDetail-${sid}`);
        if (target) target.classList.add("active");
      });
    });
  });
</script>

<style>
  .stations-sec { padding: 90px 5vw; background: var(--paper); border-top: 1px solid var(--line); }
  .stations-lede { max-width: 62ch; font-size: 1.08rem; color: var(--ink2); margin-top: 18px; line-height: 1.7; }

  .st-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 32px;
    margin-top: 48px;
  }

  .st-list-title {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--coral);
    margin-bottom: 16px;
  }

  .st-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .st-btn {
    background: var(--surface);
    border: 1.5px solid var(--line);
    padding: 18px 20px;
    text-align: left;
    cursor: pointer;
    transition: all .25s ease;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .st-btn:hover {
    border-color: var(--amber);
    transform: translateX(4px);
  }
  .st-btn.active {
    background: var(--amber);
    border-color: var(--amber);
    color: #0B0F17;
    box-shadow: 0 10px 26px rgba(0,0,0,0.15);
  }
  .st-btn.active strong { color: #0B0F17; }
  .st-btn.active .st-btn-type { color: #0B0F17; font-weight: 800; }
  .st-btn.active .st-btn-loc { color: #1E293B; font-weight: 600; }

  .st-btn-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
  }
  .st-btn-type { color: var(--teal); font-weight: 700; letter-spacing: .08em; }
  .st-btn-loc { color: var(--ink2); }
  .st-btn strong { font-family: var(--display); font-size: 1.05rem; color: var(--ink); }

  /* Detail Card */
  .st-detail-card {
    display: none;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 32px;
  }
  .st-detail-card.active {
    display: block;
    animation: fadeIn .35s ease;
  }

  .std-header {
    border-bottom: 1px solid var(--line);
    padding-bottom: 18px;
    margin-bottom: 20px;
  }
  .std-badge {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    background: rgba(13, 148, 136, 0.12);
    color: var(--teal);
    padding: 4px 8px;
    display: inline-block;
    margin-bottom: 8px;
  }
  .std-header h3 {
    font-family: var(--display);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .std-meta {
    display: flex;
    gap: 16px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink2);
    flex-wrap: wrap;
  }

  .std-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .std-lbl {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ink);
    display: block;
    margin-bottom: 4px;
  }
  .std-row p { font-size: 0.92rem; color: var(--ink2); line-height: 1.6; margin: 0; }
  .std-res { color: var(--coral) !important; font-weight: 600; }

  @media (max-width: 900px) {
    .st-grid { grid-template-columns: 1fr; }
  }
</style>
