---
const isEn = Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");

interface FieldStation {
  id: string;
  name: string;
  department: string;
  type: string;
  ecology: string;
  vectors: string;
  resistanceProfile: string;
  experiments: string;
  coords: string;
}

