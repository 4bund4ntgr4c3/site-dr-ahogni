    ecology: "Central molecular biology platform, climate-controlled bioassay testing suites, and WHO-standard reference insectaries.",
    vectors: "Continuous colonization of standard susceptible reference strains (Kisumu) and wild field-collected colonies.",
    resistanceProfile: "High-throughput PCR genotyping, sequencing, and biochemical microplate assays (P450s, GSTs, esterases).",
    experiments: "Nationwide centralization of WHO tube assays and strategic coordination for NMCP and WHO technical programs.",
    coords: "6.3703° N, 2.4183° E",
  },
  {
    id: "parakou",
    name: "Parakou Sentinel Field Site",
    department: "Borgou Department (North-Eastern Benin)",
    type: "National Sentinel Site",
    ecology: "Sudano-Guinean savannah zone with distinct rainy and dry seasons.",
    vectors: "Anopheles gambiae s.s. and Anopheles funestus extending dry-season transmission windows.",
