---
import { sanityClient } from "sanity:client";
import { SETTINGS_QUERY, cachedFetch } from "../lib/queries";

const settings = await cachedFetch(sanityClient, SETTINGS_QUERY);
const text = settings?.tapeText || "Surveillance entomologique ✦ MILDA · PID · ATSB ✦ Résistance aux insecticides ✦ DHIS2 & données géolocalisées ✦ Essais randomisés de phase III ✦ Plans stratégiques nationaux ✦ OMS · PMI/USAID · Fonds mondial ✦";
---

<div class="tape" aria-hidden="true">
  <div class="tape-track">
    <span>{text}&nbsp;</span>
    <span>{text}&nbsp;</span>
  </div>
</div>
