---
import { Image, getImage } from "astro:assets";
import { sanityClient } from "sanity:client";
import { SETTINGS_QUERY, CONTENT_QUERY, cachedFetch } from "../lib/queries";
import Calendly from "./Calendly.astro";
import portrait from "../../public/Dr-Idelphone-AHOGNI.jpeg";

const settings = await cachedFetch(sanityClient, SETTINGS_QUERY);
const content = await cachedFetch(sanityClient, CONTENT_QUERY);

const isEn = Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");
const pfx = isEn ? "/en" : "";
const homePath = isEn ? "/en" : "/";

const frDefaultStats = [
  { number: "10", suffix: "+", label: "Années d'Expérience" },
  { number: "24", suffix: "+", label: "Articles Scientifiques" },
  { number: "15", suffix: "+", label: "Essais OMS & BPL" },
  { number: "09", suffix: "", label: "Pays Africains Couverts" }
];

const enDefaultStats = [
  { number: "10", suffix: "+", label: "Years of Experience" },
  { number: "24", suffix: "+", label: "Peer-Reviewed Papers" },
  { number: "15", suffix: "+", label: "WHO & GLP Protocols" },
  { number: "09", suffix: "", label: "African Countries Covered" }
];

const stats = isEn
  ? (content?.statsEn && content.statsEn.length > 0 ? content.statsEn : content?.stats && content.stats.length > 0 ? content.stats : enDefaultStats)
  : (content?.stats && content.stats.length > 0 ? content.stats : frDefaultStats);

const heroImg = await getImage({ src: portrait, formats: ["avif", "webp"], widths: [419, 628, 838, 1257], width: 838, height: 1085 });

const heroEyebrow = isEn
  ? "Medical Entomologist · Public Health Malaria Program Manager"
  : (settings?.heroEyebrow || "Entomologiste Médical · Gestionnaire de Programme Paludisme");

const heroTagline = isEn
  ? "Applied entomology, LLIN evaluation, insecticide resistance and public health programs across Africa."
  : (settings?.heroTagline || "Recherche opérationnelle, évaluation des MILDV et gestion de la résistance aux insecticides en Afrique.");

const heroLede = isEn
  ? "Doctor of Medical Entomology (PhD) and public health expert with 10+ years of field experience in Sub-Saharan Africa. Specialized in Phase II/III clinical and entomological trials, vector genomic surveillance, and strategic policy design for NMCPs and international agencies."
  : (settings?.heroLede || "Docteur en Entomologie Médicale (PhD) et chercheur en santé publique avec plus de 10 ans d'expérience opérationnelle en Afrique subsaharienne. Spécialisé dans les essais de Phase II/III, la surveillance génomique et l'appui stratégique aux programmes nationaux.");
---

<link rel="preload" as="image" href={heroImg.src} imagesrcset={heroImg.srcSet.attribute} imagesizes="(max-width: 838px) 92vw, 838px" fetchpriority="high">

<section class="hero" id="accueil">
  <svg class="flightpath" viewBox="0 0 1440 700" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-40 620 C 260 560, 380 300, 640 340 S 1020 560, 1180 300 S 1380 160, 1500 120"/>
  </svg>
  <div class="hero-grid">
    <div>
      <p class="eyebrow decode-line" data-decode={heroEyebrow} data-i18n="hero.eyebrow">{heroEyebrow}</p>
      <h1 class="lm">
        <span class="ln"><span>{settings?.heroName?.firstName || "Idelphonse"}</span></span>
        <span class="ln"><span class="it">{settings?.heroName?.middleName || "Bonaventure"}</span></span>
        <span class="ln"><span>{settings?.heroName?.lastName || "AHOGNI"}<span class="phd">{settings?.heroName?.suffix || ", PhD"}</span></span></span>
      </h1>
      <p class="decode-line" data-decode={heroTagline} data-i18n="hero.tagline">{heroTagline}</p>
      <p class="hero-lede" data-i18n="hero.lede">{heroLede}</p>
      <div class="hero-actions">
        <a class="btn amber" href={`${pfx}/contact`} data-i18n="hero.cta1">{isEn ? "Contact page ↗" : "Page contact ↗"}</a>
        <a class="btn ghost" href={`${homePath}#experience`} data-i18n="hero.cta2">{isEn ? "Explore career ↓" : "Explorer le parcours ↓"}</a>
        <a class="btn ghost" href={`${pfx}/cv`} data-i18n="action.cv">{isEn ? "CV ↓ PDF" : "CV ↓ PDF"}</a>
      </div>
      <div class="hero-actions">
        <Calendly />
      </div>
      <p class="avail"><span class="dot"></span> <span data-i18n="hero.avail">{isEn ? "Available for international missions & consultations" : "Disponible pour missions & consultations internationales"}</span></p>
    </div>
    <figure class="specimen rv">
      <span class="pin" aria-hidden="true"></span>
      <span class="corner c-tl"></span><span class="corner c-tr"></span><span class="corner c-bl"></span><span class="corner c-br"></span>
      <svg class="mosq-float" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M45 60 Q30 50 18 30"/><path d="M47 66 Q28 66 12 58"/><path d="M50 72 Q36 84 24 98"/>
        <path d="M62 72 Q70 88 88 100"/><path d="M64 66 Q84 70 98 62"/><path d="M62 60 Q80 50 96 34"/>
        <ellipse cx="70" cy="52" rx="20" ry="7" transform="rotate(-32 70 52)"/>
        <ellipse cx="52" cy="62" rx="9" ry="8"/><circle cx="44" cy="68" r="5"/><path d="M40 72 L26 84"/>
        <ellipse cx="66" cy="44" rx="18" ry="5" transform="rotate(-24 66 44)" opacity=".55"/>
      </svg>
      <span class="rc rc1" aria-hidden="true"></span><span class="rc rc2" aria-hidden="true"></span>
      <div class="ph">
        <Image
          src={portrait}
          alt={`Portrait du ${settings?.heroName?.firstName} ${settings?.heroName?.lastName}`}
          width={838}
          height={1085}
          formats={["avif", "webp"]}
          widths={[419, 628, 838, 1257]}
          sizes="(max-width: 838px) 92vw, 838px"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <figcaption>
        <span>{settings?.heroFigCaption?.left}</span>
        <span>{settings?.heroFigCaption?.right}</span>
      </figcaption>
    </figure>
  </div>
  <div class="stats">
    {stats.map((s: any) => (
      <div class="stat rv">
        <div class="num"><span data-count={s.number}>0</span>{s.suffix && <em>{s.suffix}</em>}</div>
        <span class="lbl">{s.label}</span>
      </div>
    ))}
  </div>
</section>
