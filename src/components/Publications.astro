---
import { sanityClient } from "sanity:client";
import { CONTENT_QUERY } from "../lib/queries";

const content = await sanityClient.fetch(CONTENT_QUERY);
---

<section class="sec" id="publications">
  <div class="wrap">
    <div class="sec-head">
      <p class="sec-eyebrow">05 — Publications</p>
      <h2 class="title lm"><span class="ln"><span>Travaux sélectionnés,</span></span><span class="ln"><span><span class="it">évalués par les pairs</span></span></span></h2>
    </div>
    <div class="pub-list">
      {content?.publications?.map((pub: { index: number; title: string; journal: string; year: number; doi: string; authors: string; url?: string }) => (
        <article class="pub rv">
          <span class="n">{String(pub.index).padStart(2, "0")}</span>
          <div>
            <h3>
              {pub.url ? <a href={pub.url} target="_blank" rel="noopener noreferrer">{pub.title}</a> : pub.title}
            </h3>
            <span class="meta">
              <b>{pub.journal}</b> · {pub.year} · {pub.doi} · {pub.authors}
            </span>
          </div>
          <span class="arr">↗</span>
        </article>
      ))}
    </div>
    <p class="pub-note rv">
      → {content?.publicationsNote || "25+ publications évaluées par les pairs"}
      · liste complète disponible sur <a href="#" title="Profil ResearchGate">ResearchGate ↗</a>
    </p>
  </div>
</section>
