---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/fonts-latin.css";
import SearchModal from "../components/SearchModal.astro";
import PdfViewerModal from "../components/PdfViewerModal.astro";
import AiAssistant from "../components/AiAssistant.astro";
import frauncesLatinWght from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2";
import archivoLatinWght from "@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  image?: string;
  noindex?: boolean;
}

const isEn = Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");
const currentLang = isEn ? "en" : "fr";
const defaultDescription = isEn
  ? "Professional website of Dr Idelphonse Bonaventure Ahogni — Malaria Programme Manager & Medical Entomologist"
  : "Site professionnel du Dr Idelphonse Bonaventure Ahogni — Gestionnaire de programme paludisme & Entomologiste médical";

const { title, description = defaultDescription, bodyClass = "", image = "/Dr-Idelphone-AHOGNI.jpeg", noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://idelphonseahogni.com");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site).toString();

const strippedPath = Astro.url.pathname.replace(/^\/en(\/|$)/, "/");
const frPath = strippedPath === "" ? "/" : strippedPath;
const enPath = frPath === "/" ? "/en" : "/en" + frPath;
const frCanonical = new URL(frPath, site);
const enCanonical = new URL(enPath, site);

// Breadcrumb SEO
const pathSegments = Astro.url.pathname.split("/").filter((s) => Boolean(s) && s !== "en");
const breadcrumbLabels: Record<string, string> = {
  "publications": isEn ? "Publications" : "Publications",
  "blog": "Blog",
  "contact": "Contact",
  "speaking": isEn ? "Speaking" : "Conférences",
  "cv": "CV",
  "changelog": "Changelog",
  "expertises": isEn ? "Expertise" : "Expertises",
  "entomologie": isEn ? "Entomology" : "Entomologie",
  "stations-terrain": isEn ? "Field Stations" : "Stations Terrain",
  "projets": isEn ? "Projects" : "Projets",
  "parcours": isEn ? "Career" : "Parcours",
  "medias": isEn ? "Media" : "Médias",
  "ressources": isEn ? "Resources" : "Ressources",
};
const breadcrumbItems = [
  { name: isEn ? "Home" : "Accueil", url: (isEn ? enCanonical : frCanonical).toString() },
  ...pathSegments.map((seg, i) => ({
    name: breadcrumbLabels[seg] || decodeURIComponent(seg).replace(/-/g, " "),
    url: new URL((isEn ? "/en/" : "/") + pathSegments.slice(0, i + 1).join("/") + "/", site).toString(),
  })),
];
---

<!DOCTYPE html>
<html lang={currentLang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  {/* Google Search Console : ajouter PUBLIC_GOOGLE_VERIFICATION dans .env puis décommenter
  {import.meta.env.PUBLIC_GOOGLE_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_VERIFICATION} />}
  */}

  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZBCQ24VN7X"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-ZBCQ24VN7X');
  </script>
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#F8F6F0" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0B0F17" media="(prefers-color-scheme: dark)">
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var stored = null;
      try { stored = localStorage.getItem("theme"); } catch (e) {}
      var mq = window.matchMedia("(prefers-color-scheme: dark)");
      var eff = (stored === "light" || stored === "dark") ? stored : (mq.matches ? "dark" : "light");
      root.setAttribute("data-theme", eff);
    })();
  </script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="canonical" href={canonical.toString()}>
  <link rel="alternate" hreflang="fr" href={frCanonical.toString()}>
  <link rel="alternate" hreflang="en" href={enCanonical.toString()}>
  <link rel="alternate" hreflang="x-default" href={frCanonical.toString()}>
  <link rel="preconnect" href="https://cdn.sanity.io" crossorigin>
  <link rel="preconnect" href="https://unpkg.com" crossorigin>
  <link rel="preconnect" href="https://images.unsplash.com" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href={frauncesLatinWght} crossorigin>
  <link rel="preload" as="font" type="font/woff2" href={archivoLatinWght} crossorigin>
  <link rel="alternate" type="application/rss+xml" title={isEn ? "Dr I. B. Ahogni — Field Notes & Research RSS" : "Blog Dr I. B. Ahogni"} href={isEn ? "/en/rss.xml" : "/rss.xml"}>
  
  <!-- PWA & Mobile Web App -->
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Dr Ahogni">
  <script is:inline>
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", function () {
        navigator.serviceWorker.register("/sw.js").catch(function () {});
      });
    }
  </script>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Dr I. B. Ahogni, PhD">
  <meta property="og:locale" content={isEn ? "en_US" : "fr_FR"}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical.toString()}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={title}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Dr Idelphonse Bonaventure Ahogni",
    "givenName": "Idelphonse",
    "additionalName": "Bonaventure",
    "familyName": "Ahogni",
    "honorificPrefix": "Dr",
    "honorificSuffix": "PhD",
    "alternateName": [
      "Dr Idelphonse Ahogni",
      "Dr Idelphonse Bonaventure Ahogni",
      "Idelphonse B. Ahogni",
      "Ahogni IB",
      "Ahogni, I. B."
    ],
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".page-intro", ".pub-intro", ".hero-tagline", "#bio-summary"]
    },
    "jobTitle": isEn ? "Medical Entomologist (PhD) · Malaria Programme Manager & Public Health Expert" : "Entomologiste Médical (PhD) · Gestionnaire de Programme Paludisme & Expert en Santé Publique",
    "hasOccupation": {
      "@type": "Occupation",
      "name": isEn ? "Medical Entomologist & Vector Control Specialist" : "Entomologiste Médical & Spécialiste en Lutte Antivectorielle",
      "occupationalCategory": "2131 - Biologists, Botanists, Zoologists and Related Professionals (ISCO-08)",
      "skills": isEn ? [
        "Medical Entomology", "Malaria Vector Control", "Insecticide Resistance Monitoring",
        "OECD GLP Compliance", "Phase II & III Trials", "Vector Genomic Surveillance",
        "NMCP Policy Formulation", "Biostatistics & Abbott Modeling"
      ] : [
        "Entomologie Médicale", "Lutte Antivectorielle Paludisme", "Surveillance de la Résistance aux Insecticides",
        "Conformité BPL / OECD GLP", "Essais de Phase II & III", "Surveillance Génomique Vectorielle",
        "Élaboration de Politiques PNLP", "Biostatistique & Modélisation Abbott"
      ]
    },
    "description": description,
    "url": site.toString(),
    "image": ogImage,
    "nationality": { "@type": "Country", "name": isEn ? "Benin" : "Bénin" },
    "address": { "@type": "PostalAddress", "addressLocality": "Cotonou", "addressCountry": "BJ" },
    "worksFor": {
      "@type": "Organization",
      "name": "Centre de Recherche Entomologique de Cotonou (CREC)",
      "url": "https://crec-benin.org"
    },
    "alumniOf": [
      { "@type": "EducationalOrganization", "name": "Université d'Abomey-Calavi (UAC)", "url": "https://uac.bj" },
      { "@type": "EducationalOrganization", "name": "London School of Hygiene & Tropical Medicine (LSHTM)", "url": "https://www.lshtm.ac.uk" }
    ],
    "affiliation": [
      { "@type": "Organization", "name": "Pan-African Mosquito Control Association (PAMCA)", "url": "https://pamca.org" },
      { "@type": "Organization", "name": isEn ? "World Health Organization (WHO)" : "Organisation Mondiale de la Santé (OMS / WHO)", "url": "https://www.who.int" }
    ],
    "sameAs": [
      "https://www.researchgate.net/profile/Idelphonse-Ahogni",
      "https://www.linkedin.com/in/idelphonse-ahogni"
      // Ajouter quand disponibles : Google Scholar ID et ORCID réels
      // "https://scholar.google.com/citations?user=VOTRE_ID",
      // "https://orcid.org/0000-0000-0000-0000"
    ],
    "knowsAbout": isEn ? [
      "Medical entomology",
      "Vector control",
      "Malaria epidemiology",
      "Operational malariology",
      "Public health",
      "Malaria programme management",
      "Evaluation of Long-Lasting Insecticidal Nets (LLINs / ITNs)",
      "Dual-active ingredient nets (Interceptor G2, Royal Guard)",
      "Insecticide resistance",
      "Insecticide Resistance Management (IRM)",
      "Piperonyl Butoxide (PBO) synergism",
      "Vector genomic surveillance",
      "Molecular resistance markers (kdr L1014F, kdr L1014S, ace-1 G119S)",
      "Metabolic P450 cytochromes (CYP6P9a, CYP6P9b, GSTe2)",
      "Experimental hut trials (Phase II WHO)",
      "Community-level and randomized controlled trials (Phase III)",
      "Good Laboratory Practice (OECD GLP / WHO GLP)",
      "Quality assurance in research insectaries",
      "World Health Organization guidelines and testing protocols (WHO)",
      "Strategic advisory for National Malaria Control Programs (NMCP)",
      "Global Fund grant applications and technical policy briefs",
      "Indoor Residual Spraying (IRS)",
      "Larval Source Management (LSM) and biological larviciding",
      "Spatial repellents and chemical barrier tools",
      "Vector transmission dynamics and sentinel field stations (Covè, Akron, Parakou, Kandi, Malanville)",
      "Climate change impacts on vector dynamics",
      "Medical biostatistics and sample size calculation (Fleiss continuity formula)",
      "Abbott-corrected mortality rate calculations",
      "Probit regression and standardized bioassays (WHO tube tests, WHO cone bioassays, CDC bottle assays)",
      "Entomological Inoculation Rate (EIR)",
      "Human Biting Rate (HBR) and Sporozoite Rate (ELISA-CSP)",
      "Ovarian parity dissection in mosquitoes",
      "Anopheles gambiae s.s.",
      "Anopheles coluzzii",
      "Anopheles funestus s.s.",
      "Anopheles arabiensis",
      "Anopheles stephensi",
      "Plasmodium falciparum",
      "Chlorfenapyr",
      "Pyriproxyfen",
      "Deltamethrin",
      "Alpha-cypermethrin",
      "Clothianidin",
      "Pirimiphos-methyl",
      "University lecturing, PhD supervision, and scientific capacity building",
      "Benin",
      "West Africa",
      "Sub-Saharan Africa"
    ] : [
      "Entomologie médicale",
      "Lutte antivectorielle",
      "Épidémiologie du paludisme",
      "Paludologie opérationnelle",
      "Santé publique",
      "Gestion de programme paludisme",
      "Évaluation des moustiquaires imprégnées d'insecticide (MILDV / MILD / ITN / LLIN)",
      "Moustiquaires de nouvelle génération à double matière active (Interceptor G2, Royal Guard)",
      "Résistance aux insecticides",
      "Gestion de la résistance aux insecticides (IRM)",
      "Synergie au Pipéronyl Butoxyde (PBO)",
      "Surveillance génomique vectorielle",
      "Marqueurs moléculaires de résistance (kdr L1014F, kdr L1014S, ace-1 G119S)",
      "Cytochromes P450 métaboliques (CYP6P9a, CYP6P9b, GSTe2)",
      "Essais en cases expérimentales (Phase II OMS)",
      "Essais cliniques et communautaires (Phase III)",
      "Bonnes Pratiques de Laboratoire (BPL / OECD GLP)",
      "Assurance qualité en insectarium et laboratoire de recherche",
      "Directives et protocoles de l'Organisation Mondiale de la Santé (OMS / WHO)",
      "Appui technique et stratégique aux Programmes Nationaux de Lutte contre le Paludisme (PNLP)",
      "Dossiers de subvention du Fonds Mondial (Global Fund)",
      "Aspersion intra-domiciliaire d'insecticide à effet rémanent (IRS / PID)",
      "Gestion des gîtes larvaires (LSM) et larvicides biologiques",
      "Répulsifs spatiaux et barrières chimiques",
      "Dynamique vectorielle et stations sentinelles (Covè, Akron, Parakou, Kandi, Malanville)",
      "Impact des variations climatiques sur la transmission vectorielle",
      "Biométrie médicale, biostatistique et calcul de taille d'échantillon (Formule de Fleiss)",
      "Mortalité corrigée selon la formule d'Abbott",
      "Analyses probit et bio-essais standardisés (Tubes OMS, Cônes OMS, Bouteilles CDC)",
      "Taux d'inoculation entomologique (TIE / EIR)",
      "Taux de piqûre humaine (HBR) et indice sporozoïtique (ELISA-CSP)",
      "Dissection ovarienne et état de parité des anophèles",
      "Anopheles gambiae s.s.",
      "Anopheles coluzzii",
      "Anopheles funestus s.s.",
      "Anopheles arabiensis",
      "Anopheles stephensi",
      "Plasmodium falciparum",
      "Chlorfénapyr",
      "Pyriproxyfène",
      "Deltaméthrine",
      "Alpha-cyperméthrine",
      "Clothianidine",
      "Pirimiphos-méthyl",
      "Enseignement universitaire, encadrement de thèses de Doctorat et mentorat scientifique",
      "Bénin",
      "Afrique de l'Ouest",
      "Afrique subsaharienne"
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": isEn ? "Dr Idelphonse Ahogni, PhD — Malaria Expert & Medical Entomologist" : "Dr Idelphonse Ahogni, PhD — Expert Paludisme & Entomologiste Médical",
    "alternateName": [
      "Dr Ahogni",
      "Dr. Ahogni",
      "Idelphonse Ahogni",
      "Dr Idelphonse Ahogni",
      "Dr Idelphonse Bonaventure Ahogni",
      "Idelphonse Bonaventure Ahogni",
      "Dr I. B. Ahogni",
      "Site Officiel Dr Idelphonse Ahogni",
      "Dr Idelphonse Ahogni Official Website",
      "idelphonseahogni.com"
    ],
    "url": site.toString(),
    "inLanguage": currentLang,
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": site.toString() + "?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  })} />
  {breadcrumbItems.length > 1 && <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbItems.map((item, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": item.name,
      "item": item.url,
    })),
  })} />}
</head>
<style>
  .btt {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 998;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    color: var(--ink);
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity .3s, visibility .3s, transform .3s, background .3s, border-color .3s, color .3s, box-shadow .3s;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
  }
  .btt svg { width: 20px; height: 20px; stroke-width: 2.8px; }
  .btt.show { opacity: 1; visibility: visible; transform: translateY(0); }
  .btt:hover {
    background: var(--amber);
    color: #0B0F17;
    border-color: var(--amber);
    box-shadow: 0 10px 30px rgba(217, 130, 24, 0.4);
    transform: translateY(-2px);
  }
  body.on-contact .btt { border-color: var(--amber); color: #F8FAFC; }
  body.on-contact .btt:hover { background: var(--amber); color: #0B0F17; border-color: var(--amber); }

  html[data-theme="dark"] .btt {
    background: var(--paper2);
    color: #F8FAFC;
    border: 1.5px solid var(--teal);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.7), 0 0 14px rgba(13, 148, 136, 0.35);
  }
  html[data-theme="dark"] .btt svg {
    color: #F8FAFC;
  }
  html[data-theme="dark"] .btt:hover {
    background: var(--teal) !important;
    color: #0B0F17 !important;
    border-color: var(--teal) !important;
    box-shadow: 0 10px 30px rgba(13, 148, 136, 0.5) !important;
    transform: translateY(-2px);
  }
  html[data-theme="dark"] .btt:hover svg {
    color: #0B0F17 !important;
  }
  @media (max-width: 640px) { .btt { bottom: 16px; right: 16px; width: 40px; height: 40px; } }
</style>
<body class:list={[bodyClass, {
    "on-contact": Astro.url.pathname === "/contact" || Astro.url.pathname === "/en/contact",
    "on-dark-header": ["/contact", "/publications", "/blog", "/cv", "/speaking", "/changelog"].some(p => Astro.url.pathname === p || Astro.url.pathname.startsWith(p + "/") || Astro.url.pathname === "/en" + p || Astro.url.pathname.startsWith("/en" + p + "/"))
  }]}>
  <a href="#main" class="skip-link" data-i18n="a11y.skip">Aller au contenu principal</a>
  <span id="main" tabindex="-1"></span>
  <div class="noise" aria-hidden="true"></div>
  <slot />
  <SearchModal />
  <PdfViewerModal />
  <AiAssistant />
  <button id="backToTop" class="btt" aria-label={isEn ? "Back to top" : "Retour en haut"}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 15l-6-6-6 6"/>
    </svg>
  </button>
  <script>
    import "../scripts/main.js";
  </script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const btn = document.getElementById("backToTop")!;
      window.addEventListener("scroll", () => {
        btn.classList.toggle("show", window.scrollY > 400);
      }, { passive: true });
      btn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    });
  </script>
</body>
</html>
