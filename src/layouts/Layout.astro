---
import "../styles/global.css";
import "@fontsource-variable/fraunces/wght.css";
import "@fontsource-variable/fraunces/wght-italic.css";
import "@fontsource-variable/archivo/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import SearchModal from "../components/SearchModal.astro";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description = "Site professionnel du Dr Idelphonse Bonaventure Ahogni", bodyClass = "", image = "/Dr-Idelphone-AHOGNI.jpeg", noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://idelphonseahogni.com");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site).toString();
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#F4EFE3" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0A1A15" media="(prefers-color-scheme: dark)">
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var stored = null;
      try { stored = localStorage.getItem("theme"); } catch (e) {}
      var mq = window.matchMedia("(prefers-color-scheme: dark)");
      var eff = (stored === "light" || stored === "dark") ? stored : (mq.matches ? "dark" : "light");
      root.setAttribute("data-theme", eff);
    })();
  </script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <link rel="canonical" href={canonical.toString()}>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Dr I. B. Ahogni, PhD">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical.toString()}>
  <meta property="og:image" content={ogImage}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Dr Idelphonse Bonaventure Ahogni",
    "givenName": "Idelphonse",
    "familyName": "Ahogni",
    "honorificSuffix": "PhD",
    "jobTitle": "Gestionnaire de programme paludisme · Entomologiste médical",
    "description": description,
    "url": canonical.toString(),
    "image": ogImage,
    "nationality": "Bénin",
    "address": { "@type": "PostalAddress", "addressLocality": "Cotonou", "addressCountry": "BJ" },
    "knowsAbout": ["Paludisme", "Entomologie médicale", "Lutte antivectorielle", "Santé publique"]
  })} />
</head>
<style>
  .btt {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 998;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity .3s, visibility .3s, transform .3s, background .3s, box-shadow .3s;
    box-shadow: 0 6px 20px rgb(var(--rgb-ink) / .2);
  }
  .btt svg { width: 20px; height: 20px; }
  .btt.show { opacity: 1; visibility: visible; transform: translateY(0); }
  .btt:hover {
    background: var(--amber);
    color: var(--ink);
    border-color: var(--ink);
    box-shadow: 0 10px 30px rgb(var(--rgb-ink) / .3);
  }
  body.on-contact .btt { border-color: var(--linelt); color: var(--paper); }
  body.on-contact .btt:hover { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  html[data-theme="dark"] .btt { background: var(--ink3); color: var(--paper); border-color: var(--linelt); box-shadow: 0 6px 20px rgba(0,0,0,.4); }
  html[data-theme="dark"] .btt:hover { background: var(--amber); color: var(--ink3); border-color: var(--amber); box-shadow: 0 10px 30px rgba(0,0,0,.5); }
  @media (max-width: 640px) { .btt { bottom: 16px; right: 16px; width: 40px; height: 40px; } }
</style>
<body class:list={[bodyClass, { "on-contact": Astro.url.pathname === "/contact" }]}>
  <a href="#main" class="skip-link" data-i18n="a11y.skip">Aller au contenu principal</a>
  <span id="main" tabindex="-1"></span>
  <div class="noise" aria-hidden="true"></div>
  <SearchModal />
  <button id="backToTop" class="btt" aria-label="Retour en haut">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 15l-6-6-6 6"/>
    </svg>
  </button>
  <slot />
  <script>
    import "../scripts/main.js";
  </script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const btn = document.getElementById("backToTop")!;
      window.addEventListener("scroll", () => {
        btn.classList.toggle("show", window.scrollY > 400);
      }, { passive: true });
      btn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    });
  </script>
</body>
</html>
