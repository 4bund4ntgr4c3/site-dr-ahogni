---
import "../styles/global.css";
import SearchModal from "../components/SearchModal.astro";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const { title, description = "Site professionnel du Dr Idelphonse Bonaventure Ahogni", bodyClass = "" } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/fraunces/index.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/fraunces/wght-italic.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/archivo/index.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/jetbrains-mono/index.css">
  <script is:inline>
    (function(){
      var saved = localStorage.getItem("theme");
      if(saved === "dark" || (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches)){
        document.documentElement.classList.add("dark");
      }
    })();
  </script>
</head>
<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    cursor: pointer;
    transition: background .3s, color .3s, transform .3s, box-shadow .3s;
    position: relative;
    overflow: hidden;
  }
  .theme-toggle svg {
    width: 18px;
    height: 18px;
    position: absolute;
    transition: transform .5s cubic-bezier(.4,.2,.2,1), opacity .3s;
  }
  .theme-toggle .sun { opacity: 1; transform: rotate(0deg) scale(1); }
  .theme-toggle .moon { opacity: 0; transform: rotate(-90deg) scale(.5); }
  html.dark .theme-toggle .sun { opacity: 0; transform: rotate(90deg) scale(.5); }
  html.dark .theme-toggle .moon { opacity: 1; transform: rotate(0deg) scale(1); }
  .theme-toggle:hover {
    background: var(--amber);
    color: var(--ink);
    border-color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(217,151,43,.25);
  }
  html.dark .theme-toggle:hover {
    box-shadow: 0 8px 24px rgba(240,184,77,.3);
  }
  .btt {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 998;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity .3s, visibility .3s, transform .3s, background .3s, box-shadow .3s;
    box-shadow: 0 6px 20px rgba(13,34,28,.2);
  }
  .btt svg { width: 20px; height: 20px; }
  .btt.show { opacity: 1; visibility: visible; transform: translateY(0); }
  .btt:hover {
    background: var(--amber);
    color: var(--ink);
    border-color: var(--ink);
    box-shadow: 0 10px 30px rgba(13,34,28,.3);
  }
  @media (max-width: 640px) {
    .btt { bottom: 16px; right: 16px; width: 40px; height: 40px; }
    .theme-toggle { width: 40px; height: 40px; }
  }
</style>
<body class:list={[bodyClass, { "on-contact": Astro.url.pathname === "/contact" }]}>
  <div class="noise" aria-hidden="true"></div>
  <SearchModal />
  <button id="backToTop" class="btt" aria-label="Retour en haut">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 15l-6-6-6 6"/>
    </svg>
  </button>
  <slot />
  <script>
    import "../scripts/main.js";
  </script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const toggle = document.getElementById("themeToggle")!;
      const html = document.documentElement;

      toggle.addEventListener("click", () => {
        const isDark = html.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });

      const btn = document.getElementById("backToTop")!;
      window.addEventListener("scroll", () => {
        btn.classList.toggle("show", window.scrollY > 400);
      }, { passive: true });
      btn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    });
  </script>
</body>
</html>
