---
import "../styles/global.css";
import "../styles/fonts-latin.css";
import SearchModal from "../components/SearchModal.astro";
import PdfViewerModal from "../components/PdfViewerModal.astro";
import AiAssistant from "../components/AiAssistant.astro";
import frauncesLatinWght from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description = "Site professionnel du Dr Idelphonse Bonaventure Ahogni", bodyClass = "", image = "/Dr-Idelphone-AHOGNI.jpeg", noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://idelphonseahogni.com");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site).toString();

const isEn = Astro.url.pathname === "/en" || Astro.url.pathname.startsWith("/en/");
const currentLang = isEn ? "en" : "fr";

const strippedPath = Astro.url.pathname.replace(/^\/en(\/|$)/, "/");
const frPath = strippedPath === "" ? "/" : strippedPath;
const enPath = frPath === "/" ? "/en" : "/en" + frPath;
const frCanonical = new URL(frPath, site);
const enCanonical = new URL(enPath, site);

// Breadcrumb SEO
const pathSegments = Astro.url.pathname.split("/").filter((s) => Boolean(s) && s !== "en");
const breadcrumbLabels: Record<string, string> = {
  "publications": isEn ? "Publications" : "Publications",
  "blog": "Blog",
  "contact": "Contact",
  "speaking": isEn ? "Speaking" : "Conférences",
  "cv": "CV",
  "changelog": "Changelog",
  "expertises": isEn ? "Expertise" : "Expertises",
  "entomologie": isEn ? "Entomology" : "Entomologie",
  "stations-terrain": isEn ? "Field Stations" : "Stations Terrain",
  "projets": isEn ? "Projects" : "Projets",
  "parcours": isEn ? "Career" : "Parcours",
  "medias": isEn ? "Media" : "Médias",
  "ressources": isEn ? "Resources" : "Ressources",
};
const breadcrumbItems = [
  { name: isEn ? "Home" : "Accueil", url: (isEn ? enCanonical : frCanonical).toString() },
  ...pathSegments.map((seg, i) => ({
    name: breadcrumbLabels[seg] || decodeURIComponent(seg).replace(/-/g, " "),
    url: new URL((isEn ? "/en/" : "/") + pathSegments.slice(0, i + 1).join("/") + "/", site).toString(),
  })),
];
---

<!DOCTYPE html>
<html lang={currentLang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <!-- Google Search Console — remplacer VOTRE_CODE_VERIFICATION par le code fourni par GSC -->
  <meta name="google-site-verification" content="VOTRE_CODE_VERIFICATION">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#F8F6F0" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0B0F17" media="(prefers-color-scheme: dark)">
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var stored = null;
      try { stored = localStorage.getItem("theme"); } catch (e) {}
      var mq = window.matchMedia("(prefers-color-scheme: dark)");
      var eff = (stored === "light" || stored === "dark") ? stored : (mq.matches ? "dark" : "light");
      root.setAttribute("data-theme", eff);
    })();
  </script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <link rel="canonical" href={canonical.toString()}>
  <link rel="alternate" hreflang="fr" href={frCanonical.toString()}>
  <link rel="alternate" hreflang="en" href={enCanonical.toString()}>
  <link rel="alternate" hreflang="x-default" href={frCanonical.toString()}>
  <link rel="preload" as="font" type="font/woff2" href={frauncesLatinWght} crossorigin>
  <link rel="alternate" type="application/rss+xml" title="Blog Dr I. B. Ahogni" href="/rss.xml">
  
  <!-- PWA & Mobile Web App -->
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Dr Ahogni">
  <script is:inline>
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", function () {
        navigator.serviceWorker.register("/sw.js").catch(function () {});
      });
    }
  </script>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Dr I. B. Ahogni, PhD">
  <meta property="og:locale" content={isEn ? "en_US" : "fr_FR"}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical.toString()}>
  <meta property="og:image" content={ogImage}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Dr Idelphonse Bonaventure Ahogni",
    "givenName": "Idelphonse",
    "additionalName": "Bonaventure",
    "familyName": "Ahogni",
    "honorificPrefix": "Dr",
    "honorificSuffix": "PhD",
    "alternateName": [
      "Idelphonse Ahogni",
      "I. B. Ahogni",
      "Idelphonse B. Ahogni",
      "Dr Ahogni",
      "Dr I. B. Ahogni",
      "Ahogni Idelphonse",
      "Ahogni Idelphonse Bonaventure",
      "Idelphonse Bonaventure AHOGNI",
      "Dr Idelphonse AHOGNI",
      "Idelfonce Ahogni",
      "Idelfonse Ahogni",
      "Ahogni I. B.",
      "IB Ahogni"
    ],
    "jobTitle": "Gestionnaire de programme paludisme · Entomologiste médical",
    "description": description,
    "url": site.toString(),
    "image": ogImage,
    "nationality": { "@type": "Country", "name": "Bénin" },
    "address": { "@type": "PostalAddress", "addressLocality": "Cotonou", "addressCountry": "BJ" },
    "worksFor": {
      "@type": "Organization",
      "name": "Centre de Recherche Entomologique de Cotonou (CREC)",
      "url": "https://crec-benin.org"
    },
    "alumniOf": [
      { "@type": "EducationalOrganization", "name": "Université d'Abomey-Calavi (UAC)", "url": "https://uac.bj" },
      { "@type": "EducationalOrganization", "name": "London School of Hygiene & Tropical Medicine (LSHTM)" }
    ],
    "affiliation": [
      { "@type": "Organization", "name": "Pan-African Mosquito Control Association (PAMCA)" },
      { "@type": "Organization", "name": "Organisation Mondiale de la Santé (OMS / WHO)" }
    ],
    "sameAs": [
      "https://www.researchgate.net/profile/Idelphonse-Ahogni",
      "https://scholar.google.com/citations?user=SCHOLAR_ID",
      "https://orcid.org/0000-0000-0000-0000",
      "https://www.linkedin.com/in/idelphonse-ahogni"
    ],
    "knowsAbout": [
      "Paludisme", "Malaria", "Entomologie médicale", "Medical entomology",
      "Lutte antivectorielle", "Vector control", "Moustiquaires imprégnées",
      "Insecticide-treated nets", "LLIN", "ITN", "Résistance aux insecticides",
      "Insecticide resistance", "Santé publique", "Public health",
      "Anopheles gambiae", "Plasmodium falciparum", "Epidémiologie",
      "Surveillance entomologique", "WHO guidelines", "Essais cliniques",
      "Indoor residual spraying", "IRS", "Bénin", "Afrique de l'Ouest"
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Dr Idelphonse Ahogni, PhD — Expert Paludisme & Entomologiste Médical",
    "alternateName": ["Dr Ahogni", "Idelphonse Ahogni", "idelphonseahogni.com"],
    "url": site.toString(),
    "inLanguage": "fr",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": site.toString() + "?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  })} />
  {breadcrumbItems.length > 1 && <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbItems.map((item, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": item.name,
      "item": item.url,
    })),
  })} />}
</head>
<style>
  .btt {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 998;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    color: var(--ink);
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity .3s, visibility .3s, transform .3s, background .3s, border-color .3s, color .3s, box-shadow .3s;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
  }
  .btt svg { width: 20px; height: 20px; stroke-width: 2.8px; }
  .btt.show { opacity: 1; visibility: visible; transform: translateY(0); }
  .btt:hover {
    background: var(--amber);
    color: #0B0F17;
    border-color: var(--amber);
    box-shadow: 0 10px 30px rgba(217, 130, 24, 0.4);
    transform: translateY(-2px);
  }
  body.on-contact .btt { border-color: var(--amber); color: #F8FAFC; }
  body.on-contact .btt:hover { background: var(--amber); color: #0B0F17; border-color: var(--amber); }

  html[data-theme="dark"] .btt {
    background: var(--paper2);
    color: #F8FAFC;
    border: 1.5px solid var(--teal);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.7), 0 0 14px rgba(13, 148, 136, 0.35);
  }
  html[data-theme="dark"] .btt svg {
    color: #F8FAFC;
  }
  html[data-theme="dark"] .btt:hover {
    background: var(--teal) !important;
    color: #0B0F17 !important;
    border-color: var(--teal) !important;
    box-shadow: 0 10px 30px rgba(13, 148, 136, 0.5) !important;
    transform: translateY(-2px);
  }
  html[data-theme="dark"] .btt:hover svg {
    color: #0B0F17 !important;
  }
  @media (max-width: 640px) { .btt { bottom: 16px; right: 16px; width: 40px; height: 40px; } }
</style>
<body class:list={[bodyClass, {
    "on-contact": Astro.url.pathname === "/contact",
    "on-dark-header": ["/contact", "/publications", "/blog", "/cv", "/speaking", "/changelog"].some(p => Astro.url.pathname === p || Astro.url.pathname.startsWith(p + "/"))
  }]}>
  <a href="#main" class="skip-link" data-i18n="a11y.skip">Aller au contenu principal</a>
  <span id="main" tabindex="-1"></span>
  <div class="noise" aria-hidden="true"></div>
  <SearchModal />
  <PdfViewerModal />
  <AiAssistant />
  <button id="backToTop" class="btt" aria-label="Retour en haut">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 15l-6-6-6 6"/>
    </svg>
  </button>
  <slot />
  <script>
    import "../scripts/main.js";
  </script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const btn = document.getElementById("backToTop")!;
      window.addEventListener("scroll", () => {
        btn.classList.toggle("show", window.scrollY > 400);
      }, { passive: true });
      btn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    });
  </script>
</body>
</html>
