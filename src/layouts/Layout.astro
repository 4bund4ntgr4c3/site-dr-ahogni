---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const { title, description = "Site professionnel du Dr Idelphonse Bonaventure Ahogni", bodyClass = "" } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/fraunces/index.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/fraunces/wght-italic.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/archivo/index.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/jetbrains-mono/index.css">
</head>
<body class:list={[bodyClass, { "on-contact": Astro.url.pathname === "/contact" }]}>
  <div class="noise" aria-hidden="true"></div>
  <slot />
  <script>
    import "../scripts/main.js";
  </script>
</body>
</html>
